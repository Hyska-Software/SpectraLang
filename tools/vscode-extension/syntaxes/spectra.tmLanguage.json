{
  "scopeName": "source.spectra",
  "name": "SpectraLang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#std_api" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spectra",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.spectra" }
          },
          "end": "\\n",
          "endCaptures": {
            "0": { "name": "punctuation.terminator.comment.spectra" }
          }
        },
        {
          "name": "comment.block.spectra",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.spectra" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.spectra" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.double.spectra",
          "begin": "f\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.spectra" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.spectra" }
          },
          "patterns": [
            {
              "name": "meta.interpolation.spectra",
              "begin": "\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.spectra" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.spectra" }
              },
              "patterns": [
                { "include": "#strings" },
                { "include": "#characters" },
                { "include": "#numbers" },
                { "include": "#std_api" },
                { "include": "#keywords" },
                { "include": "#types" },
                { "include": "#operators" }
              ]
            },
            {
              "name": "constant.character.escape.spectra",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.spectra",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.spectra" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.spectra" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.spectra",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.char.spectra",
          "match": "'(?:\\\\.|[^\\\\'])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.decimal.spectra",
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|[0-9](?:[0-9_]*[0-9])?(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.function.spectra",
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.spectra" },
            "2": { "name": "entity.name.function.spectra" }
          }
        },
        {
          "name": "meta.declaration.type.spectra",
          "match": "\\b(record|enum|trait|module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.spectra" },
            "2": { "name": "entity.name.type.spectra" }
          }
        },
        {
          "name": "meta.declaration.impl.spectra",
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_:<>]*)",
          "captures": {
            "1": { "name": "keyword.declaration.impl.spectra" },
            "2": { "name": "entity.name.type.spectra" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.spectra",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.spectra",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.spectra",
          "match": "&&|\\|\\||\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.arithmetic.spectra",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.range.spectra",
          "match": "\\.\\.=|\\.\\."
        },
        {
          "name": "keyword.operator.access.spectra",
          "match": "::|\\."
        },
        {
          "name": "keyword.operator.other.spectra",
          "match": "\\?|!|&"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spectra",
          "match": "\\b(?:if|else|match|switch|case|when|then|otherwise|cond|while|do|for|in|repeat|until|loop|return|break|continue|yield|goto|let|await)\\b"
        },
        {
          "name": "keyword.declaration.spectra",
          "match": "\\b(?:module|from|import|as|export|func|async|returns|record|enum|impl|class|trait)\\b"
        },
        {
          "name": "storage.modifier.spectra",
          "match": "\\b(?:public|mut|internal|Self|self)\\b"
        },
        {
          "name": "constant.language.boolean.spectra",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.spectra",
          "match": "\\b(?:int|float|double|bool|string|char|void|unit|Task|Stream)\\b"
        },
        {
          "name": "entity.name.type.spectra",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?:<[A-Za-z0-9_,: <>]+>)?\\b"
        }
      ]
    },
    "std_api": {
      "patterns": [
        {
          "name": "support.namespace.std-api.spectra",
          "match": "\\b(?:std\\.api|spectra\\.api|spectra\\.std\\.api)(?:\\.(?:http|server|client|json|tls|routing|query|form|multipart|handler|cors|middleware|errors))?\\b"
        },
        {
          "name": "support.function.std-api.routing.spectra",
          "match": "\\b(?:get|post|put|patch|delete|options|route_add|route_match|match_param|match_query)\\b"
        },
        {
          "name": "support.function.std-api.handler.spectra",
          "match": "\\b(?:text|json|bytes|status|with_header|into_response|register_sync|register_async|dispatch_sync|dispatch_async)\\b"
        },
        {
          "name": "support.function.std-api.cors.spectra",
          "match": "\\b(?:policy|permissive|allow_origin|allow_method|allow_header|expose_header|allow_credentials|max_age|middleware|is_preflight|preflight|apply|allowed_origin)\\b"
        },
        {
          "name": "support.function.std-api.middleware.spectra",
          "match": "\\b(?:chain|chain_new|chain_len|register_sync_short_circuit|register_async_short_circuit|use_sync|use_async|execute_sync|execute_async|last_trace|trace_len|trace_event|trace_short_circuited)\\b"
        }
      ]
    }
  }
}
