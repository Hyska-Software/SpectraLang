module std.validate

import std.option as option
import std.string as str

// ── Digit checks ─────────────────────────────────────────────────────────

// Luhn checksum (credit cards, IMEI): spaces and hyphens are ignored, at least
// two digits are required.
public func luhn_valid(text: string) returns bool {
    let digits = digits_only(text)
    let length = str.len(digits)
    if length < 2 {
        return false
    }

    let sum = 0
    let index = length - 1
    let doubled = false
    while index >= 0 {
        let value = digit_at(digits, index)
        if value < 0 {
            return false
        }
        if doubled {
            let product = value * 2
            if product > 9 {
                sum = sum + (product - 9)
            } else {
                sum = sum + product
            }
        } else {
            sum = sum + value
        }
        doubled = not doubled
        index = index - 1
    }

    return sum % 10 == 0
}

// ISBN-10 with optional hyphens/spaces; the final check character may be `X`.
public func isbn10_valid(text: string) returns bool {
    let characters = alphanumeric_upper(text)
    if str.len(characters) != 10 {
        return false
    }

    let sum = 0
    let index = 0
    while index < 10 {
        let code = str.char_at(characters, index)
        let value = if index == 9 and code == 88 { 10 } else { code - 48 }
        if value < 0 or value > 10 {
            return false
        }
        if index < 9 and code < 48 {
            return false
        }
        if index < 9 and code > 57 {
            return false
        }
        sum = sum + value * (10 - index)
        index = index + 1
    }

    return sum % 11 == 0
}

// ISBN-13 with optional hyphens/spaces.
public func isbn13_valid(text: string) returns bool {
    let digits = digits_only(text)
    if str.len(digits) != 13 {
        return false
    }

    let sum = 0
    let index = 0
    while index < 13 {
        let value = digit_at(digits, index)
        if value < 0 {
            return false
        }
        if index % 2 == 0 {
            sum = sum + value
        } else {
            sum = sum + value * 3
        }
        index = index + 1
    }

    return sum % 10 == 0
}

// Cadastro de Pessoas Físicas (Brazil): 11 digits, check digits validated and
// repeated-digit placeholders rejected.
public func cpf_valid(text: string) returns bool {
    let digits = digits_only(text)
    if str.len(digits) != 11 {
        return false
    }
    if all_digits_equal(digits) {
        return false
    }

    if cpf_check_digit(digits, 9) != digit_at(digits, 9) {
        return false
    }
    return cpf_check_digit(digits, 10) == digit_at(digits, 10)
}

// Cadastro Nacional da Pessoa Jurídica (Brazil): 14 digits with check digits.
public func cnpj_valid(text: string) returns bool {
    let digits = digits_only(text)
    if str.len(digits) != 14 {
        return false
    }
    if all_digits_equal(digits) {
        return false
    }

    if cnpj_check_digit(digits, 12) != digit_at(digits, 12) {
        return false
    }
    return cnpj_check_digit(digits, 13) == digit_at(digits, 13)
}

// IBAN: spaces are ignored, letters are uppercased, length must be 15..34 and
// the ISO 7064 mod-97 check must evaluate to 1.
public func iban_valid(text: string) returns bool {
    let normalized = alphanumeric_upper(text)
    let length = str.len(normalized)
    if length < 15 or length > 34 {
        return false
    }
    if not is_letter(str.char_at(normalized, 0)) or not is_letter(str.char_at(normalized, 1)) {
        return false
    }
    if str.char_at(normalized, 2) < 48 or str.char_at(normalized, 2) > 57 {
        return false
    }
    if str.char_at(normalized, 3) < 48 or str.char_at(normalized, 3) > 57 {
        return false
    }

    // Country code and check digits move to the end before the mod-97 pass.
    let remainder = 0
    let index = 4
    while index < length {
        remainder = iban_step(remainder, str.char_at(normalized, index))
        index = index + 1
    }
    index = 0
    while index < 4 {
        remainder = iban_step(remainder, str.char_at(normalized, index))
        index = index + 1
    }

    return remainder == 1
}

// ── Textual checks (documented heuristics) ───────────────────────────────

// Heuristic address check: exactly one `@`, non-empty local part, dotted
// domain, alphabetic TLD of at least two characters, no whitespace. It is not
// RFC 5322 and must not be the only validation for security decisions.
public func email_is_valid(text: string) returns bool {
    let length = str.len(text)
    if length < 6 or length > 254 {
        return false
    }
    if str.contains(text, " ") {
        return false
    }

    let at = str.index_of(text, "@")
    if at <= 0 or at >= length - 1 {
        return false
    }

    let domain = str.substring(text, at + 1, length)
    if str.contains(domain, "@") {
        return false
    }

    // The TLD starts after the last dot of the domain.
    let domain_length = str.len(domain)
    let last_dot = -1
    let index = 0
    while index < domain_length {
        if str.char_at(domain, index) == 46 {
            last_dot = index
        }
        index = index + 1
    }
    if last_dot <= 0 or last_dot == domain_length - 1 {
        return false
    }

    let tld = str.substring(domain, last_dot + 1, domain_length)
    if str.len(tld) < 2 {
        return false
    }
    index = 0
    while index < str.len(tld) {
        if not is_letter(str.char_at(tld, index)) {
            return false
        }
        index = index + 1
    }

    return true
}

// Heuristic absolute HTTP(S) URL check: scheme, `://`, non-empty host, no
// whitespace in the authority. Query strings and fragments are not inspected.
public func url_is_valid(text: string) returns bool {
    let length = str.len(text)

    let scheme_end = 0
    if str.starts_with(text, "https://") {
        scheme_end = 8
    } else if str.starts_with(text, "http://") {
        scheme_end = 7
    } else {
        return false
    }

    if scheme_end >= length {
        return false
    }

    let rest = str.substring(text, scheme_end, length)
    if str.contains(rest, " ") {
        return false
    }

    let path_start = str.index_of(rest, "/")
    let authority = if path_start < 0 { rest } else { str.substring(rest, 0, path_start) }
    if str.len(authority) == 0 {
        return false
    }
    // A query or fragment in the authority position means the host is missing.
    let first = str.char_at(authority, 0)
    if first == 63 or first == 35 {
        return false
    }

    return true
}

// ── Helpers ──────────────────────────────────────────────────────────────

// Keeps only decimal digits.
func digits_only(text: string) returns string {
    let builder = str.builder_new(0)
    let length = str.len(text)
    let index = 0

    while index < length {
        let code = str.char_at(text, index)
        if code >= 48 and code <= 57 {
            push_code(builder, code)
        }
        index = index + 1
    }

    return str.builder_finish(builder)
}

// Uppercases ASCII letters and drops everything that is not `0-9A-Z`.
func alphanumeric_upper(text: string) returns string {
    let builder = str.builder_new(0)
    let length = str.len(text)
    let index = 0

    while index < length {
        let code = str.char_at(text, index)
        if code >= 97 and code <= 122 {
            push_code(builder, code - 32)
        } else if (code >= 48 and code <= 57) or (code >= 65 and code <= 90) {
            push_code(builder, code)
        }
        index = index + 1
    }

    return str.builder_finish(builder)
}

func push_code(builder: int, code: int) {
    let piece = option.option_unwrap_or(str.from_scalar(code), "")
    if str.len(piece) == 1 {
        str.builder_push(builder, piece)
    }
}

func digit_at(digits: string, index: int) returns int {
    if index < 0 or index >= str.len(digits) {
        return -1
    }
    return str.char_at(digits, index) - 48
}

func is_letter(code: int) returns bool {
    if code >= 65 and code <= 90 {
        return true
    }
    return code >= 97 and code <= 122
}

func all_digits_equal(digits: string) returns bool {
    let first = str.char_at(digits, 0)
    let index = 1
    while index < str.len(digits) {
        if str.char_at(digits, index) != first {
            return false
        }
        index = index + 1
    }
    return true
}

func cpf_check_digit(digits: string, count: int) returns int {
    let sum = 0
    let index = 0
    while index < count {
        sum = sum + digit_at(digits, index) * (count + 1 - index)
        index = index + 1
    }

    let remainder = (sum * 10) % 11
    if remainder == 10 {
        return 0
    }
    return remainder
}

func cnpj_check_digit(digits: string, count: int) returns int {
    let weights: [int] = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]
    let offset = 13 - count

    let sum = 0
    let index = 0
    while index < count {
        sum = sum + digit_at(digits, index) * weights[index + offset]
        index = index + 1
    }

    let remainder = sum % 11
    if remainder < 2 {
        return 0
    }
    return 11 - remainder
}

// One mod-97 step: letters contribute their two decimal digits.
func iban_step(remainder: int, code: int) returns int {
    if code >= 48 and code <= 57 {
        return (remainder * 10 + (code - 48)) % 97
    }

    let value = code - 55
    let after_tens = (remainder * 10 + value / 10) % 97
    return (after_tens * 10 + value % 10) % 97
}


// ── GTIN / EAN family ────────────────────────────────────────────────────

// GS1 check digit for 8, 12, 13 or 14 digits (EAN-8/EAN-13/GTIN-12/GTIN-14).
// ISBN-13 keeps its own name for the domain meaning; both accept the same
// digit string.
public func gtin_valid(text: string) returns bool {
    let digits = digits_only(text)
    let length = str.len(digits)
    if length != 8 and length != 12 and length != 13 and length != 14 {
        return false
    }
    if digit_at(digits, 0) < 0 {
        return false
    }

    let sum = 0
    let index = 0
    while index < length - 1 {
        let value = digit_at(digits, index)
        if value < 0 {
            return false
        }
        let from_right = length - 2 - index
        if from_right % 2 == 0 {
            sum = sum + value * 3
        } else {
            sum = sum + value
        }
        index = index + 1
    }

    let expected = (10 - sum % 10) % 10
    return expected == digit_at(digits, length - 1)
}

// ── Card brands ──────────────────────────────────────────────────────────

// Brand inferred from the leading digits: `visa`, `mastercard`, `amex`,
// `diners`, `discover`, `elo`, or "" when unknown. The Luhn check is separate.
public func card_brand(text: string) returns string {
    let digits = digits_only(text)
    let length = str.len(digits)
    if length < 2 {
        return ""
    }

    let two = prefix_number(digits, 2)
    let four = prefix_number(digits, 4)

    if four == 4011 or four == 4312 or four == 4389 or four == 4514 or four == 4573 {
        return "elo"
    }
    if four == 5041 or four == 5067 or four == 5090 {
        return "elo"
    }
    if four == 6277 or four == 6362 or four == 6363 or four == 6504 or four == 6505 or four == 6516 or four == 6550 {
        return "elo"
    }
    if digit_at(digits, 0) == 4 {
        return "visa"
    }
    if two >= 51 and two <= 55 {
        return "mastercard"
    }
    if two == 34 or two == 37 {
        return "amex"
    }
    if two == 36 or two == 38 or two == 39 {
        return "diners"
    }
    let three = prefix_number(digits, 3)
    if three >= 300 and three <= 305 {
        return "diners"
    }
    if four == 6011 or two == 65 {
        return "discover"
    }
    if two >= 22 and two <= 27 {
        return "mastercard"
    }
    return ""
}

// ── Phone numbers ────────────────────────────────────────────────────────

// E.164 shape: `+`, a non-zero leading digit and 7 to 15 digits in total.
public func e164_valid(text: string) returns bool {
    if str.len(text) < 8 or str.char_at(text, 0) != 43 {
        return false
    }

    // Every character after the `+` must be a decimal digit; stripping
    // non-digits first would accept `+12025550123x`.
    let length = str.len(text)
    let index = 1
    while index < length {
        let code = str.char_at(text, index)
        if code < 48 or code > 57 {
            return false
        }
        index = index + 1
    }

    let digits = length - 1
    if digits < 7 or digits > 15 {
        return false
    }
    return str.char_at(text, 1) != 48
}

// ── Brazilian documents ──────────────────────────────────────────────────

// PIS/PASEP: 11 digits with the mod-11 check digit (weights 3,2,9..2).
public func pis_valid(text: string) returns bool {
    let digits = digits_only(text)
    if str.len(digits) != 11 {
        return false
    }
    if all_digits_equal(digits) {
        return false
    }

    let weights: [int] = [3, 2, 9, 8, 7, 6, 5, 4, 3, 2]
    let sum = 0
    let index = 0
    while index < 10 {
        let value = digit_at(digits, index)
        if value < 0 {
            return false
        }
        sum = sum + value * weights[index]
        index = index + 1
    }

    let expected = 11 - sum % 11
    if expected >= 10 {
        expected = 0
    }
    return expected == digit_at(digits, 10)
}

// Carteira Nacional de Habilitação: nine digits plus two check digits.
public func cnh_valid(text: string) returns bool {
    let digits = digits_only(text)
    if str.len(digits) != 11 {
        return false
    }
    if all_digits_equal(digits) {
        return false
    }

    let first = cnh_check_digit(digits, true)
    let second = cnh_check_digit(digits, false)
    return first == digit_at(digits, 9) and second == digit_at(digits, 10)
}

func cnh_check_digit(digits: string, descending: bool) returns int {
    let sum = 0
    let index = 0
    while index < 9 {
        let value = digit_at(digits, index)
        if value < 0 {
            return -1
        }
        if descending {
            sum = sum + value * (9 - index)
        } else {
            sum = sum + value * (1 + index)
        }
        index = index + 1
    }

    let digit = sum % 11
    if digit >= 10 {
        return 0
    }
    return digit
}

// Título de eleitor: eight sequence digits, two UF digits and two check
// digits. UFs run from 01 to 28.
public func titulo_eleitor_valid(text: string) returns bool {
    let digits = digits_only(text)
    if str.len(digits) != 12 {
        return false
    }
    if all_digits_equal(digits) {
        return false
    }

    let state = digit_at(digits, 8) * 10 + digit_at(digits, 9)
    if state < 1 or state > 28 {
        return false
    }

    let first = titulo_check_digit(digits, state)
    if first != digit_at(digits, 10) {
        return false
    }
    return titulo_second_digit(digits, state, first) == digit_at(digits, 11)
}

func titulo_check_digit(digits: string, state: int) returns int {
    let sum = 0
    let index = 0
    while index < 8 {
        let value = digit_at(digits, index)
        if value < 0 {
            return -1
        }
        sum = sum + value * (2 + index)
        index = index + 1
    }

    let digit = sum % 11
    if digit == 10 {
        return 0
    }
    return digit
}

func titulo_second_digit(digits: string, state: int, first: int) returns int {
    let sum = (state / 10) * 7 + (state % 10) * 8 + first * 9
    let digit = sum % 11
    if digit == 10 {
        return 0
    }
    return digit
}

// Alphanumeric CNPJ: twelve characters whose digit value is `code - 48`
// (letters A-Z count as 17..42) plus two numeric check digits.
public func cnpj_alpha_valid(text: string) returns bool {
    let characters = alphanumeric_upper(text)
    if str.len(characters) != 14 {
        return false
    }

    let first = cnpj_alpha_check_digit(characters, 12)
    let second = cnpj_alpha_check_digit(characters, 13)
    if first != digit_at(characters, 12) or second != digit_at(characters, 13) {
        return false
    }
    return true
}

func cnpj_alpha_check_digit(characters: string, count: int) returns int {
    let weights: [int] = [6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2]
    let offset = 13 - count

    let sum = 0
    let index = 0
    while index < count {
        let code = str.char_at(characters, index)
        let value = code - 48
        if value < 0 or value > 42 {
            return -1
        }
        sum = sum + value * weights[index + offset]
        index = index + 1
    }

    let remainder = sum % 11
    if remainder < 2 {
        return 0
    }
    return 11 - remainder
}

// Numeric value of the first `count` digits, or -1 when they are not digits.
func prefix_number(digits: string, count: int) returns int {
    if str.len(digits) < count {
        return -1
    }

    let value = 0
    let index = 0
    while index < count {
        let digit = digit_at(digits, index)
        if digit < 0 {
            return -1
        }
        value = value * 10 + digit
        index = index + 1
    }
    return value
}
