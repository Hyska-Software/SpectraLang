module std.algorithms

import std.collections as collections
import std.option as option
import std.string as str

// Requires nonnegative arguments. By convention gcd_nonnegative(0, 0) is 0.
public func gcd_nonnegative(a: int, b: int) returns int {
    let left = a
    let right = b

    while right != 0 {
        let remainder = left % right
        left = right
        right = remainder
    }

    return left
}

// Values below 2 are not prime. Division in the loop condition avoids overflow
// from multiplying the divisor by itself.
public func is_prime(value: int) returns bool {
    if value < 2 {
        return false
    }

    let divisor = 2
    while divisor <= value / divisor {
        if value % divisor == 0 {
            return false
        }
        divisor = divisor + 1
    }

    return true
}

// ── Search ───────────────────────────────────────────────────────────────

// Index of `target` in a non-decreasing `sorted` list, or -1 when absent.
// Duplicate values resolve to one of their indexes.
public func binary_search_int(sorted: List<int>, target: int) returns int {
    let low = 0
    let high = collections.list_len(sorted) - 1

    while low <= high {
        let middle = low + (high - low) / 2
        let value = option.option_unwrap_or(collections.list_get(sorted, middle), 0)
        if value == target {
            return middle
        }
        if value < target {
            low = middle + 1
        } else {
            high = middle - 1
        }
    }

    return -1
}

// ── Radix conversion ─────────────────────────────────────────────────────

// Text representation of `value` in `radix` (2..=36) using lowercase digits
// `0-9a-z`. Negative values and radices outside the range return None.
public func to_base(value: int, radix: int) returns Option<string> {
    if value < 0 or radix < 2 or radix > 36 {
        return Option::None
    }
    if value == 0 {
        return Option::Some("0")
    }

    let digits: List<int> = collections.list_new()
    let remaining = value
    while remaining > 0 {
        collections.list_push(digits, remaining % radix)
        remaining = remaining / radix
    }

    let builder = str.builder_new(0)
    let index = collections.list_len(digits) - 1
    while index >= 0 {
        let digit = option.option_unwrap_or(collections.list_get(digits, index), 0)
        let code = if digit < 10 { 48 + digit } else { 87 + digit }
        let piece = str.from_scalar(code)
        if not option.is_some(piece) {
            str.builder_free(builder)
            return Option::None
        }
        str.builder_push(builder, option.option_unwrap_or(piece, ""))
        index = index - 1
    }

    return Option::Some(str.builder_finish(builder))
}

// Parses an unsigned integer written in `radix` (2..=36). Both lowercase and
// uppercase digits are accepted; no sign, separators or prefixes are allowed.
// Invalid digits, empty input and i64 overflow return None.
public func from_base(text: string, radix: int) returns Option<int> {
    if radix < 2 or radix > 36 {
        return Option::None
    }

    let length = str.len(text)
    if length == 0 {
        return Option::None
    }

    let result = 0
    let index = 0
    while index < length {
        let digit = digit_value(str.char_at(text, index))
        if digit < 0 or digit >= radix {
            return Option::None
        }
        if result > (9223372036854775807 - digit) / radix {
            return Option::None
        }
        result = result * radix + digit
        index = index + 1
    }

    return Option::Some(result)
}

// Value of one alphanumeric digit (`0-9`, `a-z`, `A-Z`), or -1.
func digit_value(code: int) returns int {
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 122 {
        return code - 87
    }
    if code >= 65 and code <= 90 {
        return code - 55
    }
    return -1
}

// ── Number theory ────────────────────────────────────────────────────────

// Multiplicative inverse of `value` modulo `modulus`, or None when it does
// not exist. Requires `value >= 0` and `modulus > 1`.
public func mod_inverse(value: int, modulus: int) returns Option<int> {
    if value < 0 or modulus <= 1 {
        return Option::None
    }

    let old_remainder = value % modulus
    let remainder = modulus
    let old_coefficient = 1
    let coefficient = 0

    while remainder != 0 {
        let quotient = old_remainder / remainder
        let next_remainder = old_remainder - quotient * remainder
        old_remainder = remainder
        remainder = next_remainder
        let next_coefficient = old_coefficient - quotient * coefficient
        old_coefficient = coefficient
        coefficient = next_coefficient
    }

    if old_remainder != 1 {
        return Option::None
    }

    let inverse = old_coefficient % modulus
    if inverse < 0 {
        inverse = inverse + modulus
    }
    return Option::Some(inverse)
}

// `value!`, or None for negative input and i64 overflow (21! and above).
public func factorial(value: int) returns Option<int> {
    if value < 0 {
        return Option::None
    }

    let result = 1
    let factor = 2
    while factor <= value {
        if result > 9223372036854775807 / factor {
            return Option::None
        }
        result = result * factor
        factor = factor + 1
    }

    return Option::Some(result)
}

// Binomial coefficient `n choose k`, or None for out-of-range input and
// overflow of an intermediate product (the division is exact at every step of
// the multiplicative formula, but the pre-division product is checked
// conservatively because the language has no wider-than-i64 integer).
public func binomial(n: int, k: int) returns Option<int> {
    if n < 0 or k < 0 or k > n {
        return Option::None
    }

    // Symmetry: C(n, k) == C(n, n - k). Iterating over the smaller bound keeps
    // the loop short, and the numerator must use that same bound.
    let steps = k
    if n - k < k {
        steps = n - k
    }

    let result = 1
    let step = 1
    while step <= steps {
        let factor = n - steps + step
        if result > 9223372036854775807 / factor {
            return Option::None
        }
        result = result * factor / step
        step = step + 1
    }

    return Option::Some(result)
}

// Number of Collatz steps that take `value` to 1. Values below 1 and inputs
// whose `3n + 1` step would overflow i64 return None.
public func collatz_steps(value: int) returns Option<int> {
    if value < 1 {
        return Option::None
    }

    let current = value
    let steps = 0
    while current != 1 {
        if current % 2 == 0 {
            current = current / 2
        } else {
            if current > 3074457345618258601 {
                return Option::None
            }
            current = 3 * current + 1
        }
        steps = steps + 1
    }

    return Option::Some(steps)
}

// Sum of the decimal digits of `value` (sign ignored). i64::MIN is supported
// because digits are extracted with truncating division.
public func digit_sum(value: int) returns int {
    let remaining = value
    let sum = 0

    while remaining != 0 {
        let digit = remaining % 10
        if digit < 0 {
            digit = -digit
        }
        sum = sum + digit
        remaining = remaining / 10
    }

    return sum
}

// ── Roman numerals ───────────────────────────────────────────────────────

// Canonical Roman numeral for `1..=3999`; other values return None.
public func roman_encode(value: int) returns Option<string> {
    if value < 1 or value > 3999 {
        return Option::None
    }

    let builder = str.builder_new(0)
    let remaining = value

    while remaining >= 1000 {
        str.builder_push(builder, "M")
        remaining = remaining - 1000
    }
    while remaining >= 900 {
        str.builder_push(builder, "CM")
        remaining = remaining - 900
    }
    while remaining >= 500 {
        str.builder_push(builder, "D")
        remaining = remaining - 500
    }
    while remaining >= 400 {
        str.builder_push(builder, "CD")
        remaining = remaining - 400
    }
    while remaining >= 100 {
        str.builder_push(builder, "C")
        remaining = remaining - 100
    }
    while remaining >= 90 {
        str.builder_push(builder, "XC")
        remaining = remaining - 90
    }
    while remaining >= 50 {
        str.builder_push(builder, "L")
        remaining = remaining - 50
    }
    while remaining >= 40 {
        str.builder_push(builder, "XL")
        remaining = remaining - 40
    }
    while remaining >= 10 {
        str.builder_push(builder, "X")
        remaining = remaining - 10
    }
    while remaining >= 9 {
        str.builder_push(builder, "IX")
        remaining = remaining - 9
    }
    while remaining >= 5 {
        str.builder_push(builder, "V")
        remaining = remaining - 5
    }
    while remaining >= 4 {
        str.builder_push(builder, "IV")
        remaining = remaining - 4
    }
    while remaining >= 1 {
        str.builder_push(builder, "I")
        remaining = remaining - 1
    }

    return Option::Some(str.builder_finish(builder))
}

// Parses a Roman numeral with the standard subtractive rule. Empty input and
// unknown symbols return None; non-canonical spellings that still use valid
// symbols are accepted.
public func roman_decode(text: string) returns Option<int> {
    let length = str.len(text)
    if length == 0 {
        return Option::None
    }

    let total = 0
    let index = 0
    while index < length {
        let current = roman_value(str.char_at(text, index))
        if current < 0 {
            return Option::None
        }

        let next = 0
        if index + 1 < length {
            next = roman_value(str.char_at(text, index + 1))
            if next < 0 {
                return Option::None
            }
        }

        if current < next {
            total = total + (next - current)
            index = index + 2
        } else {
            total = total + current
            index = index + 1
        }
    }

    return Option::Some(total)
}

func roman_value(code: int) returns int {
    if code == 73 {
        return 1
    }
    if code == 86 {
        return 5
    }
    if code == 88 {
        return 10
    }
    if code == 76 {
        return 50
    }
    if code == 67 {
        return 100
    }
    if code == 68 {
        return 500
    }
    if code == 77 {
        return 1000
    }
    return -1
}

// ── Text distance ────────────────────────────────────────────────────────

// Levenshtein distance in Unicode scalar values (insertions, deletions and
// substitutions each cost 1). UTF-8 is decoded with range arithmetic, so no
// byte is split.
public func levenshtein(left: string, right: string) returns int {
    let left_codes: List<int> = collections.list_new()
    let right_codes: List<int> = collections.list_new()
    let left_length = collect_runes(left, left_codes)
    let right_length = collect_runes(right, right_codes)

    if left_length == 0 {
        return right_length
    }
    if right_length == 0 {
        return left_length
    }

    let previous: List<int> = collections.list_new()
    let column = 0
    while column <= right_length {
        collections.list_push(previous, column)
        column = column + 1
    }

    let row = 1
    while row <= left_length {
        let current: List<int> = collections.list_new()
        collections.list_push(current, row)
        column = 1
        while column <= right_length {
            let substitution =
                option.option_unwrap_or(collections.list_get(previous, column - 1), 0)
            let left_code = option.option_unwrap_or(collections.list_get(left_codes, row - 1), 0)
            let right_code = option.option_unwrap_or(collections.list_get(right_codes, column - 1), 0)
            if left_code != right_code {
                substitution = substitution + 1
            }

            let deletion = option.option_unwrap_or(collections.list_get(previous, column), 0) + 1
            let insertion = option.option_unwrap_or(collections.list_get(current, column - 1), 0) + 1

            let best = substitution
            if deletion < best {
                best = deletion
            }
            if insertion < best {
                best = insertion
            }

            collections.list_push(current, best)
            column = column + 1
        }
        previous = current
        row = row + 1
    }

    return option.option_unwrap_or(collections.list_get(previous, right_length), 0)
}

// Appends the code points of `text` to `codes` and returns the rune count.
func collect_runes(text: string, codes: List<int>) returns int {
    let bytes = str.len(text)
    let offset = 0
    let count = 0

    while offset < bytes {
        let first = str.char_at(text, offset)
        if first < 128 {
            collections.list_push(codes, first)
            offset = offset + 1
        } else if first < 224 {
            collections.list_push(
                codes,
                (first - 192) * 64 + (str.char_at(text, offset + 1) - 128),
            )
            offset = offset + 2
        } else if first < 240 {
            collections.list_push(
                codes,
                (first - 224) * 4096 +
                (str.char_at(text, offset + 1) - 128) * 64 +
                (str.char_at(text, offset + 2) - 128),
            )
            offset = offset + 3
        } else {
            collections.list_push(
                codes,
                (first - 240) * 262144 +
                (str.char_at(text, offset + 1) - 128) * 4096 +
                (str.char_at(text, offset + 2) - 128) * 64 +
                (str.char_at(text, offset + 3) - 128),
            )
            offset = offset + 4
        }
        count = count + 1
    }

    return count
}
