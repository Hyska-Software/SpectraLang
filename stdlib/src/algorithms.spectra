module std.algorithms

import std.collections as collections
import std.option as option
import std.string as str
import std.unicode as unicode

// Requires nonnegative arguments. By convention gcd_nonnegative(0, 0) is 0.
public func gcd_nonnegative(a: int, b: int) returns int {
    let left = a
    let right = b

    while right != 0 {
        let remainder = left % right
        left = right
        right = remainder
    }

    return left
}

// Values below 2 are not prime. Division in the loop condition avoids overflow
// from multiplying the divisor by itself.
public func is_prime(value: int) returns bool {
    if value < 2 {
        return false
    }

    let divisor = 2
    while divisor <= value / divisor {
        if value % divisor == 0 {
            return false
        }
        divisor = divisor + 1
    }

    return true
}

// ── Search ───────────────────────────────────────────────────────────────

// Index of `target` in a non-decreasing `sorted` list, or -1 when absent.
// Duplicate values resolve to one of their indexes.
public func binary_search_int(sorted: List<int>, target: int) returns int {
    let low = 0
    let high = collections.list_len(sorted) - 1

    while low <= high {
        let middle = low + (high - low) / 2
        let value = option.option_unwrap_or(collections.list_get(sorted, middle), 0)
        if value == target {
            return middle
        }
        if value < target {
            low = middle + 1
        } else {
            high = middle - 1
        }
    }

    return -1
}

// ── Radix conversion ─────────────────────────────────────────────────────

// Text representation of `value` in `radix` (2..=36) using lowercase digits
// `0-9a-z`. Negative values and radices outside the range return None.
public func to_base(value: int, radix: int) returns Option<string> {
    if value < 0 or radix < 2 or radix > 36 {
        return Option::None
    }
    if value == 0 {
        return Option::Some("0")
    }

    let digits: List<int> = collections.list_new()
    let remaining = value
    while remaining > 0 {
        collections.list_push(digits, remaining % radix)
        remaining = remaining / radix
    }

    let builder = str.builder_new(0)
    let index = collections.list_len(digits) - 1
    while index >= 0 {
        let digit = option.option_unwrap_or(collections.list_get(digits, index), 0)
        let code = if digit < 10 { 48 + digit } else { 87 + digit }
        let piece = str.from_scalar(code)
        if not option.is_some(piece) {
            str.builder_free(builder)
            return Option::None
        }
        str.builder_push(builder, option.option_unwrap_or(piece, ""))
        index = index - 1
    }

    return Option::Some(str.builder_finish(builder))
}

// Parses an unsigned integer written in `radix` (2..=36). Both lowercase and
// uppercase digits are accepted; no sign, separators or prefixes are allowed.
// Invalid digits, empty input and i64 overflow return None.
public func from_base(text: string, radix: int) returns Option<int> {
    if radix < 2 or radix > 36 {
        return Option::None
    }

    let length = str.len(text)
    if length == 0 {
        return Option::None
    }

    let result = 0
    let index = 0
    while index < length {
        let digit = digit_value(str.char_at(text, index))
        if digit < 0 or digit >= radix {
            return Option::None
        }
        if result > (9223372036854775807 - digit) / radix {
            return Option::None
        }
        result = result * radix + digit
        index = index + 1
    }

    return Option::Some(result)
}

// Value of one alphanumeric digit (`0-9`, `a-z`, `A-Z`), or -1.
func digit_value(code: int) returns int {
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 122 {
        return code - 87
    }
    if code >= 65 and code <= 90 {
        return code - 55
    }
    return -1
}

// ── Number theory ────────────────────────────────────────────────────────

// Multiplicative inverse of `value` modulo `modulus`, or None when it does
// not exist. Requires `value >= 0` and `modulus > 1`.
public func mod_inverse(value: int, modulus: int) returns Option<int> {
    if value < 0 or modulus <= 1 {
        return Option::None
    }

    let old_remainder = value % modulus
    let remainder = modulus
    let old_coefficient = 1
    let coefficient = 0

    while remainder != 0 {
        let quotient = old_remainder / remainder
        let next_remainder = old_remainder - quotient * remainder
        old_remainder = remainder
        remainder = next_remainder
        let next_coefficient = old_coefficient - quotient * coefficient
        old_coefficient = coefficient
        coefficient = next_coefficient
    }

    if old_remainder != 1 {
        return Option::None
    }

    let inverse = old_coefficient % modulus
    if inverse < 0 {
        inverse = inverse + modulus
    }
    return Option::Some(inverse)
}

// `value!`, or None for negative input and i64 overflow (21! and above).
public func factorial(value: int) returns Option<int> {
    if value < 0 {
        return Option::None
    }

    let result = 1
    let factor = 2
    while factor <= value {
        if result > 9223372036854775807 / factor {
            return Option::None
        }
        result = result * factor
        factor = factor + 1
    }

    return Option::Some(result)
}

// Binomial coefficient `n choose k`, or None for out-of-range input and
// overflow of an intermediate product (the division is exact at every step of
// the multiplicative formula, but the pre-division product is checked
// conservatively because the language has no wider-than-i64 integer).
public func binomial(n: int, k: int) returns Option<int> {
    if n < 0 or k < 0 or k > n {
        return Option::None
    }

    // Symmetry: C(n, k) == C(n, n - k). Iterating over the smaller bound keeps
    // the loop short, and the numerator must use that same bound.
    let steps = k
    if n - k < k {
        steps = n - k
    }

    let result = 1
    let step = 1
    while step <= steps {
        let factor = n - steps + step
        if result > 9223372036854775807 / factor {
            return Option::None
        }
        result = result * factor / step
        step = step + 1
    }

    return Option::Some(result)
}

// Number of Collatz steps that take `value` to 1. Values below 1 and inputs
// whose `3n + 1` step would overflow i64 return None.
public func collatz_steps(value: int) returns Option<int> {
    if value < 1 {
        return Option::None
    }

    let current = value
    let steps = 0
    while current != 1 {
        if current % 2 == 0 {
            current = current / 2
        } else {
            if current > 3074457345618258601 {
                return Option::None
            }
            current = 3 * current + 1
        }
        steps = steps + 1
    }

    return Option::Some(steps)
}

// Sum of the decimal digits of `value` (sign ignored). i64::MIN is supported
// because digits are extracted with truncating division.
public func digit_sum(value: int) returns int {
    let remaining = value
    let sum = 0

    while remaining != 0 {
        let digit = remaining % 10
        if digit < 0 {
            digit = -digit
        }
        sum = sum + digit
        remaining = remaining / 10
    }

    return sum
}

// ── Roman numerals ───────────────────────────────────────────────────────

// Canonical Roman numeral for `1..=3999`; other values return None.
public func roman_encode(value: int) returns Option<string> {
    if value < 1 or value > 3999 {
        return Option::None
    }

    let builder = str.builder_new(0)
    let remaining = value

    while remaining >= 1000 {
        str.builder_push(builder, "M")
        remaining = remaining - 1000
    }
    while remaining >= 900 {
        str.builder_push(builder, "CM")
        remaining = remaining - 900
    }
    while remaining >= 500 {
        str.builder_push(builder, "D")
        remaining = remaining - 500
    }
    while remaining >= 400 {
        str.builder_push(builder, "CD")
        remaining = remaining - 400
    }
    while remaining >= 100 {
        str.builder_push(builder, "C")
        remaining = remaining - 100
    }
    while remaining >= 90 {
        str.builder_push(builder, "XC")
        remaining = remaining - 90
    }
    while remaining >= 50 {
        str.builder_push(builder, "L")
        remaining = remaining - 50
    }
    while remaining >= 40 {
        str.builder_push(builder, "XL")
        remaining = remaining - 40
    }
    while remaining >= 10 {
        str.builder_push(builder, "X")
        remaining = remaining - 10
    }
    while remaining >= 9 {
        str.builder_push(builder, "IX")
        remaining = remaining - 9
    }
    while remaining >= 5 {
        str.builder_push(builder, "V")
        remaining = remaining - 5
    }
    while remaining >= 4 {
        str.builder_push(builder, "IV")
        remaining = remaining - 4
    }
    while remaining >= 1 {
        str.builder_push(builder, "I")
        remaining = remaining - 1
    }

    return Option::Some(str.builder_finish(builder))
}

// Parses a Roman numeral with the standard subtractive rule. Empty input and
// unknown symbols return None; non-canonical spellings that still use valid
// symbols are accepted.
public func roman_decode(text: string) returns Option<int> {
    let length = str.len(text)
    if length == 0 {
        return Option::None
    }

    let total = 0
    let index = 0
    while index < length {
        let current = roman_value(str.char_at(text, index))
        if current < 0 {
            return Option::None
        }

        let next = 0
        if index + 1 < length {
            next = roman_value(str.char_at(text, index + 1))
            if next < 0 {
                return Option::None
            }
        }

        if current < next {
            total = total + (next - current)
            index = index + 2
        } else {
            total = total + current
            index = index + 1
        }
    }

    return Option::Some(total)
}

func roman_value(code: int) returns int {
    if code == 73 {
        return 1
    }
    if code == 86 {
        return 5
    }
    if code == 88 {
        return 10
    }
    if code == 76 {
        return 50
    }
    if code == 67 {
        return 100
    }
    if code == 68 {
        return 500
    }
    if code == 77 {
        return 1000
    }
    return -1
}

// ── Text distance ────────────────────────────────────────────────────────

// Levenshtein distance in Unicode scalar values (insertions, deletions and
// substitutions each cost 1). UTF-8 is decoded with range arithmetic, so no
// byte is split.
public func levenshtein(left: string, right: string) returns int {
    let left_codes = unicode.to_codepoints(left)
    let right_codes = unicode.to_codepoints(right)
    let left_length = collections.list_len(left_codes)
    let right_length = collections.list_len(right_codes)

    if left_length == 0 {
        return right_length
    }
    if right_length == 0 {
        return left_length
    }

    let previous: List<int> = collections.list_new()
    let column = 0
    while column <= right_length {
        collections.list_push(previous, column)
        column = column + 1
    }

    let row = 1
    while row <= left_length {
        let current: List<int> = collections.list_new()
        collections.list_push(current, row)
        column = 1
        while column <= right_length {
            let substitution =
                option.option_unwrap_or(collections.list_get(previous, column - 1), 0)
            let left_code = option.option_unwrap_or(collections.list_get(left_codes, row - 1), 0)
            let right_code = option.option_unwrap_or(collections.list_get(right_codes, column - 1), 0)
            if left_code != right_code {
                substitution = substitution + 1
            }

            let deletion = option.option_unwrap_or(collections.list_get(previous, column), 0) + 1
            let insertion = option.option_unwrap_or(collections.list_get(current, column - 1), 0) + 1

            let best = substitution
            if deletion < best {
                best = deletion
            }
            if insertion < best {
                best = insertion
            }

            collections.list_push(current, best)
            column = column + 1
        }
        previous = current
        row = row + 1
    }

    return option.option_unwrap_or(collections.list_get(previous, right_length), 0)
}

// ── String search ────────────────────────────────────────────────────────

// Byte-wise lexicographic comparison in UTF-8 byte order: -1, 0 or 1. ASCII
// text therefore compares by code point, and the order is well defined for
// arbitrary UTF-8 so it can act as a deterministic tie-breaker.
func compare_strings(left: string, right: string) returns int {
    let left_length = str.len(left)
    let right_length = str.len(right)
    let limit = left_length
    if right_length < limit {
        limit = right_length
    }

    let index = 0
    while index < limit {
        let left_byte = str.char_at(left, index)
        let right_byte = str.char_at(right, index)
        if left_byte < right_byte {
            return -1
        }
        if left_byte > right_byte {
            return 1
        }
        index = index + 1
    }

    if left_length < right_length {
        return -1
    }
    if left_length > right_length {
        return 1
    }
    return 0
}

// Index of `target` in a non-decreasing `sorted` list, or -1 when absent.
// The list must be sorted under the byte-wise order of `compare_strings`.
// Duplicate values resolve to one of their indexes.
public func binary_search_string(sorted: List<string>, target: string) returns int {
    let low = 0
    let high = collections.list_len(sorted) - 1

    while low <= high {
        let middle = low + (high - low) / 2
        let value = option.option_unwrap_or(collections.list_get(sorted, middle), "")
        let order = compare_strings(value, target)
        if order == 0 {
            return middle
        }
        if order < 0 {
            low = middle + 1
        } else {
            high = middle - 1
        }
    }

    return -1
}

// First byte index of `needle` in `haystack`, or -1 when it does not occur.
// An empty `needle` matches at index 0; an empty `haystack` with a non-empty
// `needle` returns -1. Knuth–Morris–Pratt keeps the scan linear in the
// haystack length.
public func kmp_find(haystack: string, needle: string) returns int {
    let needle_length = str.len(needle)
    if needle_length == 0 {
        return 0
    }
    let haystack_length = str.len(haystack)
    if haystack_length == 0 {
        return -1
    }

    // Failure table: longest proper prefix of needle[..i] that is a suffix.
    let failure: List<int> = collections.list_new()
    collections.list_push(failure, 0)
    let length = 1
    let prefix = 0
    while length < needle_length {
        if str.char_at(needle, length) == str.char_at(needle, prefix) {
            prefix = prefix + 1
            collections.list_push(failure, prefix)
            length = length + 1
        } else if prefix > 0 {
            prefix = option.option_unwrap_or(collections.list_get(failure, prefix - 1), 0)
        } else {
            collections.list_push(failure, 0)
            length = length + 1
        }
    }

    let position = 0
    let matched = 0
    while position < haystack_length {
        if str.char_at(haystack, position) == str.char_at(needle, matched) {
            position = position + 1
            matched = matched + 1
            if matched == needle_length {
                return position - needle_length
            }
        } else if matched > 0 {
            matched = option.option_unwrap_or(collections.list_get(failure, matched - 1), 0)
        } else {
            position = position + 1
        }
    }

    return -1
}

// ── Longest common subsequence ───────────────────────────────────────────

// Longest common subsequence of `left` and `right` over Unicode scalar values.
// Ties are resolved deterministically: when skipping either side is equally
// good, the branch that advances `left` (drops the current scalar of `left`)
// is taken, and a current match is always consumed.
public func lcs(left: string, right: string) returns string {
    let left_codes = unicode.to_codepoints(left)
    let right_codes = unicode.to_codepoints(right)
    let left_length = collections.list_len(left_codes)
    let right_length = collections.list_len(right_codes)

    let builder = str.builder_new(0)
    if left_length == 0 or right_length == 0 {
        return str.builder_finish(builder)
    }

    // lengths[i * width + j] is the LCS length of left[i..] and right[j..].
    let width = right_length + 1
    let lengths: List<int> = collections.list_new()
    let total = (left_length + 1) * width
    let filled = 0
    while filled < total {
        collections.list_push(lengths, 0)
        filled = filled + 1
    }

    let row = left_length - 1
    while row >= 0 {
        let column = right_length - 1
        while column >= 0 {
            let left_code = option.option_unwrap_or(collections.list_get(left_codes, row), 0)
            let right_code = option.option_unwrap_or(collections.list_get(right_codes, column), 0)
            let best = option.option_unwrap_or(
                collections.list_get(lengths, (row + 1) * width + column),
                0,
            )
            if left_code == right_code {
                best = option.option_unwrap_or(
                    collections.list_get(lengths, (row + 1) * width + column + 1),
                    0,
                ) + 1
            } else {
                let skip_right = option.option_unwrap_or(
                    collections.list_get(lengths, row * width + column + 1),
                    0,
                )
                if skip_right > best {
                    best = skip_right
                }
            }
            collections.list_set(lengths, row * width + column, best)
            column = column - 1
        }
        row = row - 1
    }

    let left_index = 0
    let right_index = 0
    while left_index < left_length and right_index < right_length {
        let left_code = option.option_unwrap_or(collections.list_get(left_codes, left_index), 0)
        let right_code = option.option_unwrap_or(collections.list_get(right_codes, right_index), 0)
        if left_code == right_code {
            let piece = str.from_scalar(left_code)
            str.builder_push(builder, option.option_unwrap_or(piece, ""))
            left_index = left_index + 1
            right_index = right_index + 1
        } else {
            let advance_left = option.option_unwrap_or(
                collections.list_get(lengths, (left_index + 1) * width + right_index),
                0,
            )
            let advance_right = option.option_unwrap_or(
                collections.list_get(lengths, left_index * width + right_index + 1),
                0,
            )
            if advance_left >= advance_right {
                left_index = left_index + 1
            } else {
                right_index = right_index + 1
            }
        }
    }

    return str.builder_finish(builder)
}

// ── Damerau–Levenshtein distance ─────────────────────────────────────────

// Edit distance over Unicode scalar values where an insertion, a deletion, a
// substitution and a transposition of two adjacent scalars each cost 1. This
// is the unrestricted variant, so a transposition may combine with earlier
// edits (for example "CA" to "ABC" costs 2, not 3).
public func damerau_levenshtein(left: string, right: string) returns int {
    let left_codes = unicode.to_codepoints(left)
    let right_codes = unicode.to_codepoints(right)
    let left_length = collections.list_len(left_codes)
    let right_length = collections.list_len(right_codes)

    if left_length == 0 {
        return right_length
    }
    if right_length == 0 {
        return left_length
    }

    let width = right_length + 1
    let distances: List<int> = collections.list_new()
    let total = (left_length + 1) * width
    let filled = 0
    while filled < total {
        collections.list_push(distances, 0)
        filled = filled + 1
    }

    let column = 0
    while column <= right_length {
        collections.list_set(distances, column, column)
        column = column + 1
    }
    let row = 0
    while row <= left_length {
        collections.list_set(distances, row * width, row)
        row = row + 1
    }

    // Last row in which each scalar of `left` was seen (`da` in the classic
    // formulation), kept as parallel lists because no map is in scope.
    let seen_codes: List<int> = collections.list_new()
    let seen_rows: List<int> = collections.list_new()

    let i = 1
    while i <= left_length {
        let left_code = option.option_unwrap_or(collections.list_get(left_codes, i - 1), 0)
        let matched_column = 0
        let j = 1
        while j <= right_length {
            let right_code = option.option_unwrap_or(collections.list_get(right_codes, j - 1), 0)
            let last_row = last_seen_row(seen_codes, seen_rows, right_code)
            let last_column = matched_column

            let cost = 1
            if left_code == right_code {
                cost = 0
                matched_column = j
            }

            let substitution = option.option_unwrap_or(
                collections.list_get(distances, (i - 1) * width + (j - 1)),
                0,
            ) + cost
            let deletion = option.option_unwrap_or(
                collections.list_get(distances, (i - 1) * width + j),
                0,
            ) + 1
            let insertion = option.option_unwrap_or(
                collections.list_get(distances, i * width + (j - 1)),
                0,
            ) + 1

            let best = substitution
            if deletion < best {
                best = deletion
            }
            if insertion < best {
                best = insertion
            }

            if last_row > 0 and last_column > 0 {
                let transposition = option.option_unwrap_or(
                    collections.list_get(distances, (last_row - 1) * width + (last_column - 1)),
                    0,
                ) + (i - last_row - 1) + 1 + (j - last_column - 1)
                if transposition < best {
                    best = transposition
                }
            }

            collections.list_set(distances, i * width + j, best)
            j = j + 1
        }
        mark_seen(seen_codes, seen_rows, left_code, i)
        i = i + 1
    }

    return option.option_unwrap_or(
        collections.list_get(distances, left_length * width + right_length),
        0,
    )
}

// Row where `code` was last seen, or 0 when it was never recorded.
func last_seen_row(codes: List<int>, rows: List<int>, code: int) returns int {
    let index = 0
    let length = collections.list_len(codes)
    while index < length {
        if option.option_unwrap_or(collections.list_get(codes, index), -1) == code {
            return option.option_unwrap_or(collections.list_get(rows, index), 0)
        }
        index = index + 1
    }
    return 0
}

// Records `code` as last seen at `row`, replacing any earlier entry.
func mark_seen(codes: List<int>, rows: List<int>, code: int, row: int) {
    let index = 0
    let length = collections.list_len(codes)
    while index < length {
        if option.option_unwrap_or(collections.list_get(codes, index), -1) == code {
            collections.list_set(rows, index, row)
            return
        }
        index = index + 1
    }
    collections.list_push(codes, code)
    collections.list_push(rows, row)
}

// ── Number theory (extended) ─────────────────────────────────────────────

// `(left * right) % modulus` for nonnegative operands without overflowing i64:
// the direct product is used only when it is known to fit, otherwise the
// multiplication falls back to shift-and-add modular doubling.
func mul_mod(left: int, right: int, modulus: int) returns int {
    if left == 0 or right == 0 {
        return 0
    }
    if left <= 9223372036854775807 / right {
        return (left * right) % modulus
    }

    let result = 0
    let addend = left % modulus
    let multiplier = right
    while multiplier > 0 {
        if multiplier % 2 == 1 {
            result = add_mod(result, addend, modulus)
        }
        addend = add_mod(addend, addend, modulus)
        multiplier = multiplier / 2
    }
    return result
}

// `(left + right) % modulus` for operands in `0..modulus` and `modulus > 0`
// without overflowing i64.
func add_mod(left: int, right: int, modulus: int) returns int {
    let complement = modulus - right
    if left >= complement {
        return left - complement
    }
    return left + right
}

// `base^exponent mod modulus`, or None for a negative exponent or a modulus
// that is not positive. `modulus == 1` collapses to Some(0). Square-and-multiply
// with overflow-safe modular multiplication, so every i64 base, exponent and
// modulus is computed exactly.
public func mod_pow(base: int, exponent: int, modulus: int) returns Option<int> {
    if exponent < 0 or modulus <= 0 {
        return Option::None
    }
    if modulus == 1 {
        return Option::Some(0)
    }

    let factor = base % modulus
    if factor < 0 {
        factor = factor + modulus
    }

    let result = 1
    let remaining = exponent
    while remaining > 0 {
        if remaining % 2 == 1 {
            result = mul_mod(result, factor, modulus)
        }
        factor = mul_mod(factor, factor, modulus)
        remaining = remaining / 2
    }

    return Option::Some(result)
}

// Floor square root of `value`, or None for negative input. The search is
// integer-only (no float rounding), so it is exact for the full i64 range.
public func integer_sqrt(value: int) returns Option<int> {
    if value < 0 {
        return Option::None
    }

    let low = 1
    let high = value
    let root = 0
    while low <= high {
        let middle = low + (high - low) / 2
        if middle <= value / middle {
            root = middle
            low = middle + 1
        } else {
            high = middle - 1
        }
    }

    return Option::Some(root)
}

// Smallest nonnegative solution of the congruences `x ≡ remainders[i]` modulo
// `moduli[i]`, or None when the lists differ in length, are empty, contain a
// modulus <= 1, are inconsistent, or when the combined modulus would exceed
// i64. The result lies in `0..lcm`.
public func chinese_remainder(remainders: List<int>, moduli: List<int>) returns Option<int> {
    let count = collections.list_len(remainders)
    if count == 0 or collections.list_len(moduli) != count {
        return Option::None
    }

    let result = 0
    let current = 1
    let index = 0
    while index < count {
        let modulus = option.option_unwrap_or(collections.list_get(moduli, index), 0)
        if modulus <= 1 {
            return Option::None
        }

        let target = option.option_unwrap_or(collections.list_get(remainders, index), 0) % modulus
        if target < 0 {
            target = target + modulus
        }

        let divisor = gcd_nonnegative(current, modulus)
        let gap = (target - result) % modulus
        if gap < 0 {
            gap = gap + modulus
        }
        if gap % divisor != 0 {
            return Option::None
        }

        let reduced = modulus / divisor
        let step = 0
        if reduced > 1 {
            let inverse = mod_inverse((current / divisor) % reduced, reduced)
            if not option.is_some(inverse) {
                return Option::None
            }
            step = mul_mod(gap / divisor, option.option_unwrap_or(inverse, 0), reduced)
        }

        if current / divisor > 9223372036854775807 / modulus {
            return Option::None
        }
        let combined = current / divisor * modulus
        result = add_mod(result, current * step, combined)
        current = combined
        index = index + 1
    }

    return Option::Some(result)
}
