module std.fmt

import std.convert as convert
import std.math as math
import std.option as option
import std.string as str

// Text formatting helpers on top of the native conversions. Values that cannot
// be represented (negative width, too many decimals, i64 overflow) return
// `None` instead of a truncated string.

// `value` padded to `width` characters with `pad` (space or `0`). The sign is
// kept in front of the padding for negative values.
public func int_padded(value: int, width: int, pad: char) returns Option<string> {
    if width < 0 {
        return Option::None
    }

    let pad_code = pad as int
    if pad_code != 32 and pad_code != 48 {
        return Option::None
    }

    let text = convert.int_to_string(value)
    let length = str.len(text)
    if length >= width {
        return Option::Some(text)
    }

    let pad_text = str.repeat_str(option.option_unwrap_or(str.from_scalar(pad_code), ""), width - length)
    // Zero padding keeps the sign in front of the zeros ("-00042"); space
    // padding keeps the signed text right-aligned ("  -42").
    if value < 0 and pad_code == 48 {
        return Option::Some("-" + pad_text + str.substring(text, 1, length))
    }
    return Option::Some(pad_text + text)
}

// Decimal text of `value` with `separator` every three digits; the sign is
// preserved and an empty separator returns the plain number.
public func thousands(value: int, separator: string) returns string {
    let text = convert.int_to_string(value)
    let negative = value < 0
    let digits = if negative { str.substring(text, 1, str.len(text)) } else { text }
    if str.len(separator) == 0 {
        return text
    }

    let builder = str.builder_new(0)
    if negative {
        str.builder_push(builder, "-")
    }

    let length = str.len(digits)
    let index = 0
    while index < length {
        if index > 0 and (length - index) % 3 == 0 {
            str.builder_push(builder, separator)
        }
        str.builder_push(builder, str.substring(digits, index, index + 1))
        index = index + 1
    }

    return str.builder_finish(builder)
}

// Fixed-point text with `decimals` digits after the point. Rounding is
// half-away-from-zero after scaling; `None` for `decimals` outside `0..=12` or
// when the scaled value cannot be represented in i64.
public func float_fixed(value: float, decimals: int) returns Option<string> {
    if decimals < 0 or decimals > 12 {
        return Option::None
    }
    if math.is_nan_f(value) {
        return Option::None
    }
    if math.is_infinite_f(value) {
        return Option::None
    }

    let scale = 1
    let step = 0
    while step < decimals {
        scale = scale * 10
        step = step + 1
    }

    let scaled = value * (scale as float)
    if scaled >= 9223372036854775807.0 or scaled <= -9223372036854775807.0 {
        return Option::None
    }

    // Compare the discarded fraction against the tie instead of adding 0.5:
    // adding rounds at the IEEE boundary (0.49999999999999994 + 0.5 == 1.0)
    // and would round ties the wrong way for inputs one ulp below the tie.
    let truncated = scaled as int
    let fraction = scaled - (truncated as float)
    let rounded = truncated
    if fraction >= 0.5 {
        rounded = truncated + 1
    } else if fraction <= -0.5 {
        rounded = truncated - 1
    }
    let negative = rounded < 0
    let magnitude = if negative { 0 - rounded } else { rounded }

    let integer_part = convert.int_to_string(magnitude / scale)
    let fraction_part = zero_padded(magnitude % scale, decimals)

    let sign = ""
    if negative and magnitude != 0 {
        sign = "-"
    }

    if decimals == 0 {
        return Option::Some(sign + integer_part)
    }
    return Option::Some(sign + integer_part + "." + fraction_part)
}

// Human-readable byte size in SI units (base 1000) with one decimal above
// bytes, e.g. `1.5 KB`. Negative values keep their sign.
public func bytes_si(count: int) returns string {
    // i64::MIN has no representable magnitude, so it keeps its plain text.
    if count == -9223372036854775808 {
        return "-9223372036854775808 B"
    }

    let negative = count < 0
    let magnitude = if negative { 0 - count } else { count }
    let sign = if negative { "-" } else { "" }

    if magnitude < 1000 {
        return sign + convert.int_to_string(magnitude) + " B"
    }

    let units: [string] = ["KB", "MB", "GB", "TB", "PB", "EB"]
    let scaled = magnitude
    let unit = 0
    let remainder = 0

    // Scale down until the value fits in a single unit, remembering the first
    // decimal of the division for rounding.
    while scaled >= 1000 and unit < 6 {
        remainder = scaled % 1000
        scaled = scaled / 1000
        unit = unit + 1
    }

    let tenths = (remainder * 10 + 500) / 1000
    if tenths >= 10 {
        scaled = scaled + 1
        tenths = 0
    }

    let unit_name = units[unit - 1]
    if scaled >= 1000 {
        return sign + convert.int_to_string(scaled) + " " + unit_name
    }
    return sign + convert.int_to_string(scaled) + "." + convert.int_to_string(tenths) + " " + unit_name
}

// ── Helpers ──────────────────────────────────────────────────────────────

func zero_padded(value: int, width: int) returns string {
    if width <= 0 {
        return ""
    }
    let text = convert.int_to_string(value)
    if str.len(text) >= width {
        return text
    }
    return str.repeat_str("0", width - str.len(text)) + text
}
