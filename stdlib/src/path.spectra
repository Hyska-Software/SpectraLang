module std.path

import std.collections as collections
import std.option as option
import std.string as str

// Path helpers for POSIX-style and Windows-style inputs. Both `/` and `\` are
// treated as separators; results always use `/` as the canonical separator.
// Drive letters (`C:`) are recognized for `is_absolute`, `normalize` and
// `join`; UNC prefixes (`\\server\share`) are not resolved beyond their
// separators.

// Joins two path fragments. An absolute `right` replaces `left`; separators are
// inserted only when needed.
public func join(left: string, right: string) returns string {
    if str.len(right) == 0 {
        return left
    }
    if str.len(left) == 0 or is_absolute(right) {
        return canonical(right)
    }
    if is_separator(str.char_at(left, str.len(left) - 1)) {
        return canonical(left + right)
    }
    return canonical(left + "/" + right)
}

// Canonical form of `path`: separators collapsed to `/`, `.` removed, `..`
// resolved without escaping the root, trailing separators dropped (except for
// the root itself).
public func normalize(path: string) returns string {
    let length = str.len(path)
    let drive = ""
    let start = 0
    let absolute = false

    if length >= 2 and is_alpha(str.char_at(path, 0)) and str.char_at(path, 1) == 58 {
        drive = str.substring(path, 0, 2)
        start = 2
        if length > 2 and is_separator(str.char_at(path, 2)) {
            absolute = true
            start = 3
        }
    } else if length > 0 and is_separator(str.char_at(path, 0)) {
        absolute = true
        start = 1
    }

    let segments = collect_segments(path, start, absolute)

    let builder = str.builder_new(0)
    if str.len(drive) > 0 {
        str.builder_push(builder, drive)
    }
    if absolute {
        str.builder_push(builder, "/")
    }

    let count = collections.list_len(segments)
    let position = 0
    while position < count {
        if position > 0 {
            str.builder_push(builder, "/")
        }
        str.builder_push(
            builder,
            option.option_unwrap_or(collections.list_get(segments, position), ""),
        )
        position = position + 1
    }

    let result = str.builder_finish(builder)
    if str.len(result) == 0 {
        if absolute {
            return "/"
        }
        return "."
    }
    return result
}

// Final component of `path` after trailing separators are removed; empty for
// a root or an empty path (`file_name("a/b/")` is `b`).
public func file_name(path: string) returns string {
    let trimmed = without_trailing_separators(path)
    let length = str.len(trimmed)
    if length == 0 {
        return ""
    }

    let index = length - 1
    while index >= 0 {
        if is_separator(str.char_at(trimmed, index)) {
            return str.substring(trimmed, index + 1, length)
        }
        index = index - 1
    }

    return trimmed
}

// Directory containing `path`, or None when there is no parent component.
public func parent(path: string) returns Option<string> {
    let trimmed = without_trailing_separators(path)
    let length = str.len(trimmed)
    if length == 0 {
        return Option::None
    }

    let index = length - 1
    while index >= 0 {
        if is_separator(str.char_at(trimmed, index)) {
            let head = canonical(without_trailing_separators(str.substring(trimmed, 0, index)))
            if str.len(head) == 0 {
                if is_absolute(trimmed) {
                    return Option::Some("/")
                }
                return Option::None
            }
            // `C:` keeps its drive separator semantics (`C:/`).
            if str.len(head) == 2 and is_alpha(str.char_at(head, 0)) and str.char_at(head, 1) == 58 {
                return Option::Some(head + "/")
            }
            return Option::Some(head)
        }
        index = index - 1
    }

    return Option::None
}

// Extension of the final component without the dot, or None when absent.
// `a.tar.gz` yields `gz`.
public func extension(path: string) returns Option<string> {
    let name = file_name(path)
    let length = str.len(name)
    if length == 0 {
        return Option::None
    }

    let index = length - 1
    while index > 0 {
        if str.char_at(name, index) == 46 {
            if index == length - 1 {
                return Option::None
            }
            return Option::Some(str.substring(name, index + 1, length))
        }
        index = index - 1
    }

    return Option::None
}

// Final component without its extension.
public func stem(path: string) returns string {
    let name = file_name(path)
    let dot = dot_index(name)
    if dot <= 0 {
        return name
    }
    return str.substring(name, 0, dot)
}

// True for `/x`, `\x`, `C:/x` and `C:\x`. Drive-relative forms (`C:x`) and UNC
// prefixes are not absolute for this contract.
public func is_absolute(path: string) returns bool {
    let length = str.len(path)
    if length == 0 {
        return false
    }
    if is_separator(str.char_at(path, 0)) {
        return true
    }
    if length >= 3 and is_alpha(str.char_at(path, 0)) and str.char_at(path, 1) == 58 {
        return is_separator(str.char_at(path, 2))
    }
    return false
}

// ── Helpers ──────────────────────────────────────────────────────────────

// Rewrites `\` separators as the canonical `/`.
func canonical(path: string) returns string {
    let builder = str.builder_new(0)
    let length = str.len(path)
    let index = 0

    while index < length {
        let code = str.char_at(path, index)
        if code == 92 {
            push_code(builder, 47)
            index = index + 1
        } else if code < 128 {
            push_code(builder, code)
            index = index + 1
        } else {
            // Copy the whole rune so multi-byte text keeps its exact bytes.
            let step = rune_step(code)
            str.builder_push(builder, str.substring(path, index, index + step))
            index = index + step
        }
    }

    return str.builder_finish(builder)
}

// Byte length of the UTF-8 rune whose lead byte is `code` (`1`/`2`/`3`/`4`).
// Advancing the cursor by this step keeps rune preservation a single forward
// pass instead of a `byte_offset` rescan per rune.
func rune_step(code: int) returns int {
    if code < 128 {
        return 1
    }
    if code < 224 {
        return 2
    }
    if code < 240 {
        return 3
    }
    return 4
}

func push_code(builder: int, code: int) {
    let piece = option.option_unwrap_or(str.from_scalar(code), "")
    if str.len(piece) > 0 {
        str.builder_push(builder, piece)
    }
}

// Splits `path` into normalized segments, resolving `.` and `..`. `..` never
// escapes the root; relative paths keep leading `..` segments.
func collect_segments(path: string, start: int, absolute: bool) returns List<string> {
    let segments: List<string> = collections.list_new()
    let length = str.len(path)
    let index = start

    while index < length {
        if is_separator(str.char_at(path, index)) {
            index = index + 1
        } else {
            let segment_start = index
            while index < length and not is_separator(str.char_at(path, index)) {
                index = index + 1
            }
            append_segment(segments, str.substring(path, segment_start, index), absolute)
        }
    }

    return segments
}

// Applies one raw segment to `segments`.
func append_segment(segments: List<string>, segment: string, absolute: bool) {
    if segment == "." {
        return
    }
    if segment != ".." {
        collections.list_push(segments, segment)
        return
    }
    if collections.list_len(segments) == 0 {
        if not absolute {
            collections.list_push(segments, "..")
        }
        return
    }

    let last = option.option_unwrap_or(
        collections.list_get(segments, collections.list_len(segments) - 1),
        "",
    )
    if last == ".." {
        if not absolute {
            collections.list_push(segments, "..")
        }
        return
    }

    // The removed segment is intentionally discarded.
    let removed = option.option_unwrap_or(collections.list_pop(segments), "")
}

func is_separator(code: int) returns bool {
    return code == 47 or code == 92
}

func is_alpha(code: int) returns bool {
    if code >= 65 and code <= 90 {
        return true
    }
    return code >= 97 and code <= 122
}

func without_trailing_separators(path: string) returns string {
    let length = str.len(path)
    while length > 0 and is_separator(str.char_at(path, length - 1)) {
        length = length - 1
    }
    return str.substring(path, 0, length)
}

// Index of the extension dot in a final component, or -1.
func dot_index(name: string) returns int {
    let length = str.len(name)
    let index = length - 1
    while index > 0 {
        if str.char_at(name, index) == 46 {
            if index == length - 1 {
                return -1
            }
            return index
        }
        index = index - 1
    }
    return -1
}


// ── Component manipulation ───────────────────────────────────────────────

// Replaces (or adds) the extension of the final component. An empty `ext`
// removes the existing extension. Results use the canonical `/` separator.
public func with_extension(path: string, ext: string) returns string {
    let trimmed = without_trailing_separators(path)
    let name = file_name(path)
    if str.len(name) == 0 {
        return canonical(path)
    }

    let base = stem(path)
    // `file_name` drops trailing separators, so the prefix must come from the
    // same trimmed representation (`a/b.txt/` + `md` -> `a/b.md`).
    let prefix = str.substring(trimmed, 0, str.len(trimmed) - str.len(name))
    if str.len(ext) == 0 {
        return canonical(prefix + base)
    }
    return canonical(prefix + base + "." + ext)
}

// Normalized components without `.` or `..` entries.
public func components(path: string) returns List<string> {
    return collect_segments(path, 0, is_absolute(path))
}

// True when `path` is not absolute (`is_absolute` is the inverse).
public func is_relative(path: string) returns bool {
    return not is_absolute(path)
}

// Matches `text` against a glob pattern with `*` (any run), `?` (one byte),
// `[abc]` and `[!abc]` classes. Byte-oriented: use ASCII patterns and text.
public func glob_match(pattern: string, text: string) returns bool {
    return glob_at(pattern, 0, text, 0)
}

// Strips control characters and the characters that are illegal in file names
// (`< > : " / \ | ? *`), collapses whitespace runs into one space and trims.
public func sanitize(name: string) returns string {
    let builder = str.builder_new(0)
    let length = str.len(name)
    let index = 0
    let pending_space = false

    while index < length {
        let code = str.char_at(name, index)
        if code >= 128 {
            // Copy the whole rune so non-ASCII names keep their exact bytes;
            // feeding the raw byte to `push_code` would re-encode it as a
            // scalar value ("café" -> "cafÃ©").
            if pending_space {
                push_code(builder, 32)
                pending_space = false
            }
            let step = rune_step(code)
            str.builder_push(builder, str.substring(name, index, index + step))
            index = index + step
        } else if is_forbidden_name_byte(code) {
            index = index + 1
        } else if code == 32 {
            if str.builder_len(builder) > 0 {
                pending_space = true
            }
            index = index + 1
        } else {
            if pending_space {
                push_code(builder, 32)
                pending_space = false
            }
            push_code(builder, code)
            index = index + 1
        }
    }

    return str.builder_finish(builder)
}

// `path` relative to `base`, or None when `base` is not a component prefix.
public func relative_to(path: string, base: string) returns Option<string> {
    let path_parts = components(path)
    let base_parts = components(base)
    let base_count = collections.list_len(base_parts)
    if base_count > collections.list_len(path_parts) {
        return Option::None
    }

    let index = 0
    while index < base_count {
        let left = option.option_unwrap_or(collections.list_get(path_parts, index), "")
        let right = option.option_unwrap_or(collections.list_get(base_parts, index), "")
        if left != right {
            return Option::None
        }
        index = index + 1
    }

    let count = collections.list_len(path_parts)
    if index == count {
        return Option::Some(".")
    }

    let builder = str.builder_new(0)
    while index < count {
        if str.builder_len(builder) > 0 {
            str.builder_push(builder, "/")
        }
        str.builder_push(builder, option.option_unwrap_or(collections.list_get(path_parts, index), ""))
        index = index + 1
    }
    return Option::Some(str.builder_finish(builder))
}

// ── Glob helpers ─────────────────────────────────────────────────────────

// Recursive matcher: `*` retries every remaining position (backtracking).
func glob_at(pattern: string, pattern_index: int, text: string, text_index: int) returns bool {
    let pattern_length = str.len(pattern)
    let text_length = str.len(text)

    if pattern_index >= pattern_length {
        return text_index >= text_length
    }

    let code = str.char_at(pattern, pattern_index)
    if code == 42 {
        let next = text_index
        while next <= text_length {
            if glob_at(pattern, pattern_index + 1, text, next) {
                return true
            }
            next = next + 1
        }
        return false
    }

    if text_index >= text_length {
        return false
    }

    if code == 63 {
        return glob_at(pattern, pattern_index + 1, text, text_index + 1)
    }
    if code == 91 {
        let resume = class_match(pattern, pattern_index, str.char_at(text, text_index))
        if resume < 0 {
            return false
        }
        if resume == pattern_index + 1 {
            // Unterminated class: the `[` matches literally, so the text byte
            // must itself be a `[`.
            if str.char_at(text, text_index) != 91 {
                return false
            }
        }
        return glob_at(pattern, resume, text, text_index + 1)
    }
    if code != str.char_at(text, text_index) {
        return false
    }
    return glob_at(pattern, pattern_index + 1, text, text_index + 1)
}

// Parses one `[...]` class starting at `start`. Returns the index after the
// class when `code` matches, -1 when it does not, and `start + 1` when the
// class is unterminated (the `[` then matches literally).
func class_match(pattern: string, start: int, code: int) returns int {
    let length = str.len(pattern)
    let index = start + 1
    let negated = false
    if index < length and str.char_at(pattern, index) == 33 {
        negated = true
        index = index + 1
    }

    let allowed = false
    while index < length {
        let candidate = str.char_at(pattern, index)
        if candidate == 93 {
            if negated {
                if allowed {
                    return -1
                }
                return index + 1
            }
            if allowed {
                return index + 1
            }
            return -1
        }
        if candidate == code {
            allowed = true
        }
        index = index + 1
    }

    return start + 1
}

func is_forbidden_name_byte(code: int) returns bool {
    if code < 32 {
        return true
    }
    if code == 60 or code == 62 or code == 58 or code == 34 {
        return true
    }
    if code == 47 or code == 92 or code == 124 or code == 63 or code == 42 {
        return true
    }
    return false
}
