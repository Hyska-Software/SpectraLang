module std.encoding

import std.bytes as bytes
import std.collections as collections
import std.option as option
import std.string as str

// ── Hexadecimal ──────────────────────────────────────────────────────────

// Lowercase hexadecimal text for the UTF-8 bytes of `value`.
public func hex_encode(value: string) returns string {
    let builder = str.builder_new(0)
    let length = str.len(value)
    let index = 0

    while index < length {
        let byte = str.char_at(value, index)
        let piece = str.from_scalar(hex_char(byte / 16))
        if option.is_some(piece) {
            str.builder_push(builder, option.option_unwrap_or(piece, ""))
        }
        let low = str.from_scalar(hex_char(byte % 16))
        if option.is_some(low) {
            str.builder_push(builder, option.option_unwrap_or(low, ""))
        }
        index = index + 1
    }

    return str.builder_finish(builder)
}

// Decodes hexadecimal text into its text value. Odd length, invalid digits and
// byte sequences that are not valid UTF-8 return None.
public func hex_decode(text: string) returns Option<string> {
    let length = str.len(text)
    if length % 2 != 0 {
        return Option::None
    }

    let data: List<int> = collections.list_new()
    let index = 0
    while index < length {
        let high = hex_value(str.char_at(text, index))
        let low = hex_value(str.char_at(text, index + 1))
        if high < 0 or low < 0 {
            return Option::None
        }
        collections.list_push(data, high * 16 + low)
        index = index + 2
    }

    return bytes.from_bytes(data)
}

func hex_char(value: int) returns int {
    if value < 10 {
        return 48 + value
    }
    return 87 + value
}

// Uppercase hexadecimal digit, as required by percent-encoding conventions.
func hex_upper_char(value: int) returns int {
    if value < 10 {
        return 48 + value
    }
    return 55 + value
}

func hex_value(code: int) returns int {
    if code >= 48 and code <= 57 {
        return code - 48
    }
    if code >= 97 and code <= 102 {
        return code - 87
    }
    if code >= 65 and code <= 70 {
        return code - 55
    }
    return -1
}

// ── Base64 (RFC 4648) ────────────────────────────────────────────────────

// Standard base64 text with `=` padding.
public func base64_encode(value: string) returns string {
    let length = str.len(value)
    let builder = str.builder_new(0)
    let index = 0

    while index < length {
        let remaining = length - index
        let first = str.char_at(value, index)
        let second = if remaining > 1 { str.char_at(value, index + 1) } else { 0 }
        let third = if remaining > 2 { str.char_at(value, index + 2) } else { 0 }

        push_char(builder, base64_char(first >> 2))
        push_char(builder, base64_char(((first & 3) << 4) | (second >> 4)))
        if remaining > 1 {
            push_char(builder, base64_char(((second & 15) << 2) | (third >> 6)))
        } else {
            push_char(builder, 61)
        }
        if remaining > 2 {
            push_char(builder, base64_char(third & 63))
        } else {
            push_char(builder, 61)
        }

        index = index + 3
    }

    return str.builder_finish(builder)
}

// Decodes standard base64 text. Invalid characters, bad padding, wrong length
// and decoded bytes that are not valid UTF-8 return None.
public func base64_decode(text: string) returns Option<string> {
    let length = str.len(text)
    if length == 0 {
        return Option::Some("")
    }
    if length % 4 != 0 {
        return Option::None
    }

    let data: List<int> = collections.list_new()
    let index = 0
    while index < length {
        let first = base64_value(str.char_at(text, index))
        let second = base64_value(str.char_at(text, index + 1))
        let third_code = str.char_at(text, index + 2)
        let fourth_code = str.char_at(text, index + 3)
        let third = base64_value(third_code)
        let fourth = base64_value(fourth_code)

        if first < 0 or second < 0 {
            return Option::None
        }

        let is_last = index + 4 == length
        if third < 0 and third_code != 61 {
            return Option::None
        }
        if fourth < 0 and fourth_code != 61 {
            return Option::None
        }
        if third_code == 61 and fourth_code != 61 {
            return Option::None
        }
        if (third_code == 61 or fourth_code == 61) and not is_last {
            return Option::None
        }

        collections.list_push(data, (first << 2) | (second >> 4))
        if third_code != 61 {
            collections.list_push(data, ((second & 15) << 4) | (third >> 2))
        }
        if fourth_code != 61 {
            collections.list_push(data, ((third & 3) << 6) | fourth)
        }

        index = index + 4
    }

    return bytes.from_bytes(data)
}

func base64_char(value: int) returns int {
    if value < 26 {
        return 65 + value
    }
    if value < 52 {
        return 97 + value - 26
    }
    if value < 62 {
        return 48 + value - 52
    }
    if value == 62 {
        return 43
    }
    return 47
}

func base64_value(code: int) returns int {
    if code >= 65 and code <= 90 {
        return code - 65
    }
    if code >= 97 and code <= 122 {
        return code - 71
    }
    if code >= 48 and code <= 57 {
        return code + 4
    }
    if code == 43 {
        return 62
    }
    if code == 47 {
        return 63
    }
    return -1
}

// ── Percent encoding ─────────────────────────────────────────────────────

// Percent-encodes every byte except the unreserved set `A-Za-z0-9-._~`.
public func percent_encode(value: string) returns string {
    let builder = str.builder_new(0)
    let length = str.len(value)
    let index = 0

    while index < length {
        let byte = str.char_at(value, index)
        if is_unreserved(byte) {
            push_char(builder, byte)
        } else {
            push_char(builder, 37)
            push_char(builder, hex_upper_char(byte / 16))
            push_char(builder, hex_upper_char(byte % 16))
        }
        index = index + 1
    }

    return str.builder_finish(builder)
}

// Decodes percent-encoded text. `+` is preserved (form encoding is handled by
// `std.api.query`). Invalid escapes and non-UTF-8 results return None.
public func percent_decode(text: string) returns Option<string> {
    let length = str.len(text)
    let data: List<int> = collections.list_new()
    let index = 0

    while index < length {
        let code = str.char_at(text, index)
        if code == 37 {
            if index + 2 >= length {
                return Option::None
            }
            let high = hex_value(str.char_at(text, index + 1))
            let low = hex_value(str.char_at(text, index + 2))
            if high < 0 or low < 0 {
                return Option::None
            }
            collections.list_push(data, high * 16 + low)
            index = index + 3
        } else {
            collections.list_push(data, code)
            index = index + 1
        }
    }

    return bytes.from_bytes(data)
}

func is_unreserved(byte: int) returns bool {
    if byte >= 65 and byte <= 90 {
        return true
    }
    if byte >= 97 and byte <= 122 {
        return true
    }
    if byte >= 48 and byte <= 57 {
        return true
    }
    return byte == 45 or byte == 46 or byte == 95 or byte == 126
}

// ── ROT13 ────────────────────────────────────────────────────────────────

// ROT13 over ASCII letters; every other scalar value is copied unchanged, so
// non-ASCII text keeps its exact UTF-8 bytes. The transformation is its own
// inverse.
public func rot13(value: string) returns string {
    let builder = str.builder_new(0)
    let bytes = str.len(value)
    let offset = 0

    while offset < bytes {
        let first = str.char_at(value, offset)
        if first < 128 {
            if first >= 65 and first <= 90 {
                push_char(builder, 65 + (first - 65 + 13) % 26)
            } else if first >= 97 and first <= 122 {
                push_char(builder, 97 + (first - 97 + 13) % 26)
            } else {
                push_char(builder, first)
            }
            offset = offset + 1
        } else if first < 224 {
            push_char(
                builder,
                (first - 192) * 64 + (str.char_at(value, offset + 1) - 128),
            )
            offset = offset + 2
        } else if first < 240 {
            push_char(
                builder,
                (first - 224) * 4096 +
                (str.char_at(value, offset + 1) - 128) * 64 +
                (str.char_at(value, offset + 2) - 128),
            )
            offset = offset + 3
        } else {
            push_char(
                builder,
                (first - 240) * 262144 +
                (str.char_at(value, offset + 1) - 128) * 4096 +
                (str.char_at(value, offset + 2) - 128) * 64 +
                (str.char_at(value, offset + 3) - 128),
            )
            offset = offset + 4
        }
    }

    return str.builder_finish(builder)
}

// ── Shared helpers ───────────────────────────────────────────────────────

func push_char(builder: int, code: int) {
    let piece = str.from_scalar(code)
    if option.is_some(piece) {
        str.builder_push(builder, option.option_unwrap_or(piece, ""))
    }
}

// ── Base32 (RFC 4648) ────────────────────────────────────────────────────

// Base32 text over the RFC 4648 uppercase alphabet `A-Z2-7` with `=`
// padding. Unused low bits of a partial group are zero and no line breaks are
// inserted.
public func base32_encode(value: string) returns string {
    let length = str.len(value)
    let builder = str.builder_new(0)
    let index = 0

    while index < length {
        let remaining = length - index
        let first = str.char_at(value, index)
        let second = if remaining > 1 { str.char_at(value, index + 1) } else { 0 }
        let third = if remaining > 2 { str.char_at(value, index + 2) } else { 0 }
        let fourth = if remaining > 3 { str.char_at(value, index + 3) } else { 0 }
        let fifth = if remaining > 4 { str.char_at(value, index + 4) } else { 0 }

        // Emitted characters for 5, 4, 3, 2 and 1 source bytes.
        let chunk = 2
        if remaining >= 5 {
            chunk = 8
        } else if remaining == 4 {
            chunk = 7
        } else if remaining == 3 {
            chunk = 5
        } else if remaining == 2 {
            chunk = 4
        }

        push_char(builder, base32_char(first >> 3))
        push_char(builder, base32_char(((first & 7) << 2) | (second >> 6)))
        if chunk > 2 {
            push_char(builder, base32_char((second >> 1) & 31))
        }
        if chunk > 3 {
            push_char(builder, base32_char(((second & 1) << 4) | (third >> 4)))
        }
        if chunk > 4 {
            push_char(builder, base32_char(((third & 15) << 1) | (fourth >> 7)))
        }
        if chunk > 5 {
            push_char(builder, base32_char((fourth >> 2) & 31))
        }
        if chunk > 6 {
            push_char(builder, base32_char(((fourth & 3) << 3) | (fifth >> 5)))
        }
        if chunk > 7 {
            push_char(builder, base32_char(fifth & 31))
        }

        let pad = 8 - chunk
        let placed = 0
        while placed < pad {
            push_char(builder, 61)
            placed = placed + 1
        }

        index = index + 5
    }

    return str.builder_finish(builder)
}

// Decodes base32 text. Unknown characters, lowercase letters, misplaced or
// wrong-count padding, lengths that are not a multiple of eight and decoded
// bytes that are not valid UTF-8 return None.
public func base32_decode(text: string) returns Option<string> {
    let length = str.len(text)
    if length == 0 {
        return Option::Some("")
    }
    if length % 8 != 0 {
        return Option::None
    }

    let data: List<int> = collections.list_new()
    let index = 0

    while index < length {
        // Padding is a contiguous run of `=` at the end of the block.
        let pad = 0
        let scan = 7
        let scanning = true
        while scanning and scan >= 0 {
            if str.char_at(text, index + scan) == 61 {
                pad = pad + 1
                scan = scan - 1
            } else {
                scanning = false
            }
        }

        // Only 0, 1, 3, 4 or 6 pad characters describe a valid group.
        if pad != 0 and pad != 1 and pad != 3 and pad != 4 and pad != 6 {
            return Option::None
        }
        if pad > 0 and index + 8 != length {
            return Option::None
        }

        let chunk = 8 - pad
        let valid = true
        let probe = 0
        while probe < 8 {
            let code = str.char_at(text, index + probe)
            if probe < chunk {
                if base32_value(code) < 0 {
                    valid = false
                }
            } else if code != 61 {
                valid = false
            }
            probe = probe + 1
        }
        if not valid {
            return Option::None
        }

        let v0 = base32_value(str.char_at(text, index))
        let v1 = base32_value(str.char_at(text, index + 1))
        let v2 = base32_value(str.char_at(text, index + 2))
        let v3 = base32_value(str.char_at(text, index + 3))
        let v4 = base32_value(str.char_at(text, index + 4))
        let v5 = base32_value(str.char_at(text, index + 5))
        let v6 = base32_value(str.char_at(text, index + 6))
        let v7 = base32_value(str.char_at(text, index + 7))

        collections.list_push(data, (v0 << 3) | (v1 >> 2))
        if chunk > 2 {
            collections.list_push(data, ((v1 & 3) << 6) | (v2 << 1) | (v3 >> 4))
        }
        if chunk > 4 {
            collections.list_push(data, ((v3 & 15) << 4) | (v4 >> 1))
        }
        if chunk > 5 {
            collections.list_push(data, ((v4 & 1) << 7) | (v5 << 2) | (v6 >> 3))
        }
        if chunk > 7 {
            collections.list_push(data, ((v6 & 7) << 5) | v7)
        }

        index = index + 8
    }

    return bytes.from_bytes(data)
}

func base32_char(value: int) returns int {
    if value < 26 {
        return 65 + value
    }
    return 50 + value - 26
}

func base32_value(code: int) returns int {
    if code >= 65 and code <= 90 {
        return code - 65
    }
    if code >= 50 and code <= 55 {
        return code - 24
    }
    return -1
}

// ── Base58 (Bitcoin alphabet) ────────────────────────────────────────────

// Base58 text over the Bitcoin alphabet
// `123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz`, without
// padding. Each leading zero byte becomes a leading `1`. The customary
// big-integer base-256 <-> base-58 conversion uses only `*`, `/` and `%`.
public func base58_encode(value: string) returns string {
    let length = str.len(value)
    if length == 0 {
        return ""
    }

    let leading = 0
    while leading < length and str.char_at(value, leading) == 0 {
        leading = leading + 1
    }

    let work: List<int> = collections.list_new()
    let index = leading
    while index < length {
        collections.list_push(work, str.char_at(value, index))
        index = index + 1
    }

    // Repeated long division of the big-endian byte string by 58 yields the
    // base-58 digits least significant first.
    let digits: List<int> = collections.list_new()
    while collections.list_len(work) > 0 {
        let quotient: List<int> = collections.list_new()
        let remainder = 0
        let cursor = 0
        while cursor < collections.list_len(work) {
            let current = option.option_unwrap_or(collections.list_get(work, cursor), 0)
            let scaled = remainder * 256 + current
            let digit = scaled / 58
            remainder = scaled % 58
            if collections.list_len(quotient) > 0 or digit != 0 {
                collections.list_push(quotient, digit)
            }
            cursor = cursor + 1
        }
        collections.list_push(digits, remainder)
        collections.list_clear(work)
        let copy = 0
        while copy < collections.list_len(quotient) {
            collections.list_push(work, option.option_unwrap_or(collections.list_get(quotient, copy), 0))
            copy = copy + 1
        }
    }

    let builder = str.builder_new(0)
    let zeros = 0
    while zeros < leading {
        push_char(builder, 49)
        zeros = zeros + 1
    }

    let at = collections.list_len(digits)
    while at > 0 {
        at = at - 1
        let digit = option.option_unwrap_or(collections.list_get(digits, at), 0)
        push_char(builder, base58_char(digit))
    }

    return str.builder_finish(builder)
}

// Decodes base58 text. Characters outside the alphabet (including the
// ambiguous `0`, `O`, `I` and `l`) and decoded bytes that are not valid UTF-8
// return None.
public func base58_decode(text: string) returns Option<string> {
    let length = str.len(text)
    if length == 0 {
        return Option::Some("")
    }

    let probe = 0
    while probe < length {
        if base58_value(str.char_at(text, probe)) < 0 {
            return Option::None
        }
        probe = probe + 1
    }

    let leading = 0
    while leading < length and str.char_at(text, leading) == 49 {
        leading = leading + 1
    }

    // Accumulate the numeric value as little-endian base-256 bytes.
    let work: List<int> = collections.list_new()
    let index = leading
    while index < length {
        let carry = base58_value(str.char_at(text, index))
        let cursor = 0
        while cursor < collections.list_len(work) {
            let current = option.option_unwrap_or(collections.list_get(work, cursor), 0)
            let scaled = current * 58 + carry
            collections.list_set(work, cursor, scaled % 256)
            carry = scaled / 256
            cursor = cursor + 1
        }
        while carry > 0 {
            collections.list_push(work, carry % 256)
            carry = carry / 256
        }
        index = index + 1
    }

    let data: List<int> = collections.list_new()
    let zeros = 0
    while zeros < leading {
        collections.list_push(data, 0)
        zeros = zeros + 1
    }
    let at = collections.list_len(work)
    while at > 0 {
        at = at - 1
        collections.list_push(data, option.option_unwrap_or(collections.list_get(work, at), 0))
    }

    return bytes.from_bytes(data)
}

func base58_char(value: int) returns int {
    let alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    return str.char_at(alphabet, value)
}

func base58_value(code: int) returns int {
    let alphabet = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
    let limit = str.len(alphabet)
    let index = 0
    while index < limit {
        if str.char_at(alphabet, index) == code {
            return index
        }
        index = index + 1
    }
    return -1
}

// ── Base85 (Ascii85) ─────────────────────────────────────────────────────

// Ascii85 text without `<~ ~>` delimiters. Four source bytes become five
// characters in `!`..`u`; a trailing partial group emits one character per
// source byte plus one. The `z` abbreviation is not used, so an all-zero
// group is written out in full.
public func base85_encode(value: string) returns string {
    let length = str.len(value)
    let builder = str.builder_new(0)
    let index = 0

    while index < length {
        let remaining = length - index
        let first = str.char_at(value, index)
        let second = if remaining > 1 { str.char_at(value, index + 1) } else { 0 }
        let third = if remaining > 2 { str.char_at(value, index + 2) } else { 0 }
        let fourth = if remaining > 3 { str.char_at(value, index + 3) } else { 0 }

        let group = (first << 24) | (second << 16) | (third << 8) | fourth
        let chips: List<int> = collections.list_new()
        let work = group
        let step = 0
        while step < 5 {
            collections.list_push(chips, work % 85)
            work = work / 85
            step = step + 1
        }

        // 4 bytes -> 5 chars, 3 -> 4, 2 -> 3, 1 -> 2. A partial group keeps the
        // *most significant* `chunk` chips of the zero-padded 4-byte value.
        let chunk = if remaining > 3 { 5 } else { remaining + 1 }
        let at = 5
        let emitted = 0
        while emitted < chunk {
            at = at - 1
            let chip = option.option_unwrap_or(collections.list_get(chips, at), 0)
            push_char(builder, 33 + chip)
            emitted = emitted + 1
        }

        index = index + 4
    }

    return str.builder_finish(builder)
}

// Decodes Ascii85 text. Characters outside `!`..`u` (including the unused `z`
// abbreviation), a trailing group of a single character, groups whose value
// overflows 32 bits and decoded bytes that are not valid UTF-8 return None.
public func base85_decode(text: string) returns Option<string> {
    let length = str.len(text)
    if length == 0 {
        return Option::Some("")
    }

    let probe = 0
    while probe < length {
        let code = str.char_at(text, probe)
        if code < 33 or code > 117 {
            return Option::None
        }
        probe = probe + 1
    }
    if length % 5 == 1 {
        return Option::None
    }

    let data: List<int> = collections.list_new()
    let index = 0

    while index < length {
        let remaining = length - index
        let chunk = if remaining >= 5 { 5 } else { remaining }

        let value = 0
        let step = 0
        while step < 5 {
            let chip = if step < chunk { str.char_at(text, index + step) - 33 } else { 84 }
            value = value * 85 + chip
            step = step + 1
        }
        if value > 4294967295 {
            return Option::None
        }

        let produced = chunk - 1
        let shift = (5 - chunk) * 8
        let at = 0
        while at < produced {
            let offset = shift + (produced - 1 - at) * 8
            collections.list_push(data, (value >> offset) & 255)
            at = at + 1
        }

        index = index + chunk
    }

    return bytes.from_bytes(data)
}
