// Phase 31: async-echo (Spectra)
// Contract: fanout_fanin_real_concurrency.v2.
// Spawn 10 runtime tasks before joining any of them. Repeated iters=10000
// times. Total: 100_000 tasks, with observable fan-out/fan-in.

module bench_async_echo

import std.concurrent as concurrent

public func main() returns int {
    let iters = 10000
    let total = 0
    let i     = 0
    while i < iters {
        concurrent.reset()
        // Batch handle owns all ten task handles. Runtime schedules every task
        // before join_batch_sum starts fan-in.
        let batch = concurrent.task_spawn_batch(1, 10)
        let local = concurrent.task_join_batch_sum(batch)
        total = total + local
        i = i + 1
    }
    if total == 550000 {
        return 0
    }
    return 1
}
