// Phase 31: cpu-string-build (Spectra, R-3108 string builder)
// Build a string by pushing parts into a builder and finishing it.
// One concatenation per outer iter, 100 pushes per iter. This closes
// the 50x gap from the str.concat-per-call pattern (R-3108).

module bench_cpu_string_build

import std.string as str

public func main() returns int {
    let iters = 500
    let total = 0
    let k     = 0
    while k < iters {
        let b = str.builder_new(0)
        let i = 0
        while i < 100 {
            str.builder_push(b, "x|")
            i = i + 1
        }
        let s = str.builder_finish(b)
        total = total + str.len(s)
        k = k + 1
    }
    // each iter builds 100 * 2 = 200 bytes; total = 500 * 200 = 100000
    if total == 100000 {
        return 0
    }
    return 1
}
