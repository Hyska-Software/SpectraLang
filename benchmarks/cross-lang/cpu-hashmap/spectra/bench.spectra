// Phase 31: cpu-hashmap (Spectra, R-3123 map_* exposed)
// O(1) hashmap insert + O(1) contains, equivalent to Go map[int]int.
// Workload: 200 inserts + 200 contains + 1 len check + 1 free per iter,
// repeated 300 times. Total expected: 300 * 200 = 60000.

module bench_cpu_hashmap

import std.collections as col

public func main() returns int {
    let n     = 200
    let iters = 300
    let total = 0
    let it    = 0
    while it < iters {
        let m = col.map_new()
        let i = 0
        while i < n {
            col.map_set(m, i * 7, i)
            i = i + 1
        }
        let found = 0
        let k     = 0
        while k < n {
            if col.map_contains(m, k * 7) {
                found = found + 1
            }
            k = k + 1
        }
        if col.map_len(m) != n {
            return 2
        }
        col.map_free(m)
        total = total + found
        it = it + 1
    }
    if total == 60000 {
        return 0
    }
    return 1
}
