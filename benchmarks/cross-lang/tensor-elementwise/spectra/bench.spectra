// Phase 31: tensor-elementwise (Spectra)
// Apply relu on a 100K-element tensor, repeated 50 times (parity with the
// Go/Rust fixtures, which allocate and reduce per iteration).

module bench_tensor_elementwise

import std.tensor as tensor

public func main() returns int {
    let iters = 50
    let i     = 0
    while i < iters {
        let t = tensor.full_f(100000, 0.5)
        let r = tensor.relu(t)
        let v = tensor.get_f(r, 0)
        tensor.free_all()
        if v <= 0.0 {
            return 1
        }
        i = i + 1
    }
    return 0
}
