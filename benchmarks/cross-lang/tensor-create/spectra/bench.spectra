// Phase 31: tensor-create (Spectra)
// Materialize a 1M-element f64 tensor filled with 1.0, repeated 20 times.
// After R-3118: pre-allocate once with full_f, then refill 19 times.

module bench_tensor_create

import std.tensor as tensor

public func main() returns int {
    let iters = 60
    let total = 0
    let t     = tensor.full_f(1048576, 1.0)
    let i     = 0
    while i < iters {
        tensor.refill(t, 1.0)
        total = total + tensor.len(t)
        i = i + 1
    }
    tensor.free(t)
    if total == 62914560 {
        return 0
    }
    return 1
}
