// Phase 31: tensor-matmul (Spectra)
// 64x64 * 64x64 matmul, repeated 20 times (parity with the Go/Rust
// fixtures, which allocate per iteration).

module bench_tensor_matmul

import std.tensor as tensor

public func main() returns int {
    let n     = 64
    let iters = 20
    let i     = 0
    while i < iters {
        let a = tensor.reshape(tensor.full_f(n * n, 0.5), n, n)
        let b = tensor.reshape(tensor.full_f(n * n, 0.25), n, n)
        let c = tensor.matmul(a, b)
        let v = tensor.get_f(c, 0)
        tensor.free_all()
        if v <= 0.0 {
            return 1
        }
        i = i + 1
    }
    return 0
}
