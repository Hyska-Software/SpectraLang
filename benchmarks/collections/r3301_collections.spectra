func bench_map_int(n: int, values: Map<int, int>, construction_ns: int, name: string) returns bool {
    let capacity_before = collections.map_capacity(values)
    let operation_started = time.monotonic_nanos()
    let i = 0
    while i < n {
        collections.map_set(values, i, i)
        i = i + 1
    }
    let checksum = 0
    let index = 0
    while index < n {
        let value = collections.map_get(values, index)
        if option.is_none(value) {
            collections.map_free(values)
            return false
        }
        checksum = checksum + option.option_unwrap(value)
        index = index + 1
    }
    let operation_finished = time.monotonic_nanos()
    let capacity_after = collections.map_capacity(values)
    let passed = collections.map_len(values) == n && checksum == n * (n - 1) / 2
    report(name, construction_ns, operation_finished - operation_started, n * 2, checksum, capacity_before, capacity_after, 0)
    collections.map_free(values)
    return passed
}

func bench_map_int_default(n: int, name: string) returns bool {
    let started = time.monotonic_nanos()
    let values: Map<int, int> = collections.map_new()
    let constructed = time.monotonic_nanos()
    return bench_map_int(n, values, constructed - started, name)
}

func bench_map_int_capacity(n: int, name: string) returns bool {
    let started = time.monotonic_nanos()
    let values: Map<int, int> = collections.map_with_capacity(n)
    let constructed = time.monotonic_nanos()
    return bench_map_int(n, values, constructed - started, name)
}

func bench_map_string(n: int, values: Map<string, int>, key: string, construction_ns: int, name: string, key_length: int) returns bool {
    let capacity_before = collections.map_capacity(values)
    let operation_started = time.monotonic_nanos()
    let i = 0
    let hits = 0
    while i < n {
        collections.map_set(values, key, i)
        if collections.map_contains(values, key) {
            hits = hits + 1
        }
        i = i + 1
    }
    let operation_finished = time.monotonic_nanos()
    let capacity_after = collections.map_capacity(values)
    let final_value = collections.map_get(values, key)
    let passed = collections.map_len(values) == 1 && hits == n &&
        option.is_some(final_value) && option.option_unwrap(final_value) == n - 1
    report(name, construction_ns, operation_finished - operation_started, n * 2, hits, capacity_before, capacity_after, key_length)
    collections.map_free(values)
    return passed
}

func bench_map_string_default(n: int, name: string, key_length: int) returns bool {
    let key = string.repeat_str("s", key_length)
    let started = time.monotonic_nanos()
    let values: Map<string, int> = collections.map_new()
    let constructed = time.monotonic_nanos()
    return bench_map_string(n, values, key, constructed - started, name, key_length)
}

func bench_map_string_capacity(n: int, name: string, key_length: int) returns bool {
    let key = string.repeat_str("s", key_length)
    let started = time.monotonic_nanos()
    let values: Map<string, int> = collections.map_with_capacity(n)
    let constructed = time.monotonic_nanos()
    return bench_map_string(n, values, key, constructed - started, name, key_length)
}

func bench_set_int(n: int, values: Set<int>, construction_ns: int, name: string) returns bool {
    let capacity_before = collections.set_capacity(values)
    let operation_started = time.monotonic_nanos()
    let inserted = 0
    let i = 0
    while i < n {
        if collections.set_insert(values, i) {
            inserted = inserted + 1
        }
        i = i + 1
    }
    let hits = 0
    let index = 0
    while index < n {
        if collections.set_contains(values, index) {
            hits = hits + 1
        }
        index = index + 1
    }
    let operation_finished = time.monotonic_nanos()
    let capacity_after = collections.set_capacity(values)
    let passed = collections.set_len(values) == n && inserted == n && hits == n
    report(name, construction_ns, operation_finished - operation_started, n * 2, hits, capacity_before, capacity_after, 0)
    collections.set_free(values)
    return passed
}

