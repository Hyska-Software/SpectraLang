module r3301_collections

import std.collections as collections
import std.convert as convert
import std.io as io
import std.option as option
import std.string as string
import std.time as time

func report(name: string, construction_ns: int, operation_ns: int, operations: int, checksum: int, capacity_before: int, capacity_after: int, key_length: int) {
    io.println(
        "R3301|" + name + "|" + convert.int_to_string(construction_ns) + "|" +
        convert.int_to_string(operation_ns) + "|" + convert.int_to_string(operations) + "|" +
        convert.int_to_string(checksum) + "|" + convert.int_to_string(capacity_before) + "|" +
        convert.int_to_string(capacity_after) + "|" + convert.int_to_string(key_length)
    )
}

func bench_list(n: int, values: List<int>, construction_ns: int, name: string) returns bool {
    let capacity_before = collections.list_capacity(values)
    let operation_started = time.monotonic_nanos()
    let i = 0
    while i < n {
        collections.list_push(values, i)
        i = i + 1
    }
    let checksum = 0
    let index = 0
    while index < n {
        let value = collections.list_get(values, index)
        if option.is_none(value) {
            collections.list_free(values)
            return false
        }
        checksum = checksum + option.option_unwrap(value)
        index = index + 1
    }
    let operation_finished = time.monotonic_nanos()
    let capacity_after = collections.list_capacity(values)
    if collections.list_len(values) != n {
        collections.list_free(values)
        return false
    }
    report(name, construction_ns, operation_finished - operation_started, n * 2, checksum, capacity_before, capacity_after, 0)
    collections.list_free(values)
    return checksum == n * (n - 1) / 2
}

func bench_list_default(n: int, name: string) returns bool {
    let started = time.monotonic_nanos()
    let values: List<int> = collections.list_new()
    let constructed = time.monotonic_nanos()
    return bench_list(n, values, constructed - started, name)
}

func bench_list_capacity(n: int, name: string) returns bool {
    let started = time.monotonic_nanos()
    let values: List<int> = collections.list_with_capacity(n)
    let constructed = time.monotonic_nanos()
    return bench_list(n, values, constructed - started, name)
}

