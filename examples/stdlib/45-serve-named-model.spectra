module stdlib_serve_named_model

import std.io as io
import std.serve as serve
import std.string as string
import std.tensor as tensor

public func main() returns int {
    serve.reset()
    let server = serve.server_new(45)
    let weights = tensor.full2_f(1, 1, 3.0)
    let bias = tensor.full_f(1, 1.0)
    if serve.server_register_named_model_linear(server, "scaled", weights, bias, 0) != 1 {
        return 1
    }
    if serve.server_set_model_version(server, "stdlib-named-v1") != true {
        return 2
    }
    if serve.server_set_input_policy(server, 0, 10) != true or serve.server_set_output_policy(server, 0, 20) != true {
        return 3
    }
    if serve.server_set_rate_limit(server, 4) != true or serve.server_set_fallback(server, -1) != true {
        return 4
    }

    let request = serve.server_infer(server, "scaled", tensor.full_f(1, 4.0))
    let vector = serve.server_result_vector(server, request)
    if tensor.len(vector) != 1 or tensor.get_f(vector, 0) as int != 13 {
        return 5
    }
    if serve.server_result(server, request) != 13 {
        return 6
    }

    let snapshot = serve.server_monitoring_snapshot(server)
    let distribution = serve.server_distribution_summary(server)
    let audit = serve.server_audit_log(server)
    if !string.contains(snapshot, "scaled") or !string.contains(snapshot, "stdlib-named-v1") {
        return 7
    }
    if !string.contains(distribution, "distribution_summary.v1") or !string.contains(audit, "spectra.serve.audit.v1") {
        return 8
    }

    io.println("serve named model -> real linear inference and monitoring")
    tensor.free_all()
    serve.reset()
    return 0
}
