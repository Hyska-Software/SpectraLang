module stdlib_serve_multi_model_routing

import std.io as io
import std.serve as serve
import std.string as string
import std.tensor as tensor

public func main() returns int {
    serve.reset()
    let server = serve.server_new(60)
    let double_weights = tensor.full2_f(1, 1, 2.0)
    let double_bias = tensor.full_f(1, 0.0)
    let shift_weights = tensor.full2_f(1, 1, 3.0)
    let shift_bias = tensor.full_f(1, 0.25)
    if serve.server_register_named_model_linear(server, "double", double_weights, double_bias, 0) != 1 {
        return 1
    }
    if serve.server_register_named_model_linear(server, "shift", shift_weights, shift_bias, 2) != 1 {
        return 2
    }
    if serve.server_register_model_linear(server, tensor.full2_f(1, 1, 1.0), double_bias, 0) != 1 {
        return 3
    }

    let double_request = serve.server_infer(server, "double", tensor.full_f(1, 3.0))
    let shift_request = serve.server_infer(server, "shift", tensor.full_f(1, 3.0))
    let default_request = serve.server_infer(server, "default", tensor.full_f(1, 3.0))
    let negative_request = serve.server_infer(server, "double", tensor.full_f(1, -2.0))
    if serve.server_result(server, double_request) != 6 or serve.server_result(server, shift_request) != 1 {
        return 4
    }
    if serve.server_result(server, default_request) != 3 or serve.server_result(server, negative_request) != 0 {
        return 5
    }
    let vector = serve.server_result_vector(server, shift_request)
    if tensor.len(vector) != 1 or tensor.get_f(vector, 0) <= 0.99 {
        return 6
    }
    let snapshot = serve.server_monitoring_snapshot(server)
    if not string.contains(snapshot, "\"model\":\"double\"") or not string.contains(snapshot, "\"model\":\"shift\"") {
        return 7
    }
    if not string.contains(snapshot, "\"model\":\"default\"") {
        return 8
    }

    io.println("serve multi-model routing -> named forward passes and per-model metrics")
    tensor.free_all()
    serve.reset()
    return 0
}
