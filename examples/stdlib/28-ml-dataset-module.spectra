module stdlib_ml_dataset_module

import std.io as io
import std.ml as ml
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    let features = tensor.reshape(tensor.arange(1, 9, 1), 4, 2)
    let labels = tensor.arange(10, 14, 1)
    let dataset = ml.dataset_from_tensors(features, labels, 4)
    if ml.dataset_len(dataset) != 4 {
        return 1
    }
    let mapped = ml.dataset_map_features(dataset, 2.0, 1.0)
    let filtered = ml.dataset_filter_label_min(dataset, 11.0)
    if ml.dataset_len(mapped) != 4 or ml.dataset_len(filtered) != 3 {
        return 2
    }
    let train = ml.dataset_train_split(dataset, 3)
    let test = ml.dataset_test_split(dataset, 3)
    if ml.dataset_len(train) != 3 or ml.dataset_len(test) != 1 {
        return 3
    }
    let loader = ml.dataloader_new(train, 2, 28028)
    if ml.dataloader_batch_count(loader) != 2 {
        return 4
    }
    if tensor.len(ml.dataloader_batch_features(loader, 0)) != 4 or tensor.len(ml.dataloader_batch_labels(loader, 0)) != 2 {
        return 5
    }

    let model = ml.module_new()
    let parameter = tensor.requires_grad(tensor.full_f(2, 0.5), true)
    ml.module_add_parameter(model, parameter)
    if ml.module_parameter_count(model) != 1 {
        return 6
    }
    ml.module_set_training(model, false)
    if ml.module_is_training(model) != false {
        return 7
    }
    io.println("ml data -> tensor dataset splits dataloader module")
    tensor.free_all()
    return 0
}
