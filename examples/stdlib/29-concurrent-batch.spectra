module stdlib_concurrent_batch

import std.concurrent as concurrent
import std.io as io

public func main() returns int {
    concurrent.reset()
    let first_batch = concurrent.task_spawn_batch(3, 4)
    let second_batch = concurrent.task_spawn_batch(-2, 3)
    if concurrent.task_join_batch_sum(first_batch) != 18 or concurrent.task_join_batch_sum(second_batch) != -3 {
        return 1
    }
    if concurrent.stats_tasks_spawned() != 7 {
        return 2
    }

    let channel = concurrent.channel_new()
    concurrent.channel_send(channel, 101)
    concurrent.channel_send(channel, 202)
    if concurrent.channel_len(channel) != 2 or concurrent.channel_recv(channel) != 101 {
        return 3
    }
    if concurrent.channel_recv(channel) != 202 or concurrent.channel_len(channel) != 0 {
        return 4
    }
    concurrent.channel_close(channel)
    if concurrent.channel_send(channel, 303) != false {
        return 5
    }

    let counter = concurrent.counter_new(10)
    if concurrent.counter_add(counter, -4) != 6 or concurrent.counter_get(counter) != 6 {
        return 6
    }
    if concurrent.pipeline_sum(4, 3, 1) != 15 {
        return 7
    }
    io.println("concurrent batch -> channel counter reset")
    concurrent.reset()
    if concurrent.stats_tasks_spawned() != 0 or concurrent.stats_channels() != 0 {
        return 8
    }
    return 0
}
