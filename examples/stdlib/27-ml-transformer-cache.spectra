module stdlib_ml_transformer_cache

import std.io as io
import std.ml as ml
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    tensor.set_grad_enabled(false)
    let table = tensor.reshape(tensor.full_f(6, 1.0), 3, 2)
    let ids = tensor.arange(0, 2, 1)
    let embedded = ml.embedding_lookup(table, ids)
    let positions = ml.positional_encoding(2, 2)
    if tensor.rows(embedded) != 2 or tensor.cols(embedded) != 2 or tensor.rows(positions) != 2 {
        return 1
    }

    let scale = tensor.full_f(2, 1.0)
    let bias = tensor.full_f(2, 0.0)
    let normalized = ml.layer_norm(embedded, scale, bias, 0.00001)
    let activated = ml.gelu(normalized)
    let gated = ml.swiglu(activated, positions)
    if tensor.len(normalized) != 4 or tensor.len(gated) != 4 {
        return 2
    }

    let query = tensor.reshape(tensor.full_f(4, 1.0), 2, 2)
    let key = tensor.reshape(tensor.full_f(4, 1.0), 2, 2)
    let value = tensor.reshape(tensor.full_f(4, 2.0), 2, 2)
    let attended = ml.attention(query, key, value)
    if tensor.rows(attended) != 2 or tensor.cols(attended) != 2 {
        return 3
    }
    let cache = ml.kv_cache_new(4, 2)
    if ml.kv_cache_append(cache, key, value) != 2 or ml.kv_cache_len(cache) != 2 {
        return 4
    }
    if tensor.rows(ml.kv_cache_keys(cache)) != 2 or tensor.rows(ml.kv_cache_values(cache)) != 2 {
        return 5
    }

    let logits = tensor.reshape(tensor.full_f(4, 1.0), 1, 4)
    let sample_a = ml.logits_sample_seeded(27027, logits, 1.0)
    let sample_b = ml.logits_sample_seeded(27027, logits, 1.0)
    if sample_a != sample_b or sample_a < 0 or sample_a > 3 {
        return 6
    }
    io.println("ml transformer -> embedding attention KV cache sampling")
    tensor.free_all()
    tensor.set_grad_enabled(true)
    return 0
}
