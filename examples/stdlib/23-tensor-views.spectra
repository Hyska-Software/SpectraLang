module stdlib_tensor_views

import std.io as io
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    let base = tensor.arange(1, 9, 1)
    let matrix = tensor.reshape(base, 2, 4)
    let transposed = tensor.transpose(matrix)
    if tensor.rank(matrix) != 2 or tensor.rows(transposed) != 4 or tensor.cols(transposed) != 2 {
        return 1
    }
    if tensor.get2(transposed, 0, 1) != 5 or tensor.get2(transposed, 3, 0) != 4 {
        return 2
    }

    let flat = tensor.flatten(matrix)
    let middle = tensor.slice(flat, 2, 6)
    if tensor.rank(flat) != 1 or tensor.len(middle) != 4 or tensor.sum(middle) != 18 {
        return 3
    }

    let left = tensor.arange(1, 4, 1)
    let right = tensor.arange(4, 7, 1)
    let joined = tensor.concat(left, right)
    if tensor.len(joined) != 6 or tensor.get(joined, 5) != 6 {
        return 4
    }
    let row_left = tensor.reshape(left, 1, 3)
    let row_right = tensor.reshape(right, 1, 3)
    let stacked = tensor.stack(row_left, row_right)
    if tensor.rank(stacked) != 3 or tensor.dim(stacked, 0) != 2 or tensor.dim(stacked, 2) != 3 {
        return 5
    }

    io.println("tensor views -> reshape transpose slice concat stack")
    tensor.free_all()
    return 0
}
