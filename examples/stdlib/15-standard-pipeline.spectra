module stdlib_standard_pipeline

from std.collections import List
import std.collections as collections
import std.convert as convert
import std.error as error
import std.fs as fs
import std.io as io
import std.math as math
import std.option as option
import std.result as result
import std.string as string

const ROOT = "target/stdlib-examples/standard-pipeline"
const PATH = ROOT + "/values.txt"

func field_at(fields: List<string>, index: int) returns string {
    let value = collections.list_get_option(fields, index)
    if option.is_some(value) {
        return option.option_unwrap(value)
    }
    return ""
}

public func main() returns int {
    // Remove leftovers so the example can be rerun after a partial failure.
    fs.fs_remove(PATH)
    fs.remove_dir(ROOT)
    fs.remove_dir("target/stdlib-examples/standard-pipeline")
    fs.remove_dir("target/stdlib-examples")

    let created = fs.create_dir_all(ROOT)
    if result.is_err(created) {
        return 1
    }

    let wrote = fs.fs_write(PATH, "3,5,8,13")
    if result.is_err(wrote) {
        return 2
    }
    let loaded = fs.fs_read(PATH)
    if result.is_err(loaded) {
        return 3
    }
    let text = result.result_unwrap(loaded)
    if text != "3,5,8,13" {
        return 4
    }

    let fields: List<string> = string.split_by(text, ",")
    if collections.list_len(fields) != 4 {
        collections.list_free(fields)
        return 5
    }
    let numbers: List<int> = collections.list_new()
    collections.list_push(numbers, convert.string_to_int(field_at(fields, 0)))
    collections.list_push(numbers, convert.string_to_int(field_at(fields, 1)))
    collections.list_push(numbers, convert.string_to_int(field_at(fields, 2)))
    collections.list_push(numbers, convert.string_to_int(field_at(fields, 3)))

    let total = collections.list_reduce(numbers, 0, |acc: int, value: int| acc + value)
    if total != 29 or math.clamp(total, 0, 20) != 20 {
        collections.list_free(fields)
        collections.list_free(numbers)
        return 6
    }
    if math.gcd(total, 4) != 1 or math.lcm(3, 5) != 15 {
        collections.list_free(fields)
        collections.list_free(numbers)
        return 7
    }

    let missing = fs.fs_read(ROOT + "/missing.txt")
    if result.is_ok(missing) {
        collections.list_free(fields)
        collections.list_free(numbers)
        return 8
    }
    if let Result::Err(problem) = missing {
        if error.code(problem) != 1 or error.operation(problem) != "fs_read" {
            collections.list_free(fields)
            collections.list_free(numbers)
            return 9
        }
    }

    let removed = fs.fs_remove(PATH)
    if result.is_err(removed) or result.result_unwrap(removed) != true {
        collections.list_free(fields)
        collections.list_free(numbers)
        return 10
    }
    let exists_after = fs.fs_exists(PATH)
    if result.is_err(exists_after) or result.result_unwrap(exists_after) != false {
        collections.list_free(fields)
        collections.list_free(numbers)
        return 11
    }

    collections.list_free(fields)
    collections.list_free(numbers)
    fs.remove_dir(ROOT)
    fs.remove_dir("target/stdlib-examples/standard-pipeline")
    fs.remove_dir("target/stdlib-examples")
    io.println("standard pipeline -> " + convert.int_to_string(total) + " values")
    return 0
}
