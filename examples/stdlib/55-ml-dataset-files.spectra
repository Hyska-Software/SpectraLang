module stdlib_ml_dataset_files

import std.fs as fs
import std.io as io
import std.ml as ml
import std.result as result
import std.string as string
import std.tensor as tensor

const ROOT = "target/stdlib-examples/ml-data-55"
const CSV = ROOT + "/tabular.csv"
const JSONL = ROOT + "/rows.jsonl"
const DIRECTORY = ROOT + "/directory"

public func main() returns int {
    fs.fs_remove(CSV)
    fs.fs_remove(JSONL)
    fs.fs_remove(DIRECTORY + "/features.csv")
    fs.fs_remove(DIRECTORY + "/labels.csv")
    fs.remove_dir(DIRECTORY)
    fs.remove_dir(ROOT)
    let created = fs.create_dir_all(ROOT)
    if result.is_err(created) {
        return 1
    }
    let csv_text = "f0,f1,label\n1.0,2.0,0.0\n2.0,3.0,1.0\n3.0,4.0,1.0\n4.0,5.0,0.0\n"
    if result.is_err(fs.fs_write(CSV, csv_text)) {
        return 2
    }
    let jsonl_text = "{\"features\":[1.0,2.0],\"label\":0.0}\n{\"features\":[2.0,3.0],\"label\":1.0}\n"
    if result.is_err(fs.fs_write(JSONL, jsonl_text)) {
        return 3
    }
    if result.is_err(fs.create_dir_all(DIRECTORY)) {
        return 4
    }
    if result.is_err(fs.fs_write(DIRECTORY + "/features.csv", "x0,x1\n1.0,2.0\n2.0,3.0\n3.0,4.0\n")) {
        return 5
    }
    if result.is_err(fs.fs_write(DIRECTORY + "/labels.csv", "y\n0.0\n1.0\n1.0\n")) {
        return 6
    }

    let dataset = ml.dataset_from_csv(CSV, 2, 1)
    if ml.dataset_len(dataset) != 4 {
        return 7
    }
    let filtered = ml.dataset_filter_label_min(dataset, 1.0)
    if ml.dataset_len(filtered) != 2 {
        return 8
    }
    let loader = ml.dataloader_new(filtered, 1, 55)
    if ml.dataloader_batch_count(loader) != 2 {
        return 9
    }
    let batch_features = ml.dataloader_batch_features(loader, 0)
    let batch_labels = ml.dataloader_batch_labels(loader, 0)
    if tensor.len(batch_features) != 2 or tensor.len(batch_labels) != 1 {
        return 10
    }

    let jsonl_dataset = ml.dataset_from_jsonl(JSONL)
    let directory_dataset = ml.dataset_from_directory(DIRECTORY)
    if ml.dataset_len(jsonl_dataset) != 2 or ml.dataset_len(directory_dataset) != 3 {
        return 11
    }
    let frame = ml.dataframe_from_csv(CSV, 1)
    let column = ml.dataframe_column(frame, 1)
    if ml.dataframe_rows(frame) != 4 or ml.dataframe_cols(frame) != 3 or tensor.sum_f(column) != 14.0 {
        return 12
    }

    io.println("ML dataset files -> CSV JSONL directory dataframe")
    fs.fs_remove(CSV)
    fs.fs_remove(JSONL)
    fs.fs_remove(DIRECTORY + "/features.csv")
    fs.fs_remove(DIRECTORY + "/labels.csv")
    fs.remove_dir(DIRECTORY)
    fs.remove_dir(ROOT)
    return 0
}
