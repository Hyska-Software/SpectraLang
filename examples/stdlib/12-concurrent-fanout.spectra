module stdlib_concurrent_fanout

import std.concurrent as concurrent

public func main() returns int {
    concurrent.reset()

    let first = concurrent.task_spawn_fn(|value: int| value * value, 3)
    let second = concurrent.task_spawn_fn(|value: int| value * value, 4)
    let third = concurrent.task_spawn_fn(|value: int| value * value, 5)
    let observed = concurrent.task_is_done(first)
    if observed != true and observed != false {
        return 1
    }
    let total = concurrent.task_join(first) + concurrent.task_join(second) + concurrent.task_join(third)
    if total != 50 or concurrent.stats_tasks_spawned() != 3 {
        return 2
    }

    let channel = concurrent.channel_new()
    if concurrent.channel_send(channel, 11) != true or concurrent.channel_send(channel, 22) != true or concurrent.channel_send(channel, 33) != true {
        return 3
    }
    if concurrent.channel_len(channel) != 3 {
        return 4
    }
    if concurrent.channel_recv(channel) != 11 or concurrent.channel_recv(channel) != 22 or concurrent.channel_recv(channel) != 33 {
        return 5
    }
    if concurrent.channel_len(channel) != 0 {
        return 6
    }
    concurrent.channel_close(channel)
    if concurrent.channel_send(channel, 44) != false {
        return 7
    }

    let counter = concurrent.counter_new(5)
    if concurrent.counter_add(counter, 7) != 12 or concurrent.counter_add(counter, -2) != 10 {
        return 8
    }
    if concurrent.counter_get(counter) != 10 {
        return 9
    }
    if concurrent.pipeline_sum(3, 4, 2) != 18 or concurrent.pipeline_sum(3, 0, 2) != 0 {
        return 10
    }
    if concurrent.stats_channels() != 1 {
        return 11
    }
    concurrent.reset()
    if concurrent.stats_tasks_spawned() != 0 or concurrent.stats_channels() != 0 {
        return 12
    }
    return 0
}
