module stdlib_ml_modules_layers_losses

import std.io as io
import std.math as math
import std.ml as ml
import std.tensor as tensor

func close_to(actual: float, expected: float) returns bool {
    return math.abs_f(actual - expected) < 0.0001
}

public func main() returns int {
    tensor.free_all()
    tensor.set_grad_enabled(false)

    let model = ml.module_new()
    let parameter = tensor.full_f(2, 1.5)
    ml.module_add_parameter(model, parameter)
    if ml.module_parameter_count(model) != 1 or ml.module_is_training(model) != true {
        return 1
    }
    ml.module_set_training(model, false)
    if ml.module_is_training(model) != false or tensor.len(ml.module_parameter(model, 0)) != 2 {
        return 2
    }

    let input = tensor.full2_f(2, 2, 2.0)
    let weights = tensor.full2_f(2, 3, 1.0)
    let bias = tensor.full_f(3, 0.5)
    let linear = ml.linear(input, weights, bias)
    if tensor.rows(linear) != 2 or tensor.cols(linear) != 3 or not close_to(tensor.get_f(linear, 0), 4.5) {
        return 3
    }

    let conv_input = tensor.full_f(4, 1.0)
    let kernel = tensor.full_f(1, 2.0)
    let conv_bias = tensor.full_f(1, 0.5)
    let convolved = ml.conv2d(conv_input, kernel, conv_bias, 1, 1, 2, 2, 1, 1, 1)
    if tensor.len(convolved) != 4 or not close_to(tensor.get_f(convolved, 0), 2.5) {
        return 4
    }
    tensor.set_f(conv_input, 0, 1.0)
    tensor.set_f(conv_input, 1, 2.0)
    tensor.set_f(conv_input, 2, 3.0)
    tensor.set_f(conv_input, 3, 4.0)
    let pooled = ml.max_pool2d(conv_input, 1, 1, 2, 2, 2, 2)
    if tensor.len(pooled) != 1 or not close_to(tensor.get_f(pooled, 0), 4.0) {
        return 5
    }
    let inference_dropout = ml.dropout(conv_input, 0.5, false)
    if not close_to(tensor.get_f(inference_dropout, 3), 4.0) {
        return 6
    }

    let prediction = tensor.full_f(2, 1.0)
    let target = tensor.full_f(2, 0.5)
    let mse = ml.mse_loss(prediction, target)
    let bce = ml.bce_loss(prediction, target)
    if not close_to(tensor.get_f(mse, 0), 0.25) or tensor.get_f(bce, 0) <= 0.0 {
        return 7
    }
    let logits = tensor.full2_f(2, 2, 0.0)
    tensor.set2_f(logits, 0, 0, 2.0)
    tensor.set2_f(logits, 1, 1, 2.0)
    let classes = tensor.full(2, 0)
    tensor.set(classes, 1, 1)
    let cross_entropy = ml.cross_entropy_loss(logits, classes)
    let log_probs = tensor.full2_f(2, 2, -1.0)
    let nll = ml.nll_loss(log_probs, classes)
    if tensor.get_f(cross_entropy, 0) <= 0.0 or not close_to(tensor.get_f(nll, 0), 1.0) {
        return 8
    }

    io.println("ML modules layers and losses -> ok")
    tensor.free_all()
    tensor.set_grad_enabled(true)
    return 0
}
