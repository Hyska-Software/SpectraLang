module task_ops

import std.concurrent as concurrent

public func run_concurrency() returns int {
    concurrent.reset()
    let first = concurrent.task_spawn_fn(|value: int| value * value, 3)
    let second = concurrent.task_spawn_fn(|value: int| value * value, 4)
    let third = concurrent.task_spawn_fn(|value: int| value * value, 5)
    let total = concurrent.task_join(first) + concurrent.task_join(second) + concurrent.task_join(third)
    if total != 50 or concurrent.stats_tasks_spawned() != 3 {
        return 1
    }
    let channel = concurrent.channel_new()
    if not concurrent.channel_send(channel, 11) or not concurrent.channel_send(channel, 22) or not concurrent.channel_send(channel, 33) {
        return 2
    }
    if concurrent.channel_len(channel) != 3 or concurrent.channel_recv(channel) != 11 or concurrent.channel_recv(channel) != 22 or concurrent.channel_recv(channel) != 33 {
        return 3
    }
    concurrent.channel_close(channel)
    let counter = concurrent.counter_new(5)
    if concurrent.counter_add(counter, 7) != 12 or concurrent.counter_add(counter, -2) != 10 or concurrent.counter_get(counter) != 10 {
        return 4
    }
    if concurrent.pipeline_sum(3, 4, 2) != 18 or concurrent.stats_channels() != 1 {
        return 5
    }
    concurrent.reset()
    if concurrent.stats_tasks_spawned() != 0 or concurrent.stats_channels() != 0 {
        return 6
    }
    return 0
}
