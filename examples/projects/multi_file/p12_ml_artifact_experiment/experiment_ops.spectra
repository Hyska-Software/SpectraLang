module experiment_ops

import std.fs as fs
import std.ml as ml
import std.string as string
import paths

public func verify_experiment() returns int {
    let root = paths.experiment_root()
    let run_a = ml.experiment_start("multi-file-run", root + "/run-a", 77)
    let run_b = ml.experiment_start("multi-file-run", root + "/run-b", 77)
    let run_c = ml.experiment_start("multi-file-run", root + "/run-c", 77)
    if run_a == 0 or run_b == 0 or run_c == 0 {
        return 1
    }
    ml.experiment_set_config(run_a, "dataset", "fixtures/demo.csv")
    ml.experiment_set_config(run_b, "dataset", "fixtures/demo.csv")
    ml.experiment_set_config(run_c, "dataset", "fixtures/other.csv")
    ml.experiment_log_metric(run_a, "loss", 0.25, 2)
    ml.experiment_log_metric(run_b, "loss", 0.25, 2)
    ml.experiment_log_metric(run_c, "loss", 0.50, 2)
    ml.experiment_finish(run_a)
    ml.experiment_finish(run_b)
    ml.experiment_finish(run_c)
    let manifest_a = ml.experiment_manifest_path(run_a)
    let manifest_b = ml.experiment_manifest_path(run_b)
    let manifest_c = ml.experiment_manifest_path(run_c)
    if ml.experiment_compare_manifests(manifest_a, manifest_b) != 1 or ml.experiment_compare_manifests(manifest_a, manifest_c) != 0 {
        return 2
    }
    let command = ml.experiment_repro_command(run_a)
    if not string.contains(command, "spectralang run") or not string.contains(command, "experiment-manifest") {
        return 3
    }
    let manifest = fs.fs_read(manifest_a)
    if let Result::Ok(text) = manifest {
        if not string.contains(text, "spectra.ml.experiment.v1") {
            return 4
        }
    } else {
        return 4
    }
    return 0
}
