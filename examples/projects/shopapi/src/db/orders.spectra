module db.orders

// Order persistence. All multi-statement flows (checkout, cancellation)
// run inside an explicit transaction started by the caller, so the `_on`
// variants take a live connection; the convenience variants open and close
// their own connection for single-shot reads.

from std.api.db.sqlite import SqliteConnection, SqliteStatement
import std.api.db.sqlite as sqlite
import std.convert as convert

import std.string as str
import config
import db.connection as connection
import models.order

import models.product

public func create(customer: string, note: string, now: int) returns int {
    let db: SqliteConnection = connection.connect(config.db_path())
    let stmt = sqlite.prepare(
        db,
        "INSERT INTO orders(customer, status, note, total_cents, created_at, updated_at) VALUES (?, 0, ?, 0, ?, ?)")
    if sqlite.bind_text(stmt, 1, customer) != true {
        return 0
    }
    if sqlite.bind_text(stmt, 2, note) != true {
        return 0
    }
    if sqlite.bind_int(stmt, 3, now) != true {
        return 0
    }
    if sqlite.bind_int(stmt, 4, now) != true {
        return 0
    }
    if sqlite.step(stmt) != 2 {
        sqlite.finalize(stmt)
        return 0
    }
    if sqlite.finalize(stmt) != true {
        return 0
    }
    let rowid  = sqlite.prepare(db, "SELECT last_insert_rowid()")
    let new_id = 0
    if sqlite.step(rowid) == 1 {
        new_id = sqlite.column_int(rowid, 0)
    }
    sqlite.finalize(rowid)
    if connection.disconnect(db) != true {
        return 0
    }
    return new_id
}

public func row_on(db: SqliteConnection, id: int) returns OrderRecord {
    let missing = OrderRecord {
        id: 0,
        customer: "",
        status: 0,
        note: "",
        total_cents: 0,
        created_at: 0,
        updated_at: 0,
    }
    let query = sqlite.prepare(
        db,
        "SELECT id, customer, status, note, total_cents, created_at, updated_at FROM orders WHERE id = ?")
    if sqlite.bind_int(query, 1, id) != true {
        return missing
    }
    let found = missing
    if sqlite.step(query) == 1 {
        found = OrderRecord {
            id: sqlite.column_int(query, 0),
            customer: sqlite.column_text(query, 1),
            status: sqlite.column_int(query, 2),
            note: sqlite.column_text(query, 3),
            total_cents: sqlite.column_int(query, 4),
            created_at: sqlite.column_int(query, 5),
            updated_at: sqlite.column_int(query, 6),
        }
    }
    sqlite.finalize(query)
    return found
}

public func row(id: int) returns OrderRecord {
    let db: SqliteConnection = connection.connect(config.db_path())
    let found                = row_on(db, id)
    connection.disconnect(db)
    return found
}

public func set_status_on(
    db: SqliteConnection,
    id: int,
    status: int,
    now: int) returns bool {
    let stmt = sqlite.prepare(db, "UPDATE orders SET status = ?, updated_at = ? WHERE id = ?")
    if sqlite.bind_int(stmt, 1, status) != true {
        return false
    }
    if sqlite.bind_int(stmt, 2, now) != true {
        return false
    }
    if sqlite.bind_int(stmt, 3, id) != true {
        return false
    }
    if sqlite.step(stmt) != 2 {
        sqlite.finalize(stmt)
        return false
    }
    return sqlite.finalize(stmt)
}

// quantity > 0 inserts or replaces the line with the snapshot price;
// quantity == 0 removes it. Used only while the order is a draft.
public func upsert_item_on(
    db: SqliteConnection,
    order_id: int,
    product: ProductSnapshot,
    quantity: int) returns bool {
    if quantity == 0 {
        return delete_item_on(db, order_id, product.id)
    }
    let stmt = sqlite.prepare(
        db,
        "INSERT INTO order_items(order_id, product_id, sku, title, quantity, unit_price_cents) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT(order_id, product_id) DO UPDATE SET quantity = excluded.quantity")
    if sqlite.bind_int(stmt, 1, order_id) != true {
        return false
    }
    if sqlite.bind_int(stmt, 2, product.id) != true {
        return false
    }
    if sqlite.bind_text(stmt, 3, product.sku) != true {
        return false
    }
    if sqlite.bind_text(stmt, 4, product.title) != true {
        return false
    }
    if sqlite.bind_int(stmt, 5, quantity) != true {
        return false
    }
    if sqlite.bind_int(stmt, 6, product.price_cents) != true {
        return false
    }
    if sqlite.step(stmt) != 2 {
        sqlite.finalize(stmt)
        return false
    }
    return sqlite.finalize(stmt)
}

public func delete_item_on(db: SqliteConnection, order_id: int, product_id: int) returns bool {
    let stmt = sqlite.prepare(db, "DELETE FROM order_items WHERE order_id = ? AND product_id = ?")
    if sqlite.bind_int(stmt, 1, order_id) != true {
        return false
    }
    if sqlite.bind_int(stmt, 2, product_id) != true {
        return false
    }
    if sqlite.step(stmt) != 2 {
        sqlite.finalize(stmt)
        return false
    }
    return sqlite.finalize(stmt)
}

public func touch_total_on(db: SqliteConnection, order_id: int) returns int {
    let recompute = sqlite.prepare(
        db,
        "UPDATE orders SET total_cents = COALESCE((SELECT SUM(quantity * unit_price_cents) FROM order_items WHERE order_id = ?), 0) WHERE id = ?")
    if sqlite.bind_int(recompute, 1, order_id) != true {
        return 0
    }
    if sqlite.bind_int(recompute, 2, order_id) != true {
        return 0
    }
    if sqlite.step(recompute) != 2 {
        sqlite.finalize(recompute)
        return 0
    }
    if sqlite.finalize(recompute) != true {
        return 0
    }
    let read = sqlite.prepare(db, "SELECT total_cents FROM orders WHERE id = ?")
    if sqlite.bind_int(read, 1, order_id) != true {
        return 0
    }
    let total = 0
    if sqlite.step(read) == 1 {
        total = sqlite.column_int(read, 0)
    }
    sqlite.finalize(read)
    return total
}

// Names of the lines whose requested quantity exceeds current stock.
// Empty string means the order can be submitted.
public func insufficient_titles_on(db: SqliteConnection, order_id: int) returns string {
    let query = sqlite.prepare(
        db,
        "SELECT COALESCE(GROUP_CONCAT(p.title, ', '), '') FROM order_items i JOIN products p ON p.id = i.product_id WHERE i.order_id = ? AND p.stock < i.quantity")
    if sqlite.bind_int(query, 1, order_id) != true {
        return ""
    }
    let titles = ""
    if sqlite.step(query) == 1 {
        titles = sqlite.column_text(query, 0)
    }
    sqlite.finalize(query)
    return titles
}

// Atomically reserves every line of the order (stock >= quantity was just
// verified inside the same transaction).
public func reserve_stock_on(db: SqliteConnection, order_id: int) returns bool {
    let stmt = sqlite.prepare(
        db,
        "UPDATE products SET stock = stock - (SELECT i.quantity FROM order_items i WHERE i.order_id = ? AND i.product_id = products.id) WHERE id IN (SELECT product_id FROM order_items WHERE order_id = ?) AND stock >= (SELECT i.quantity FROM order_items i WHERE i.order_id = ? AND i.product_id = products.id)")
    if sqlite.bind_int(stmt, 1, order_id) != true {
        return false
    }
    if sqlite.bind_int(stmt, 2, order_id) != true {
        return false
    }
    if sqlite.bind_int(stmt, 3, order_id) != true {
        return false
    }
    if sqlite.step(stmt) != 2 {
        sqlite.finalize(stmt)
        return false
    }
    return sqlite.finalize(stmt)
}

public func restock_on(db: SqliteConnection, order_id: int) returns bool {
    let stmt = sqlite.prepare(
        db,
        "UPDATE products SET stock = stock + (SELECT i.quantity FROM order_items i WHERE i.order_id = ? AND i.product_id = products.id) WHERE id IN (SELECT product_id FROM order_items WHERE order_id = ?)")
    if sqlite.bind_int(stmt, 1, order_id) != true {
        return false
    }
    if sqlite.bind_int(stmt, 2, order_id) != true {
        return false
    }
    if sqlite.step(stmt) != 2 {
        sqlite.finalize(stmt)
        return false
    }
    return sqlite.finalize(stmt)
}

public func lines_json_on(db: SqliteConnection, order_id: int) returns string {
    let query = sqlite.prepare(
        db,
        "SELECT COALESCE(json_group_array(json_object('product_id', product_id, 'sku', sku, 'title', title, 'quantity', quantity, 'unit_price_cents', unit_price_cents, 'line_total_cents', quantity * unit_price_cents)), '[]') FROM order_items WHERE order_id = ? ORDER BY product_id")
    if sqlite.bind_int(query, 1, order_id) != true {
        return ""
    }
    let text = ""
    if sqlite.step(query) == 1 {
        text = sqlite.column_text(query, 0)
    }
    sqlite.finalize(query)
    return text
}

public func detail_json(id: int) returns string {
    let db: SqliteConnection = connection.connect(config.db_path())
    let query = sqlite.prepare(
        db,
        "SELECT json_object('id', o.id, 'customer', o.customer, 'status', CASE o.status WHEN 0 THEN 'draft' WHEN 1 THEN 'submitted' WHEN 2 THEN 'paid' WHEN 3 THEN 'shipped' ELSE 'cancelled' END, 'status_code', o.status, 'note', o.note, 'total_cents', o.total_cents, 'created_at', o.created_at, 'updated_at', o.updated_at, 'items', json(COALESCE((SELECT json_group_array(json_object('product_id', i.product_id, 'sku', i.sku, 'title', i.title, 'quantity', i.quantity, 'unit_price_cents', i.unit_price_cents, 'line_total_cents', i.quantity * i.unit_price_cents)) FROM order_items i WHERE i.order_id = o.id), '[]'))) FROM orders o WHERE o.id = ?")
    if sqlite.bind_int(query, 1, id) != true {
        return ""
    }
    let text = ""
    if sqlite.step(query) == 1 {
        text = sqlite.column_text(query, 0)
    }
    sqlite.finalize(query)
    connection.disconnect(db)
    return text
}

func list_predicate(include_all: bool, customer: string, status: int) returns string {
    let predicate = " WHERE 1 = 1"
    if include_all != true {
        predicate = str.concat(predicate, " AND o.customer = ?")
    }
    if status >= 0 {
        predicate = str.concat(predicate, " AND o.status = ?")
    }
    return predicate
}

func bind_list_filters(
    stmt: SqliteStatement,
    include_all: bool,
    customer: string,
    status: int) returns bool {
    let index = 1
    if include_all != true {
        if sqlite.bind_text(stmt, index, customer) != true {
            return false
        }
        index = index + 1
    }
    if status >= 0 {
        if sqlite.bind_int(stmt, index, status) != true {
            return false
        }
        index = index + 1
    }
    return true
}

public func list_total(include_all: bool, customer: string, status: int) returns int {
    let db: SqliteConnection = connection.connect(config.db_path())
    let sql = str.concat(
        "SELECT COUNT(*) FROM orders o",
        list_predicate(include_all, customer, status))
    let stmt = sqlite.prepare(db, sql)
    if bind_list_filters(stmt, include_all, customer, status) != true {
        sqlite.finalize(stmt)
        return 0
    }
    let total = 0
    if sqlite.step(stmt) == 1 {
        total = sqlite.column_int(stmt, 0)
    }
    sqlite.finalize(stmt)
    connection.disconnect(db)
    return total
}

public func list_json(
    include_all: bool,
    customer: string,
    status: int,
    page: int,
    per_page: int) returns string {
    let db: SqliteConnection = connection.connect(config.db_path())
    let offset = (page - 1) * per_page
    let base = "SELECT COALESCE(json_group_array(json_object('id', o.id, 'customer', o.customer, 'status', CASE o.status WHEN 0 THEN 'draft' WHEN 1 THEN 'submitted' WHEN 2 THEN 'paid' WHEN 3 THEN 'shipped' ELSE 'cancelled' END, 'status_code', o.status, 'total_cents', o.total_cents, 'created_at', o.created_at, 'item_count', (SELECT COUNT(*) FROM order_items i WHERE i.order_id = o.id))), '[]') FROM orders o"
    let sql = str.concat(base, list_predicate(include_all, customer, status))
    let ordered = str.concat(sql, " ORDER BY o.id DESC")
    let paged = str.concat(ordered, str.concat(" LIMIT ", convert.int_to_string(per_page)))
    let windowed = str.concat(paged, str.concat(" OFFSET ", convert.int_to_string(offset)))
    let stmt = sqlite.prepare(db, windowed)
    if bind_list_filters(stmt, include_all, customer, status) != true {
        sqlite.finalize(stmt)
        return ""
    }
    let text = ""
    if sqlite.step(stmt) == 1 {
        text = sqlite.column_text(stmt, 0)
    }
    sqlite.finalize(stmt)
    connection.disconnect(db)
    return text
}

// Newest order id for a customer (0 when none); used by the self-test.
public func last_id_for(customer: string) returns int {
    let db: SqliteConnection = connection.connect(config.db_path())
    let query = sqlite.prepare(db, "SELECT COALESCE(MAX(id), 0) FROM orders WHERE customer = ?")
    if sqlite.bind_text(query, 1, customer) != true {
        return 0
    }
    let found = 0
    if sqlite.step(query) == 1 {
        found = sqlite.column_int(query, 0)
    }
    sqlite.finalize(query)
    connection.disconnect(db)
    return found
}

public func count() returns int {
    let db: SqliteConnection = connection.connect(config.db_path())
    let query                = sqlite.prepare(db, "SELECT COUNT(*) FROM orders")
    let total                = 0
    if sqlite.step(query) == 1 {
        total = sqlite.column_int(query, 0)
    }
    sqlite.finalize(query)
    connection.disconnect(db)
    return total
}

public func status_counts_json() returns string {
    let db: SqliteConnection = connection.connect(config.db_path())
    let query = sqlite.prepare(
        db,
        "SELECT COALESCE(json_group_object(status_name, n), '{}') FROM (SELECT CASE status WHEN 0 THEN 'draft' WHEN 1 THEN 'submitted' WHEN 2 THEN 'paid' WHEN 3 THEN 'shipped' ELSE 'cancelled' END AS status_name, COUNT(*) AS n FROM orders GROUP BY status)")
    let text = "{}"
    if sqlite.step(query) == 1 {
        text = sqlite.column_text(query, 0)
    }
    sqlite.finalize(query)
    connection.disconnect(db)
    return text
}
