module scheduler

import std.concurrent as concurrent

public func data_schedule_batches(batches: int) returns int {
    concurrent.reset()
    let task    = concurrent.task_spawn_fn( | count: int | count + 1, batches)
    let result  = concurrent.task_join(task)
    let spawned = concurrent.stats_tasks_spawned()
    concurrent.reset()
    if spawned != 1 {
        return 0
    }
    return result
}
