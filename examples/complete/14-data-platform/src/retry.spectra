module retry

import std.fs as fs
import std.result as result

public func data_retry_read(path: string) returns int {
    let attempts = 0
    while attempts < 3 {
        let loaded = fs.fs_read(path)
        if result.is_ok(loaded) {
            return 0
        }
        attempts = attempts + 1
    }
    return 1
}
