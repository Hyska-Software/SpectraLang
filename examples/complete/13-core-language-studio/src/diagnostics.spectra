// Produces a deterministic diagnostic summary.
module diagnostics

import std.string as string

public func core_diagnostics_render(inferred: string) returns string {
    if string.contains(inferred, "inferred:total=int") and string.contains(inferred, "return:type=int") {
        return "diagnostics=0;severity=none"
    }
    return "diagnostics=1;severity=error"
}
