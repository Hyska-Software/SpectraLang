// Runs deterministic parallel scoring and a bounded handoff through std.concurrent.
module concurrency

import std.concurrent as concurrent

public func mlai_parallel_validation() returns int {
    concurrent.reset()
    let first  = concurrent.task_spawn_fn( | value: int | value * value, 3)
    let second = concurrent.task_spawn_fn( | value: int | value * value, 4)
    let third  = concurrent.task_spawn_fn( | value: int | value * value, 5)
    let total  = concurrent.task_join(first) +
        concurrent.task_join(second) +
        concurrent.task_join(third)
    let channel = concurrent.channel_new()
    if not concurrent.channel_send(channel, total) or not concurrent.channel_send(channel, concurrent.pipeline_sum(1, 4, 2)) {
        concurrent.reset()
        return-1
    }
    if concurrent.channel_len(channel) != 2 or concurrent.channel_recv(channel) != 50 or concurrent.channel_recv(channel) != 10 {
        concurrent.reset()
        return-2
    }
    let counter = concurrent.counter_new(0)
    if concurrent.counter_add(counter, 1) != 1 or concurrent.counter_add(counter, 2) != 3 {
        concurrent.reset()
        return-3
    }
    let spawned = concurrent.stats_tasks_spawned()
    concurrent.reset()
    if spawned != 3 {
        return-4
    }
    return total
}
