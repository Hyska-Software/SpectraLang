// Exercises the standard queue guardrails around the serving gateway.
module serving_guardrails

import std.serve as serve
import std.string as string

public func mlai_check_guardrails(server: int) returns int {
    if not serve.server_set_fallback(server, -777) {
        return 1
    }
    if not serve.server_set_input_policy(server, 0, 10) {
        return 2
    }
    if not serve.server_set_output_policy(server, -1000, 1000) {
        return 3
    }
    if not serve.server_set_rate_limit(server, 4) {
        return 4
    }

    let accepted = serve.server_enqueue(server, 5)
    let rejected = serve.server_enqueue(server, 50)
    if serve.server_pending(server) != 1 or serve.server_result(server, rejected) != -777 {
        return 5
    }
    if serve.server_process_batch(server, 1) != 1 or serve.server_result(server, accepted) != 5 {
        return 6
    }
    let diagnostic = serve.server_last_diagnostic(server)
    if not string.contains(diagnostic, "input") or not string.contains(diagnostic, "range") {
        return 7
    }
    return 0
}
