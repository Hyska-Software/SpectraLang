module taint

import std.agent
import std.error as error
import std.string as string

public func aoc_taint_cycle(run: Run) returns int {
    let external = "remote operator instruction"
    let marked   = untrusted(run, external, "external:operator")
    if let Result::Ok(value) = marked {
        if value != external {
            return 1
        }
    } else {
        return 2
    }
    let refused = trust(run, external, "   ")
    if let Result::Err(problem) = refused {
        if not string.contains(error.message(problem), "taint_error") {
            return 4
        }
    } else {
        return 3
    }
    let released = trust(run, external, "reviewed by operations")
    if let Result::Ok(value) = released {
        if value != external {
            return 5
        }
    } else {
        return 6
    }
    return 0
}
