module data.mixture

import std.tensor as tensor

public record PointSet {
    public points: int,
    public count: int,
}

func make_points(count: int, offset: int) returns PointSet {
    let jitter = tensor.normal_f(count * 2, 0.0, 0.12)
    let points = tensor.full_f(count * 2, 0.0)
    let index  = 0
    while index < count {
        let component = (index + offset) % 4
        let center_x  = -0.9
        let center_y  = -0.9
        if component == 1 {
            center_x = 0.9
            center_y = -0.9
        }
        if component == 2 {
            center_x = -0.9
            center_y = 0.9
        }
        if component == 3 {
            center_x = 0.9
            center_y = 0.9
        }
        tensor.set_f(points, index * 2, center_x + tensor.get_f(jitter, index * 2))
        tensor.set_f(points, index * 2 + 1, center_y + tensor.get_f(jitter, index * 2 + 1))
        index = index + 1
    }
    return PointSet { points: points, count: count }
}

public func training_set() returns PointSet {
    return make_points(64, 0)
}

public func holdout_set() returns PointSet {
    return make_points(24, 2)
}
