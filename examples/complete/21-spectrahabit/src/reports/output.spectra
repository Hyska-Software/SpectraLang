module reports.output

import std.convert as convert
from domain.model import Checkin
from domain.model import Habit

public func habit_line(habit: Habit, checkins: int) returns string {
    return "#" + convert.int_to_string(habit.id) + " [" + habit.state + "] meta=" +
        convert.int_to_string(habit.weekly_goal) + "/7 check-ins — " + habit.name +
        " (histórico: " + convert.int_to_string(checkins) + ")"
}

public func checkin_line(checkin: Checkin) returns string {
    let line = checkin.date
    if checkin.note != "" {
        line = line + " — " + checkin.note
    }
    return line
}

public func streak(habit: Habit, end_date: string, days: int) returns string {
    return "Sequência de #" + convert.int_to_string(habit.id) + " — " + habit.name +
        " até " + end_date + ": " + convert.int_to_string(days) + " dia(s)"
}

public func week_line(habit: Habit, start: string, end: string, count: int) returns string {
    let status = "meta pendente"
    if count >= habit.weekly_goal {
        status = "meta cumprida"
    }
    return "#" + convert.int_to_string(habit.id) + " " + habit.name + " " +
        start + ".." + end + " " + convert.int_to_string(count) + "/" +
        convert.int_to_string(habit.weekly_goal) + " [" + status + "]"
}
