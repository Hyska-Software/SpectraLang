module app

import std.convert as convert
import std.io as io
import std.ml as ml
import std.tensor as tensor
from data.graph_sample import GraphSample
from evaluation.metrics import NodeReport
from model.gcn import GraphClassifier
from training.fit import FitResult
import data.graph_sample as dataset
import evaluation.metrics as evaluation
import model.gcn as gcn
import training.fit as training

public func run() returns int {
    tensor.free_all()
    tensor.seed(25025)
    tensor.set_grad_enabled( false)
    let training_graph = dataset.training_graph()
    let holdout_graph  = dataset.holdout_graph()
    if training_graph.node_count != 8 or holdout_graph.node_count != 8 {
        io.eprintln("erro: cada fixture do grafo deveria ter oito nós")
        tensor.free_all()
        return 1
    }

    let model = gcn.create()
    if ml.module_parameter_count(model.module_handle) != 6 {
        io.eprintln("erro: GCN deveria registrar seis tensores treináveis")
        tensor.free_all()
        return 2
    }
    tensor.set_grad_enabled( true)
    let fit_result = training.fit(model, training_graph, 160)
    tensor.set_grad_enabled( false)
    let report = evaluation.evaluate(fit_result.model, holdout_graph)
    if fit_result.steps != 160 or fit_result.final_loss >= fit_result.initial_loss {
        io.eprintln("erro: treino deveria concluir e reduzir a cross-entropy")
        io.eprintln("initial=" + convert.float_to_string(fit_result.initial_loss) + " final=" + convert.float_to_string(fit_result.final_loss))
        tensor.free_all()
        return 3
    }
    if report.correct != report.count {
        io.eprintln("erro: classificação do grafo holdout não atingiu todos os nós")
        io.eprintln(report.metrics)
        tensor.free_all()
        return 4
    }

    io.println("SPECTRAGRAPH ok architecture=gcn-row-normalized-layernorm-gelu")
    io.println(
        "training: epochs=" + convert.int_to_string(fit_result.epochs) +
            " steps=" + convert.int_to_string(fit_result.steps) +
            " initial_loss=" + convert.float_to_string(fit_result.initial_loss) +
            " final_loss=" + convert.float_to_string(fit_result.final_loss)
    )
    io.println(
        "holdout: nodes=" + convert.int_to_string(report.count) +
            " correct=" + convert.int_to_string(report.correct) +
            " metrics=" + report.metrics
    )
    tensor.free_all()
    return 0
}
