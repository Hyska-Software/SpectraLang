// Priority planning uses deterministic random sampling and collection HOFs.
module planner

from std.collections import List, Set
import std.collections as collections
import std.option as option
import std.random as random

public func ops_plan_checksum(seed: int, critical: int) returns int {
    random.random_seed(seed)
    let priorities: List<int> = collections.list_new()
    collections.list_push(priorities, random.random_int(10, 20) + critical)
    collections.list_push(priorities, random.random_int(10, 20) + critical)
    collections.list_push(priorities, random.random_int(10, 20) + critical)
    collections.list_push(priorities, random.random_int(10, 20) + critical)

    let normalized   = collections.list_map(priorities, | value: int | value + 1)
    let urgent       = collections.list_filter(normalized, | value: int | value >= 15)
    let urgent_total = collections.list_reduce(urgent, 0, | acc: int, value: int | acc + value)
    collections.list_sort_by(normalized, | left: int, right: int | right - left)
    let highest = collections.list_get(normalized, 0)
    let top     = 0
    if option.is_some(highest) {
        top = option.option_unwrap(highest)
    }

    let lanes: Set<string> = collections.set_new()
    collections.set_insert(lanes, "platform")
    collections.set_insert(lanes, "security")
    collections.set_insert(lanes, "data")
    let lane_count = collections.set_len(lanes)

    collections.list_free(priorities)
    collections.list_free(normalized)
    collections.list_free(urgent)
    collections.set_free(lanes)
    return urgent_total + top + lane_count
}
