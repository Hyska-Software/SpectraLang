module tokenizer

import std.ml as ml
import std.string as string
import std.tensor as tensor

public func mltrain_tokenizer_score(corpus: string) returns int {
    let bpe       = ml.train_bpe(corpus, 64)
    let wordpiece = ml.train_wordpiece(corpus, 64)
    if bpe == 0 or wordpiece == 0 {
        return 0
    }
    let bpe_ids        = ml.tokenizer_encode(bpe, "spectra runtime")
    let wordpiece_ids  = ml.tokenizer_encode(wordpiece, "model training")
    let bpe_text       = ml.tokenizer_decode(bpe, bpe_ids)
    let wordpiece_text = ml.tokenizer_decode(wordpiece, wordpiece_ids)
    if string.is_empty(bpe_text) or string.is_empty(wordpiece_text) {
        return 0
    }
    return tensor.len(bpe_ids) + tensor.len(wordpiece_ids)
}
