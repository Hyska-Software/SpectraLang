module ingest

import std.ml as ml

public func mltrain_load_csv(path: string) returns int {
    return ml.dataset_from_csv(path, 2, 1)
}

public func mltrain_validate_jsonl(root: string) returns int {
    let rows = ml.dataset_from_jsonl(root + "/data/metadata.jsonl")
    if rows == 0 or ml.dataset_len(rows) != 2 {
        return 1
    }
    return 0
}
