module experiment

import std.fs as fs
import std.ml as ml
import std.result as result

public func mltrain_record_run(root: string, checkpoint: string, evaluation: string) returns string {
    let lockfile = root + "/experiment.lock"
    if result.is_err(fs.fs_write(lockfile, "spectralang=20260916\ncontract=ml-training-v1\n")) {
        return ""
    }
    let run = ml.experiment_start("ml-training-platform", root + "/experiments", 20260916)
    if run == 0 {
        return ""
    }
    ml.experiment_set_config(run, "dataset", "train.csv")
    ml.experiment_set_config(run, "optimizer", "adam")
    ml.experiment_set_config(run, "evaluation", evaluation)
    ml.experiment_set_lockfile(run, lockfile)
    ml.experiment_log_metric(run, "steps", 8.0, 8)
    ml.experiment_set_model_output(run, checkpoint)
    ml.experiment_log_artifact(run, checkpoint)
    ml.experiment_finish(run)
    return ml.experiment_manifest_path(run)
}
