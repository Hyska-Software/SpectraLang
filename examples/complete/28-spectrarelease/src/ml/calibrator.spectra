module ml.calibrator

import std.ml as ml
import std.tensor as tensor

const INPUT_WIDTH = 3
const HIDDEN_WIDTH = 8

public record Calibrator {
    public module_handle: int,
    public input_weights: int,
    public input_bias: int,
    public residual_weights: int,
    public residual_bias: int,
    public norm_scale: int,
    public norm_bias: int,
    public output_weights: int,
    public output_bias: int,
}

func parameter(values: int) returns int {
    return tensor.requires_grad(values, true)
}

public func create() returns Calibrator {
    let registry = ml.module_new()
    let input_weights = parameter(
        tensor.reshape(tensor.normal_f(INPUT_WIDTH * HIDDEN_WIDTH, 0.0, 0.15), INPUT_WIDTH, HIDDEN_WIDTH),
    )
    let input_bias = parameter(tensor.full_f(HIDDEN_WIDTH, 0.0))
    let residual_weights = parameter(
        tensor.reshape(tensor.normal_f(HIDDEN_WIDTH * HIDDEN_WIDTH, 0.0, 0.10), HIDDEN_WIDTH, HIDDEN_WIDTH),
    )
    let residual_bias = parameter(tensor.full_f(HIDDEN_WIDTH, 0.0))
    let norm_scale    = parameter(tensor.full_f(HIDDEN_WIDTH, 1.0))
    let norm_bias     = parameter(tensor.full_f(HIDDEN_WIDTH, 0.0))
    let output_weights = parameter(
        tensor.reshape(tensor.normal_f(HIDDEN_WIDTH, 0.0, 0.12), HIDDEN_WIDTH, 1),
    )
    let output_bias = parameter(tensor.full_f(1, 0.0))

    ml.module_add_parameter(registry, input_weights)
    ml.module_add_parameter(registry, input_bias)
    ml.module_add_parameter(registry, residual_weights)
    ml.module_add_parameter(registry, residual_bias)
    ml.module_add_parameter(registry, norm_scale)
    ml.module_add_parameter(registry, norm_bias)
    ml.module_add_parameter(registry, output_weights)
    ml.module_add_parameter(registry, output_bias)

    return Calibrator {
        module_handle: registry,
        input_weights: input_weights,
        input_bias: input_bias,
        residual_weights: residual_weights,
        residual_bias: residual_bias,
        norm_scale: norm_scale,
        norm_bias: norm_bias,
        output_weights: output_weights,
        output_bias: output_bias,
    }
}

public func forward(model: Calibrator, features: int, count: int, training: bool) returns int {
    ml.module_set_training(model.module_handle, training)
    if count <= 0 or tensor.len(features) != count * INPUT_WIDTH {
        return 0
    }
    let shaped    = tensor.reshape(features, count, INPUT_WIDTH)
    let projected = ml.gelu(ml.linear(shaped, model.input_weights, model.input_bias))
    let residual_branch = ml.gelu(
        ml.linear(projected, model.residual_weights, model.residual_bias),
    )
    let residual    = tensor.add(projected, residual_branch)
    let normalized  = ml.layer_norm(residual, model.norm_scale, model.norm_bias, 0.00001)
    let regularized = ml.dropout(normalized, 0.1, training)
    return tensor.flatten(ml.linear(regularized, model.output_weights, model.output_bias))
}
