// 10-matmul-bench: naive 32x32 matmul, 20 rounds, loop order i,j,k.
// A[i][j] = i+j, B[i][j] = i-j, C = A*B, all scalar (no array storage).
// C[0][0] = sum k^2 = 10416; C[31][31] = sum (k^2-961) = -20336;
// sum(C) per round = 2793472; checksum total = 20 * 2793472 = 55869440.
module bench_matmul_32

import std.io
import std.convert as c

public func main() returns int {
    let n = 32
    let iters = 20
    let total = 0
    let it = 0
    while it < iters {
        let round = 0
        let c00 = 0
        let clast = 0
        let i = 0
        while i < n {
            let j = 0
            while j < n {
                let cell = 0
                let k = 0
                while k < n {
                    cell = cell + (i + k) * (k - j)
                    k = k + 1
                }
                if i == 0 and j == 0 {
                    c00 = cell
                }
                if i == 31 and j == 31 {
                    clast = cell
                }
                round = round + cell
                j = j + 1
            }
            i = i + 1
        }
        if c00 != 10416 {
            return 1
        }
        if clast != -20336 {
            return 2
        }
        if round != 2793472 {
            return 3
        }
        total = total + round
        it = it + 1
    }
    if total != 55869440 {
        return 4
    }
    println(f"MATMUL ok n=32 sum={c.int_to_string(total)}")
    return 0
}
