// AI reference example: deterministic RAG retrieval pipeline.
module ai_rag_retrieval_pipeline

import std.ml as ml
import std.fs as fs
import std.string as str
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()

    let vocab = "[UNK]:0\nrag:1\nretrieval:2\nuses:3\nindexed:4\nchunk:5\n##s:6\nmachine:7\nlearning:8"
    let tokenizer = ml.tokenizer_wordpiece(vocab)
    let encoded = ml.tokenizer_encode(tokenizer, "rag retrieval uses indexed chunks")
    let decoded = ml.tokenizer_decode(tokenizer, encoded)
    if str.contains(decoded, "rag retrieval uses indexed chunks") {
        let ok_decode = 1
        if ok_decode != 1 {
            return 1
        }
    } else {
        return 1
    }

    let index = ml.vector_index_new(16)
    if not ml.vector_index_set_metadata(index, "model_version", "rag-baseline-v1") {
        return 1
    }
    let doc_a = "RAG retrieval uses indexed chunks to find context."
    let doc_b = "Machine learning models optimize numerical objectives."
    let doc_a_vec = tensor.full_f(16, 1.0)
    let doc_b_vec = tensor.concat(tensor.full_f(8, 1.0), tensor.full_f(8, 0.0))
    ml.vector_index_insert(index, "doc-rag", doc_a_vec)
    ml.vector_index_insert(index, "doc-ml", doc_b_vec)

    let query   = "What does RAG retrieval use?"
    let results = ml.vector_index_query(index, tensor.full_f(16, 1.0), 1)
    if str.contains(results, "doc-rag") {
        let ok_retrieval = 1
        if ok_retrieval != 1 {
            return 2
        }
    } else {
        return 2
    }

    let chunks = ml.rag_chunk_text(doc_a, 24, 4)
    let prompt = ml.rag_build_prompt(chunks, query)
    if str.contains(prompt, "Context:") {
        let ok_prompt = 1
        if ok_prompt != 1 {
            return 3
        }
    } else {
        return 3
    }

    // Model-call boundary for this baseline: downstream model receives the prompt
    // and returns an answer that is evaluated by the runtime RAG metric.
    let answer = "RAG retrieval uses indexed chunks"
    let score  = ml.rag_evaluate_answer(answer, "retrieval uses indexed chunks")
    if score < 700 {
        return 4
    }

    let persisted      = ml.vector_index_persist(index, "target/ai-examples/rag/vector-index.spar")
    let loaded         = ml.vector_index_load(persisted)
    let loaded_results = ml.vector_index_query(loaded, tensor.full_f(16, 1.0), 1)
    if str.contains(loaded_results, "doc-rag") {
        fs.fs_write("target/ai-examples/rag/report.txt", "spectralang rag pipeline\nretrieved=doc-rag\nscore=pass\n")
        tensor.free_all()
        return 0
    }

    tensor.free_all()
    return 5
}
