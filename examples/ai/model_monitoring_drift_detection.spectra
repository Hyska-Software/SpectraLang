module model_monitoring_drift_detection

import std.fs as fs
import std.tensor as tensor
import std.serve as serve
import std.string as str

public func main() returns int {
    serve.reset()

    // ServeReal requires an explicitly registered model: y = relu(2*x + 0),
    // matching the expected scaling used by every assertion below.
    let model_weight = tensor.full2_f(1, 1, 2.0)
    let model_biases = tensor.full_f(1, 0.0)

    let reference_server = serve.server_new(2)
    serve.server_set_model_version(reference_server, "fraud-detector-v1")
    if serve.server_register_model_linear(reference_server, model_weight, model_biases, 0) != 1 {
        return 7
    }
    serve.server_warmup(reference_server)
    let ref_a = serve.server_enqueue(reference_server, 10)
    let ref_b = serve.server_enqueue(reference_server, 20)
    serve.server_process_batch(reference_server, 2)
    if serve.server_result(reference_server, ref_a) != 20 {
        return 1
    }
    if serve.server_result(reference_server, ref_b) != 40 {
        return 2
    }

    let reference = serve.server_distribution_summary(reference_server)

    let live_server = serve.server_new(2)
    serve.server_set_model_version(live_server, "fraud-detector-v1")
    serve.server_warmup(live_server)
    if serve.server_register_model_linear(live_server, model_weight, model_biases, 0) != 1 {
        return 8
    }
    let live_a = serve.server_enqueue(live_server, 120)
    let live_b = serve.server_enqueue(live_server, 140)
    serve.server_process_batch(live_server, 2)
    if serve.server_result(live_server, live_a) != 240 {
        return 3
    }
    if serve.server_result(live_server, live_b) != 280 {
        return 4
    }

    let live     = serve.server_distribution_summary(live_server)
    let drift    = serve.drift_check(reference, live, 100)
    let audit    = serve.server_audit_log(live_server)
    let exported = serve.export_monitoring(
        live_server,
        "target/ai-examples/monitoring/model-monitoring.json",
        live,
        drift,
        audit
    )

    if str.contains(drift, "\"drifted\":true") {
        fs.fs_write(
            "target/ai-examples/monitoring/summary.txt",
            "model_monitoring=pass\ndrifted=true\n"
        )
    } else {
        return 5
    }

    if str.contains(exported, "model-monitoring.json") {
        return 0
    }
    return 6
}
