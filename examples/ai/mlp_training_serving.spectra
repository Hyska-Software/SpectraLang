// AI reference example: tiny MLP-style training loop + local serving smoke.
module ai_mlp_training_serving

import std.tensor as tensor
import std.ml as ml
import std.serve as serve
import std.fs as fs

func train_step(x: int, target: int, weight: int, bias: int) returns int {
    let prediction = ml.linear(x, weight, bias)
    let loss       = ml.mse_loss(prediction, target)
    tensor.backward(loss)
    ml.sgd_step(weight, 0.1)
    ml.sgd_step(bias, 0.1)
    return 0
}

public func main() returns int {
    tensor.free_all()
    tensor.set_grad_enabled( true)
    serve.reset()

    let model_handle = ml.module_new()
    // Ranged regression inputs let the optimizer learn the true slope and
    // intercept of f(x) = 2x instead of a degenerate constant-only solution.
    let x: Tensor<float, rank2, dim4, dim1, row_major, cpu> = [[1.0], [2.0], [3.0], [4.0]]
    let target: Tensor<float, rank1, dim4, row_major, cpu>  = [2.0, 4.0, 6.0, 8.0]
    let weight       = tensor.reshape(tensor.requires_grad(tensor.full_f(1, 0.0), true), 1, 1)
    let bias         = tensor.requires_grad(tensor.full_f(1, 0.0), true)

    ml.module_add_parameter(model_handle, weight)
    ml.module_add_parameter(model_handle, bias)
    if ml.module_parameter_count(model_handle) != 2 {
        return 1
    }

    let dataset = ml.dataset_from_tensors(x, target, 4)
    let loader  = ml.dataloader_new(dataset, 2, 2026)
    if ml.dataloader_batch_count(loader) != 2 {
        return 2
    }

    // Train until convergence: the slow bias eigenmode decays as ~0.97^n,
    // so a few hundred full-batch steps settle w -> 2 and b -> 0 tightly
    // enough that the served REAL weights reproduce y(21) = 42 below.
    let steps = 0
    while steps < 200 {
        train_step(x, target, weight, bias)
        steps = steps + 1
    }

    let final_prediction = ml.linear(x, weight, bias)
    if tensor.len(final_prediction) != 4 {
        return 3
    }

    let server = serve.server_new(2)
    serve.server_warmup(server)
    let request = serve.server_enqueue(server, 21)
    if serve.server_register_model_linear(server, weight, bias, 0) != 1 {
        return 6
    }
    if serve.server_process_batch(server, 1) != 1 {
        return 4
    }
    if serve.server_result(server, request) != 42 {
        return 5
    }

    fs.fs_write("target/ai-examples/mlp_training_serving_model.txt", "spectralang mlp training serving model\nparameters=2\nserver_model=2\n")

    tensor.free_all()
    return 0
}
