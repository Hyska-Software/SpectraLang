// AI reference example: export and re-import a supported ONNX transformer block.
module ai_onnx_transformer_export

import std.ml as ml
import std.string as str
import std.tensor as tensor
import std.collections as collections

public func main() returns int {
    let trans_scale = tensor.full_f(8, 1.0)
    let trans_bias = tensor.full_f(8, 0.0)
    let trans_weights = collections.list_new()
    collections.list_push(trans_weights, trans_scale)
    collections.list_push(trans_weights, trans_bias)
    let model = ml.onnx_export_weights("target/ai-examples/onnx/transformer.onnx", "transformer", trans_weights)
    if ml.onnx_validate(model) != 1 {
        return 1
    }

    let summary = ml.onnx_import_summary(model)
    if str.contains(summary, "MatMul") {
        let ok_matmul = 1
        if ok_matmul != 1 {
            return 2
        }
    } else {
        return 2
    }
    if str.contains(summary, "Softmax") {
        let ok_attention = 1
        if ok_attention != 1 {
            return 3
        }
    } else {
        return 3
    }
    if str.contains(summary, "Gelu") {
        let ok_ffn = 1
        if ok_ffn != 1 {
            return 4
        }
    } else {
        return 4
    }

    let roundtrip = ml.onnx_roundtrip(model, "target/ai-examples/onnx/transformer.roundtrip.onnx")
    if ml.onnx_validate(roundtrip) != 1 {
        return 5
    }
    return 0
}
