// Advanced AI example: reproducible dataflow plus distributed training
// checkpoint, resume, worker progress, and topology summary.
module advanced_phase17_distributed_reproducible_dataflow

import std.fs as fs
import std.ml as ml
import std.string as str
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()

    let features = tensor.reshape(tensor.full_f(8, 1.0), 4, 2)
    let labels   = tensor.reshape(tensor.full_f(4, 1.0), 4, 1)
    let dataset  = ml.dataset_from_tensors(features, labels, 4)
    let train    = ml.dataset_train_split(dataset, 3)
    let loader   = ml.dataloader_new(train, 2, 1703)
    if ml.dataloader_batch_count(loader) != 2 {
        return 1
    }
    if tensor.len(ml.dataloader_batch_features(loader, 0)) != 4 {
        return 2
    }

    // Real data-parallel training: three OS-thread workers each run genuine
    // forward/backward passes over a deterministic shard and ALLREDUCE-average
    // the gradients every step (72 samples, features=4, one global step).
    let session = ml.distributed_train_multithread(
        "advanced-phase17-distributed-dataflow",
        "target/ai-examples/advanced-phase17",
        3,
        1,
        0.30,
        4,
        72,
        1703
    )
    if ml.distributed_global_step(session) != 1 {
        return 3
    }
    if ml.distributed_worker_step_count(session, 2) != 1 {
        return 4
    }

    let checkpoint = ml.distributed_checkpoint_save(
        session,
        "target/ai-examples/advanced-phase17/checkpoint.json",
        2
    )
    let checkpoint_result = fs.fs_read(checkpoint)
    if let Result::Ok(checkpoint_text) = checkpoint_result {
        if str.contains(checkpoint_text, "\"interrupted_worker\":2") {
            let ok_interrupted = 1
            if ok_interrupted != 1 {
                return 5
            }
        } else {
            return 5
        }
    } else {
        return 5
    }
    let resumed = ml.distributed_resume(checkpoint)
    // Resume replays the persisted worker state; a second real training
    // round advances every worker to two completed steps.
    if ml.distributed_train_multithread(
        "advanced-phase17-distributed-dataflow-resume",
        "target/ai-examples/advanced-phase17",
        3,
        1,
        0.20,
        4,
        72,
        1704
    ) < 0 {
        return 6
    }
    if ml.distributed_global_step(resumed) != 1 {
        return 6
    }

    let summary = ml.distributed_summary(resumed)
    if str.contains(summary, "\"worker_count\":3") {
        let ok_workers = 1
        if ok_workers != 1 {
            return 7
        }
    } else {
        return 7
    }
    if str.contains(summary, "\"total_samples\":72") {
        let ok_samples = 1
        if ok_samples != 1 {
            return 8
        }
    } else {
        return 8
    }

    fs.fs_write(
        "target/ai-examples/advanced-phase17/summary.txt",
        "advanced_phase17_distributed_reproducible_dataflow=pass\n"
    )

    tensor.free_all()
    return 0
}
