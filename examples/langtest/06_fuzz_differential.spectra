module fuzz_differential

from std.io import println

// Fuzzing deterministico + diferencial + metamorfico + cobertura.
// LCG gera expressoes NUM(OP NUM)*; dois avaliadores independentes
// (recursivo LL(1) vs Pratt) precisam concordar. EMI: x+0==x, x*1==x.

func next_rand(state: [int]) returns int {
    state[0] = (state[0] * 1103515245 + 12345) % 2147483648
    return state[0]
}

func rand_range(state: [int], lo: int, hi: int) returns int {
    let r = next_rand(state)
    return lo + r % (hi - lo + 1)
}

func rec_e(kinds: [int], values: [int], pos: [int]) returns int {
    let value = rec_t(kinds, values, pos)
    while true {
        let kind = kinds[pos[0]]
        if kind != 1 and kind != 2 {
            return value
        }
        pos[0] = pos[0] + 1
        let right = rec_t(kinds, values, pos)
        if kind == 1 {
            value = value + right
        } else {
            value = value - right
        }
    }
    return value
}

func rec_t(kinds: [int], values: [int], pos: [int]) returns int {
    let value = rec_f(kinds, values, pos)
    while true {
        let kind = kinds[pos[0]]
        if kind != 3 and kind != 4 and kind != 5 {
            return value
        }
        pos[0] = pos[0] + 1
        let right = rec_f(kinds, values, pos)
        if kind == 3 {
            value = value * right
        } else {
            if kind == 4 {
                value = value / right
            } else {
                value = value % right
            }
        }
    }
    return value
}

func rec_f(kinds: [int], values: [int], pos: [int]) returns int {
    if kinds[pos[0]] != 0 {
        return 0
    }
    let value = values[pos[0]]
    pos[0] = pos[0] + 1
    return value
}

func eval_rec(kinds: [int], values: [int]) returns int {
    let pos = [0]
    return rec_e(kinds, values, pos)
}

func pprec(op: int) returns int {
    if op == 1 or op == 2 {
        return 1
    }
    if op == 3 or op == 4 or op == 5 {
        return 2
    }
    return 0
}

func papply(op: int, lhs: int, rhs: int) returns int {
    if op == 1 {
        return lhs + rhs
    }
    if op == 2 {
        return lhs - rhs
    }
    if op == 3 {
        return lhs * rhs
    }
    if op == 4 {
        return lhs / rhs
    }
    return lhs % rhs
}

func pexpr(kinds: [int], values: [int], pos: [int], min_prec: int) returns int {
    let lhs = values[pos[0]]
    pos[0] = pos[0] + 1
    while true {
        let op = kinds[pos[0]]
        let p  = pprec(op)
        if p < min_prec or p == 0 {
            return lhs
        }
        pos[0] = pos[0] + 1
        let rhs = pexpr(kinds, values, pos, p + 1)
        lhs = papply(op, lhs, rhs)
    }
    return lhs
}

func eval_pratt(kinds: [int], values: [int]) returns int {
    let pos = [0]
    return pexpr(kinds, values, pos, 1)
}

public func main() returns int {
    let state  = [42]
    let cov    = [0, 0, 0, 0, 0]
    let kinds  = [0, 0, 0, 0, 0, 0, 0, 0]
    let values = [0, 0, 0, 0, 0, 0, 0, 0]
    let trial  = 0
    while trial < 40 {
        let i = 0
        while i < 4 {
            values[i * 2] = rand_range(state, 1, 9)
            kinds[i * 2] = 0
            if i < 3 {
                let op = rand_range(state, 1, 5)
                kinds[i * 2 + 1] = op
                values[i * 2 + 1] = 0
                cov[op - 1] = cov[op - 1] + 1
            }
            i = i + 1
        }
        kinds[7] = 8
        values[7] = 0
        if eval_rec(kinds, values) != eval_pratt(kinds, values) {
            return 10
        }
        trial = trial + 1
    }
    let op = 1
    while op <= 5 {
        if cov[op - 1] == 0 {
            let fk = [0, 0, 0, 8, 0, 0, 0, 0]
            let fv = [2, 0, 3, 0, 0, 0, 0, 0]
            fk[1] = op
            if eval_rec(fk, fv) != eval_pratt(fk, fv) {
                return 20
            }
            cov[op - 1] = 1
        }
        op = op + 1
    }
    if cov[0] == 0 or cov[1] == 0 or cov[2] == 0 or cov[3] == 0 or cov[4] == 0 {
        return 21
    }
    let mk = [0, 1, 0, 3, 0, 8, 0, 0]
    let mv = [6, 0, 2, 0, 7, 0, 0, 0]
    if eval_rec(mk, mv) != 20 or eval_pratt(mk, mv) != 20 {
        return 30
    }
    mk[1] = 3
    if eval_rec(mk, mv) != 84 or eval_pratt(mk, mv) != 84 {
        return 31
    }
    let bk   = [0, 1, 0, 8, 0, 0, 0, 0]
    let bv   = [4, 0, 5, 0, 0, 0, 0, 0]
    let base = eval_rec(bk, bv)
    let ek   = [0, 1, 0, 1, 0, 8, 0, 0]
    let ev   = [4, 0, 5, 0, 0, 0, 0, 0]
    if eval_rec(ek, ev) != base or eval_pratt(ek, ev) != base {
        return 40
    }
    let tk = [0, 1, 0, 3, 0, 8, 0, 0]
    let tv = [4, 0, 5, 0, 1, 0, 0, 0]
    if eval_rec(tk, tv) != base or eval_pratt(tk, tv) != base {
        return 41
    }
    println("PASS fuzz_differential: 40 casos + mutacao + EMI concordam")
    return 0
}
