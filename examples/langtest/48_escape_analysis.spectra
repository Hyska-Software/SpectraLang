module escape_analysis

from std.io import println

// Escape analysis (promocao p/ stack do backend): kinds 0=local 1=arg de
// chamada 2=global 3=store-into(target). o0 global, o1 arg, o2 guardado em
// o0 (propaga), o3 so local => stack. Ponto fixo.

public func main() returns int {
    let kind    = [2, 1, 3, 0]
    let target  = [-1, -1, 0, -1]
    let escapes = [0, 0, 0, 0]
    let changed = 1
    let iter    = 0
    while changed == 1 and iter < 10 {
        changed = 0
        iter = iter + 1
        let o = 0
        while o < 4 {
            let esc = 0
            if kind[o] == 1 or kind[o] == 2 {
                esc = 1
            }
            if kind[o] == 3 and target[o] >= 0 and escapes[target[o]] == 1 {
                esc = 1
            }
            if esc != escapes[o] {
                escapes[o] = esc
                changed = 1
            }
            o = o + 1
        }
    }
    if iter >= 10 {
        return 1
    }
    if escapes[0] != 1 or escapes[1] != 1 or escapes[2] != 1 {
        return 2
    }
    if escapes[3] != 0 {
        return 3
    }
    println("PASS escape_analysis: 3 escapam, 1 fica na stack")
    return 0
}
