module hungarian_assignment

from std.io import println

// Hungarian algorithm for a square minimum-cost assignment.
// Potentials and alternating paths are kept in fixed arrays for a compact,
// deterministic witness of the O(n^3) augmenting procedure.

func solve(cost: [int], n: int, assignment: [int]) returns int {
    let u           = [0, 0, 0, 0, 0]
    let v           = [0, 0, 0, 0, 0]
    let matched_row = [0, 0, 0, 0, 0]
    let way         = [0, 0, 0, 0, 0]
    let row         = 1
    while row <= n {
        matched_row[0] = row
        let column    = 0
        let min_value = [1000000, 1000000, 1000000, 1000000, 1000000]
        let used      = [0, 0, 0, 0, 0]
        while true {
            used[column] = 1
            let current_row = matched_row[column]
            let delta       = 1000000
            let next_column = 0
            let candidate   = 1
            while candidate <= n {
                if used[candidate] == 0 {
                    let reduced = cost[(current_row - 1) * n + candidate - 1] -
                        u[current_row] -
                        v[candidate]
                    if reduced < min_value[candidate] {
                        min_value[candidate] = reduced
                        way[candidate] = column
                    }
                    if min_value[candidate] < delta {
                        delta = min_value[candidate]
                        next_column = candidate
                    }
                }
                candidate = candidate + 1
            }
            let adjust = 0
            while adjust <= n {
                if used[adjust] == 1 {
                    u[matched_row[adjust]] = u[matched_row[adjust]] + delta
                    v[adjust] = v[adjust] - delta
                } else if adjust > 0 {
                    min_value[adjust] = min_value[adjust] - delta
                }
                adjust = adjust + 1
            }
            column = next_column
            if matched_row[column] == 0 {
                break
            }
        }
        while true {
            let previous = way[column]
            matched_row[column] = matched_row[previous]
            column = previous
            if column == 0 {
                break
            }
        }
        row = row + 1
    }
    let total  = 0
    let column = 1
    while column <= n {
        assignment[matched_row[column] - 1] = column - 1
        total = total + cost[(matched_row[column] - 1) * n + column - 1]
        column = column + 1
    }
    return total
}

public func main() returns int {
    let cost       = [4, 1, 3, 2, 0, 5, 3, 3, 2]
    let assignment = [0, 0, 0]
    if solve(cost, 3, assignment) != 5 {
        return 1
    }
    if assignment[0] != 1 or assignment[1] != 0 or assignment[2] != 2 {
        return 2
    }
    if assignment[0] == assignment[1] or assignment[0] == assignment[2] or assignment[1] == assignment[2] {
        return 3
    }
    println("PASS hungarian_assignment: minimum cost + augmenting paths")
    return 0
}
