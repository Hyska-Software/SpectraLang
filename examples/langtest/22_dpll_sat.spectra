module dpll_sat

from std.io import println

// DPLL com unit propagation + pure literals + splitting, sobre CNF com
// clausulas de ate 3 literais (pad -1). Literal = var*2+sign (0=pos,1=neg).
// assign: -1=livre, 0=false, 1=true. O modelo volta no proprio assign.

func lit_state(lit: int, assign: [int]) returns int {
    let v = lit / 2
    let s = lit % 2
    if assign[v] == -1 {
        return-1
    }
    if s == 0 {
        return assign[v]
    }
    if assign[v] == 1 {
        return 0
    }
    return 1
}

func copy_assign(src: [int], dst: [int], n: int) {
    let i = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}

func check_all(clauses: [int], nclauses: int, csize: int, assign: [int]) returns bool {
    let c = 0
    while c < nclauses {
        let sat = 0
        let k   = 0
        while k < csize {
            let lit = clauses[c * csize + k]
            if lit != -1 and lit_state(lit, assign) == 1 {
                sat = 1
            }
            k = k + 1
        }
        if sat == 0 {
            return false
        }
        c = c + 1
    }
    return true
}

func dpll(clauses: [int], nclauses: int, csize: int, assign: [int], nvars: int) returns bool {
    let progress = 1
    while progress == 1 {
        progress = 0
        let c = 0
        while c < nclauses {
            let has_true = 0
            let nun      = 0
            let ulit     = -1
            let k        = 0
            while k < csize {
                let lit = clauses[c * csize + k]
                if lit != -1 {
                    let st = lit_state(lit, assign)
                    if st == 1 {
                        has_true = 1
                    }
                    if st == -1 {
                        nun = nun + 1
                        ulit = lit
                    }
                }
                k = k + 1
            }
            if has_true == 0 {
                if nun == 0 {
                    return false
                }
                if nun == 1 {
                    let v = ulit / 2
                    if ulit % 2 == 0 {
                        assign[v] = 1
                    } else {
                        assign[v] = 0
                    }
                    progress = 1
                }
            }
            c = c + 1
        }
        let v = 0
        while v < nvars {
            if assign[v] == -1 {
                let ppos = 0
                let pneg = 0
                let c2   = 0
                while c2 < nclauses {
                    let k2 = 0
                    while k2 < csize {
                        let lit = clauses[c2 * csize + k2]
                        if lit != -1 and lit / 2 == v {
                            if lit % 2 == 0 {
                                ppos = 1
                            } else {
                                pneg = 1
                            }
                        }
                        k2 = k2 + 1
                    }
                    c2 = c2 + 1
                }
                if ppos == 1 and pneg == 0 {
                    assign[v] = 1
                    progress = 1
                }
                if ppos == 0 and pneg == 1 {
                    assign[v] = 0
                    progress = 1
                }
            }
            v = v + 1
        }
    }
    let v = 0
    while v < nvars {
        if assign[v] == -1 {
            break
        }
        v = v + 1
    }
    if v == nvars {
        return check_all(clauses, nclauses, csize, assign)
    }
    let branch = [-1, -1, -1, -1]
    copy_assign(assign, branch, nvars)
    branch[v] = 1
    if dpll(clauses, nclauses, csize, branch, nvars) {
        copy_assign(branch, assign, nvars)
        return true
    }
    assign[v] = 0
    return dpll(clauses, nclauses, csize, assign, nvars)
}

public func main() returns int {
    let sat_f = [0, 2, -1, 1, 4, -1, 3, 5, -1]
    let a1    = [-1, -1, -1]
    if not dpll(sat_f, 3, 3, a1, 3) {
        return 1
    }
    if not check_all(sat_f, 3, 3, a1) {
        return 2
    }
    let unsat_f = [0, -1, -1, 1, -1, -1]
    let a2      = [-1, -1, -1]
    if dpll(unsat_f, 2, 3, a2, 3) {
        return 3
    }
    println("PASS dpll_sat: unit+pure+splitting decide SAT/UNSAT")
    return 0
}
