module reaching_definitions

from std.io import println

// Reaching definitions (dataflow forward, may-analysis), dual do liveness.
// CFG: B0->B1, B1->B2|B3, B2->B3, B3=saida.
// d1: x em B0 | d2: y em B1 | d3: y em B2 (redefine y, mata d2).
// OUT = GEN uniao (IN - KILL); IN = uniao dos OUT dos predecessores.

public func main() returns int {
    let gen_d1      = [1, 0, 0, 0]
    let kill_d1     = [0, 0, 0, 0]
    let gen_d2      = [0, 1, 0, 0]
    let kill_d2     = [0, 0, 1, 0]
    let gen_d3      = [0, 0, 1, 0]
    let kill_d3     = [0, 1, 0, 0]
    let pred_first  = [-1, 0, 1, 1]
    let pred_second = [-1, -1, -1, 2]
    let in_d1       = [0, 0, 0, 0]
    let out_d1      = [0, 0, 0, 0]
    let in_d2       = [0, 0, 0, 0]
    let out_d2      = [0, 0, 0, 0]
    let in_d3       = [0, 0, 0, 0]
    let out_d3      = [0, 0, 0, 0]
    let changed     = 1
    let iter        = 0
    while changed == 1 and iter < 10 {
        changed = 0
        iter = iter + 1
        let b = 0
        while b <= 3 {
            let new_in_d1 = 0
            let p         = pred_first[b]
            if p != -1 {
                if out_d1[p] == 1 {
                    new_in_d1 = 1
                }
            }
            p = pred_second[b]
            if p != -1 {
                if out_d1[p] == 1 {
                    new_in_d1 = 1
                }
            }
            let new_out_d1 = gen_d1[b]
            if new_out_d1 == 0 and new_in_d1 == 1 and kill_d1[b] == 0 {
                new_out_d1 = 1
            }
            let new_in_d2 = 0
            p = pred_first[b]
            if p != -1 {
                if out_d2[p] == 1 {
                    new_in_d2 = 1
                }
            }
            p = pred_second[b]
            if p != -1 {
                if out_d2[p] == 1 {
                    new_in_d2 = 1
                }
            }
            let new_out_d2 = gen_d2[b]
            if new_out_d2 == 0 and new_in_d2 == 1 and kill_d2[b] == 0 {
                new_out_d2 = 1
            }
            let new_in_d3 = 0
            p = pred_first[b]
            if p != -1 {
                if out_d3[p] == 1 {
                    new_in_d3 = 1
                }
            }
            p = pred_second[b]
            if p != -1 {
                if out_d3[p] == 1 {
                    new_in_d3 = 1
                }
            }
            let new_out_d3 = gen_d3[b]
            if new_out_d3 == 0 and new_in_d3 == 1 and kill_d3[b] == 0 {
                new_out_d3 = 1
            }
            if new_in_d1 != in_d1[b] or new_out_d1 != out_d1[b] {
                changed = 1
            }
            if new_in_d2 != in_d2[b] or new_out_d2 != out_d2[b] {
                changed = 1
            }
            if new_in_d3 != in_d3[b] or new_out_d3 != out_d3[b] {
                changed = 1
            }
            in_d1[b] = new_in_d1
            out_d1[b] = new_out_d1
            in_d2[b] = new_in_d2
            out_d2[b] = new_out_d2
            in_d3[b] = new_in_d3
            out_d3[b] = new_out_d3
            b = b + 1
        }
    }
    if iter >= 10 {
        return 1
    }
    if in_d1[0] != 0 or in_d2[0] != 0 or in_d3[0] != 0 {
        return 2
    }
    if out_d1[0] != 1 or out_d2[0] != 0 or out_d3[0] != 0 {
        return 3
    }
    if in_d1[1] != 1 or out_d2[1] != 1 {
        return 4
    }
    if out_d2[2] != 0 or out_d3[2] != 1 {
        return 5
    }
    if in_d2[3] != 1 or in_d3[3] != 1 or out_d1[3] != 1 {
        return 6
    }
    println("PASS reaching_definitions: forward may-analysis converge")
    return 0
}
