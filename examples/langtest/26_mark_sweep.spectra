module mark_sweep

from std.io import println

// Mark-and-sweep sobre heap brinquedo (teste do runtime de memoria):
// mark iterativo com worklist a partir das raizes, sweep libera o resto.
// Objs 0..4 alcancaveis de 0; 5->6 eh ilha inalancavel.

func mark_phase(roots: [int], nroots: int, ref1: [int], ref2: [int], mark: [int], stack: [int]) {
    let sp = 0
    let r  = 0
    while r < nroots {
        let o = roots[r]
        if o != -1 and mark[o] == 0 {
            mark[o] = 1
            stack[sp] = o
            sp = sp + 1
        }
        r = r + 1
    }
    while sp > 0 {
        sp = sp - 1
        let o = stack[sp]
        if ref1[o] != -1 and mark[ref1[o]] == 0 {
            mark[ref1[o]] = 1
            stack[sp] = ref1[o]
            sp = sp + 1
        }
        if ref2[o] != -1 and mark[ref2[o]] == 0 {
            mark[ref2[o]] = 1
            stack[sp] = ref2[o]
            sp = sp + 1
        }
    }
}

func sweep(alloc: [int], mark: [int], n: int) returns int {
    let freed = 0
    let i     = 0
    while i < n {
        if alloc[i] == 1 and mark[i] == 0 {
            alloc[i] = 0
            freed = freed + 1
        }
        i = i + 1
    }
    return freed
}

public func main() returns int {
    let alloc = [1, 1, 1, 1, 1, 1, 1, 0]
    let mark  = [0, 0, 0, 0, 0, 0, 0, 0]
    let ref1  = [1, 3, 3, -1, -1, 6, -1, -1]
    let ref2  = [2, -1, 4, -1, -1, -1, -1, -1]
    let roots = [0, -1]
    let stack = [0, 0, 0, 0, 0, 0, 0, 0]
    mark_phase(roots, 2, ref1, ref2, mark, stack)
    if mark[0] != 1 or mark[1] != 1 or mark[2] != 1 or mark[3] != 1 or mark[4] != 1 {
        return 1
    }
    if mark[5] != 0 or mark[6] != 0 {
        return 2
    }
    if sweep(alloc, mark, 8) != 2 {
        return 3
    }
    if alloc[0] != 1 or alloc[3] != 1 or alloc[4] != 1 {
        return 4
    }
    if alloc[5] != 0 or alloc[6] != 0 {
        return 5
    }
    println("PASS mark_sweep: worklist marca 5, sweep libera ilha")
    return 0
}
