module dataflow_liveness

from std.io import println

// Liveness backward may-analysis por ponto fixo iterativo.
// CFG diamante: B0->B1, B1->B2|B3, B2->B3, B3=saida.
// B0: a=1 | B1: b=a+1 | B2: c=b+1 | B3: uso(b,c).
// Sem bitsets: um array 0/1 por variavel (sem bitwise na linguagem).

public func main() returns int {
    let gen_a       = [0, 1, 0, 0]
    let kill_a      = [1, 0, 0, 0]
    let gen_b       = [0, 0, 1, 1]
    let kill_b      = [0, 1, 0, 0]
    let gen_c       = [0, 0, 0, 1]
    let kill_c      = [0, 0, 1, 0]
    let succ_first  = [1, 2, 3, -1]
    let succ_second = [-1, 3, -1, -1]
    let in_a        = [0, 0, 0, 0]
    let out_a       = [0, 0, 0, 0]
    let in_b        = [0, 0, 0, 0]
    let out_b       = [0, 0, 0, 0]
    let in_c        = [0, 0, 0, 0]
    let out_c       = [0, 0, 0, 0]
    let changed     = 1
    let iter        = 0
    while changed == 1 and iter < 10 {
        changed = 0
        iter = iter + 1
        let b = 3
        while b >= 0 {
            let new_out_a = 0
            let s         = succ_first[b]
            if s != -1 {
                if in_a[s] == 1 {
                    new_out_a = 1
                }
            }
            s = succ_second[b]
            if s != -1 {
                if in_a[s] == 1 {
                    new_out_a = 1
                }
            }
            let new_in_a = gen_a[b]
            if new_in_a == 0 and new_out_a == 1 and kill_a[b] == 0 {
                new_in_a = 1
            }
            let new_out_b = 0
            s = succ_first[b]
            if s != -1 {
                if in_b[s] == 1 {
                    new_out_b = 1
                }
            }
            s = succ_second[b]
            if s != -1 {
                if in_b[s] == 1 {
                    new_out_b = 1
                }
            }
            let new_in_b = gen_b[b]
            if new_in_b == 0 and new_out_b == 1 and kill_b[b] == 0 {
                new_in_b = 1
            }
            let new_out_c = 0
            s = succ_first[b]
            if s != -1 {
                if in_c[s] == 1 {
                    new_out_c = 1
                }
            }
            s = succ_second[b]
            if s != -1 {
                if in_c[s] == 1 {
                    new_out_c = 1
                }
            }
            let new_in_c = gen_c[b]
            if new_in_c == 0 and new_out_c == 1 and kill_c[b] == 0 {
                new_in_c = 1
            }
            if new_out_a != out_a[b] or new_in_a != in_a[b] {
                changed = 1
            }
            if new_out_b != out_b[b] or new_in_b != in_b[b] {
                changed = 1
            }
            if new_out_c != out_c[b] or new_in_c != in_c[b] {
                changed = 1
            }
            out_a[b] = new_out_a
            in_a[b] = new_in_a
            out_b[b] = new_out_b
            in_b[b] = new_in_b
            out_c[b] = new_out_c
            in_c[b] = new_in_c
            b = b - 1
        }
    }
    if iter >= 10 {
        return 1
    }
    if in_b[3] != 1 or in_c[3] != 1 {
        return 2
    }
    if in_a[3] != 0 {
        return 3
    }
    if in_a[1] != 1 {
        return 4
    }
    if in_b[1] != 0 {
        return 5
    }
    if in_a[0] != 0 {
        return 6
    }
    if out_a[0] != 1 or out_c[0] != 1 {
        return 7
    }
    println("PASS dataflow_liveness: ponto fixo converge e valida equacoes")
    return 0
}
