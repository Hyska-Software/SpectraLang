module constprop_lattice

from std.io import println

// Constant propagation: must-analysis forward sobre reticulado plano
// TOP=0 (desconhecido) > CONST=1 > BOT=2 (conflito). Meet de predecessores.
// CFG diamante: B0:x=5 | B1:y=x+1 | B2:x=entrada(BOT) | B3:encontro.

func meet_tag(t1: int, v1: int, t2: int, v2: int) returns int {
    if t1 == 0 {
        return t2
    }
    if t2 == 0 {
        return t1
    }
    if t1 == 2 or t2 == 2 {
        return 2
    }
    if v1 == v2 {
        return 1
    }
    return 2
}

func meet_val(t1: int, v1: int, t2: int, v2: int) returns int {
    if t1 == 0 {
        return v2
    }
    if t2 == 0 {
        return v1
    }
    if t1 == 2 or t2 == 2 {
        return 0
    }
    if v1 == v2 {
        return v1
    }
    return 0
}

public func main() returns int {
    let pred_first  = [-1, 0, 1, 1]
    let pred_second = [-1, -1, -1, 2]
    let in_xt       = [0, 0, 0, 0]
    let in_xv       = [0, 0, 0, 0]
    let out_xt      = [0, 0, 0, 0]
    let out_xv      = [0, 0, 0, 0]
    let in_yt       = [0, 0, 0, 0]
    let in_yv       = [0, 0, 0, 0]
    let out_yt      = [0, 0, 0, 0]
    let out_yv      = [0, 0, 0, 0]
    let changed     = 1
    let iter        = 0
    while changed == 1 and iter < 10 {
        changed = 0
        iter = iter + 1
        let b = 0
        while b <= 3 {
            let p  = pred_first[b]
            let nt = 0
            let nv = 0
            if p != -1 {
                nt = out_xt[p]
                nv = out_xv[p]
            }
            p = pred_second[b]
            if p != -1 {
                nt = meet_tag(nt, nv, out_xt[p], out_xv[p])
                nv = meet_val(nt, nv, out_xt[p], out_xv[p])
            }
            let new_out_xt = nt
            let new_out_xv = nv
            if b == 0 {
                new_out_xt = 1
                new_out_xv = 5
            }
            if b == 2 {
                new_out_xt = 2
                new_out_xv = 0
            }
            let q  = pred_first[b]
            let mt = 0
            let mv = 0
            if q != -1 {
                mt = out_yt[q]
                mv = out_yv[q]
            }
            q = pred_second[b]
            if q != -1 {
                mt = meet_tag(mt, mv, out_yt[q], out_yv[q])
                mv = meet_val(mt, mv, out_yt[q], out_yv[q])
            }
            let new_out_yt = mt
            let new_out_yv = mv
            if b == 1 {
                if nt == 1 {
                    new_out_yt = 1
                    new_out_yv = nv + 1
                } else {
                    if nt == 2 {
                        new_out_yt = 2
                        new_out_yv = 0
                    } else {
                        new_out_yt = 0
                        new_out_yv = 0
                    }
                }
            }
            if new_out_xt != out_xt[b] or new_out_xv != out_xv[b] {
                changed = 1
            }
            if new_out_yt != out_yt[b] or new_out_yv != out_yv[b] {
                changed = 1
            }
            if nt != in_xt[b] or nv != in_xv[b] {
                changed = 1
            }
            if mt != in_yt[b] or mv != in_yv[b] {
                changed = 1
            }
            in_xt[b] = nt
            in_xv[b] = nv
            out_xt[b] = new_out_xt
            out_xv[b] = new_out_xv
            in_yt[b] = mt
            in_yv[b] = mv
            out_yt[b] = new_out_yt
            out_yv[b] = new_out_yv
            b = b + 1
        }
    }
    if iter >= 10 {
        return 1
    }
    if out_xt[0] != 1 or out_xv[0] != 5 {
        return 2
    }
    if out_yt[1] != 1 or out_yv[1] != 6 {
        return 3
    }
    if out_xt[2] != 2 {
        return 4
    }
    if in_xt[3] != 2 {
        return 5
    }
    if in_yt[3] != 1 or in_yv[3] != 6 {
        return 6
    }
    if out_yt[3] != 1 or out_yv[3] != 6 {
        return 7
    }
    println("PASS constprop_lattice: meet TOP/CONST/BOT converge")
    return 0
}
