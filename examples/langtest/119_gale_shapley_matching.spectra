module gale_shapley_matching

from std.io import println

// Gale-Shapley stable marriage with a brute-force oracle: every assignment is
// enumerated, the number of stable matchings is counted and the algorithm's
// result must be the man-optimal matching among them.

func is_stable(men_pref: [int], women_pref: [int], n: int, wife_of: [int], husband_of: [int]) returns bool {
    let m = 0
    while m < n {
        let w = 0
        while w < n {
            let current_wife    = wife_of[m]
            let current_husband = husband_of[w]
            if men_pref[m * n + w] < men_pref[m * n + current_wife] and women_pref[w * n + m] < women_pref[w * n + current_husband] {
                return false
            }
            w = w + 1
        }
        m = m + 1
    }
    return true
}

func stable_marriage(men_pref: [int], women_pref: [int], n: int, wife_of: [int], husband_of: [int]) {
    let next = [0, 0, 0]
    let m    = 0
    while m < n {
        wife_of[m] = 0 - 1
        husband_of[m] = 0 - 1
        m = m + 1
    }
    let remaining = n
    while remaining > 0 {
        m = 0
        while wife_of[m] != 0 - 1 {
            m = m + 1
        }
        let w = men_pref[m * n + next[m]]
        next[m] = next[m] + 1
        if husband_of[w] == 0 - 1 {
            wife_of[m] = w
            husband_of[w] = m
            remaining = remaining - 1
        } else {
            let current = husband_of[w]
            if women_pref[w * n + m] < women_pref[w * n + current] {
                wife_of[current] = 0 - 1
                wife_of[m] = w
                husband_of[w] = m
            }
        }
    }
}

func enumerate_stable(men_pref: [int], women_pref: [int], best_rank: [int]) returns int {
    let wife_of    = [0, 0, 0]
    let husband_of = [0, 0, 0]
    let count      = 0
    let a          = 0
    while a < 3 {
        let b = 0
        while b < 3 {
            if b != a {
                let c = 0
                while c < 3 {
                    if c != a and c != b {
                        wife_of[0] = a
                        wife_of[1] = b
                        wife_of[2] = c
                        husband_of[a] = 0
                        husband_of[b] = 1
                        husband_of[c] = 2
                        if is_stable(men_pref, women_pref, 3, wife_of, husband_of) {
                            count = count + 1
                            let m = 0
                            while m < 3 {
                                let rank = men_pref[m * 3 + wife_of[m]]
                                if rank < best_rank[m] {
                                    best_rank[m] = rank
                                }
                                m = m + 1
                            }
                        }
                    }
                    c = c + 1
                }
            }
            b = b + 1
        }
        a = a + 1
    }
    return count
}

func man_optimal(men_pref: [int], wife_of: [int], best_rank: [int]) returns bool {
    let m = 0
    while m < 3 {
        if men_pref[m * 3 + wife_of[m]] != best_rank[m] {
            return false
        }
        m = m + 1
    }
    return true
}

public func main() returns int {
    let men_a     = [0, 1, 2, 0, 1, 2, 1, 0, 2]
    let women_a   = [1, 0, 2, 0, 2, 1, 0, 1, 2]
    let wife_a    = [0, 0, 0]
    let husband_a = [0, 0, 0]
    stable_marriage(men_a, women_a, 3, wife_a, husband_a)
    if wife_a[0] != 1 or wife_a[1] != 0 or wife_a[2] != 2 {
        return 1
    }
    if not is_stable(men_a, women_a, 3, wife_a, husband_a) {
        return 2
    }
    let best_a = [3, 3, 3]
    if enumerate_stable(men_a, women_a, best_a) != 1 {
        return 3
    }
    if not man_optimal(men_a, wife_a, best_a) {
        return 4
    }
    let men_b     = [0, 1, 2, 1, 0, 2, 0, 1, 2]
    let women_b   = [1, 0, 2, 0, 1, 2, 0, 1, 2]
    let wife_b    = [0, 0, 0]
    let husband_b = [0, 0, 0]
    stable_marriage(men_b, women_b, 3, wife_b, husband_b)
    if wife_b[0] != 0 or wife_b[1] != 1 or wife_b[2] != 2 {
        return 5
    }
    if not is_stable(men_b, women_b, 3, wife_b, husband_b) {
        return 6
    }
    let best_b = [3, 3, 3]
    if enumerate_stable(men_b, women_b, best_b) != 2 {
        return 7
    }
    if not man_optimal(men_b, wife_b, best_b) {
        return 8
    }
    println("PASS gale_shapley_matching: stable matching + man-optimal oracle")
    return 0
}
