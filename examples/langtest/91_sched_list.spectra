module sched_list

from std.io import println

// List scheduling (backend): 1 unidade, DAG A->{B,C}, B/C->D, D->E,
// latencias [2,1,1,1,1], prioridade = caminho critico ate a saida.
// Ordem A,B,C,D,E com inicios [0,2,3,4,5], makespan 6.

func critical_path(succ0: [int], succ1: [int], has1: [int], lat: [int], n: int, cp: [int]) {
    let i = n - 1
    while i >= 0 {
        let best = 0
        if has1[i] == 1 {
            let s0 = succ0[i]
            let s1 = succ1[i]
            if cp[s0] > cp[s1] {
                best = cp[s0]
            } else {
                best = cp[s1]
            }
        } else {
            if succ0[i] != -1 {
                best = cp[succ0[i]]
            }
        }
        cp[i] = lat[i] + best
        i = i - 1
    }
}

public func main() returns int {
    let succ0 = [1, 3, 3, 4, -1]
    let succ1 = [2, -1, -1, -1, -1]
    let has1  = [1, 0, 0, 0, 0]
    let lat   = [2, 1, 1, 1, 1]
    let cp    = [0, 0, 0, 0, 0]
    critical_path(succ0, succ1, has1, lat, 5, cp)
    if cp[0] != 5 or cp[1] != 3 or cp[2] != 3 or cp[3] != 2 or cp[4] != 1 {
        return 1
    }
    let start  = [-1, -1, -1, -1, -1]
    let finish = [0, 0, 0, 0, 0]
    let pred0  = [-1, 0, 0, 1, 3]
    let pred1  = [-1, -1, -1, 2, -1]
    let hasp1  = [0, 0, 0, 1, 0]
    let free   = 0
    let done   = 0
    while done < 5 {
        let best = -1
        let i    = 0
        while i < 5 {
            if start[i] == -1 {
                let ready = 1
                if pred0[i] != -1 and finish[pred0[i]] == 0 {
                    ready = 0
                }
                if hasp1[i] == 1 and finish[pred1[i]] == 0 {
                    ready = 0
                }
                if ready == 1 {
                    if best == -1 or cp[i] > cp[best] {
                        best = i
                    }
                }
            }
            i = i + 1
        }
        if best == -1 {
            return 2
        }
        let t = free
        if pred0[best] != -1 and finish[pred0[best]] > t {
            t = finish[pred0[best]]
        }
        if hasp1[best] == 1 and finish[pred1[best]] > t {
            t = finish[pred1[best]]
        }
        start[best] = t
        finish[best] = t + lat[best]
        free = t + lat[best]
        done = done + 1
    }
    if start[0] != 0 or start[1] != 2 or start[2] != 3 or start[3] != 4 or start[4] != 5 {
        return 3
    }
    println("PASS sched_list: caminho critico + makespan 6")
    return 0
}
