module mutation_testing

from std.io import println

// Mutation testing: operadores semeados (troca de operador, off-by-one,
// condicao de fronteira) precisam ser mortos pela suite. Score = 100%.

func orig_add(a: int, b: int) returns int {
    return a + b
}

func mut_add_sub(a: int, b: int) returns int {
    return a - b
}

func mut_add_off(a: int, b: int) returns int {
    return a + b + 1
}

func orig_max(a: int, b: int) returns int {
    if a > b {
        return a
    }
    return b
}

func mut_max_min(a: int, b: int) returns int {
    if a < b {
        return a
    }
    return b
}

func orig_is_even(n: int) returns bool {
    return n % 2 == 0
}

func mut_is_odd(n: int) returns bool {
    return n % 2 == 1
}

public func main() returns int {
    if orig_add(2, 3) != 5 {
        return 1
    }
    if mut_add_sub(2, 3) == orig_add(2, 3) {
        return 2
    }
    if mut_add_off(2, 3) == orig_add(2, 3) {
        return 3
    }
    if orig_max(3, 5) != 5 or orig_max(5, 3) != 5 or orig_max(4, 4) != 4 {
        return 4
    }
    if mut_max_min(3, 5) == orig_max(3, 5) {
        return 5
    }
    if orig_is_even(4) != true or orig_is_even(7) != false {
        return 6
    }
    if mut_is_odd(4) == orig_is_even(4) {
        return 7
    }
    let killed = 0
    if mut_add_sub(2, 3) != orig_add(2, 3) {
        killed = killed + 1
    }
    if mut_add_off(2, 3) != orig_add(2, 3) {
        killed = killed + 1
    }
    if mut_max_min(3, 5) != orig_max(3, 5) {
        killed = killed + 1
    }
    if mut_is_odd(4) != orig_is_even(4) {
        killed = killed + 1
    }
    let score = killed * 100 / 4
    if score != 100 {
        return 8
    }
    println("PASS mutation_testing: 4/4 mutantes mortos (score 100)")
    return 0
}
