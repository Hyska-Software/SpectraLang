module treap_order_stats

from std.io import println

// Deterministic treap with rotations, erase, subtree sizes, and kth lookup.
// Priorities are supplied by the test so the shape and every invariant remain
// reproducible without a random source.

func node_size(sizes: [int], node: int) returns int {
    if node == -1 {
        return 0
    }
    return sizes[node]
}

func update(left: [int], right: [int], sizes: [int], node: int) {
    if node != -1 {
        sizes[node] = 1 + node_size(sizes, left[node]) + node_size(sizes, right[node])
    }
}

func rotate_right(left: [int], right: [int], sizes: [int], root: int) returns int {
    let child = left[root]
    left[root] = right[child]
    right[child] = root
    update(left, right, sizes, root)
    update(left, right, sizes, child)
    return child
}

func rotate_left(left: [int], right: [int], sizes: [int], root: int) returns int {
    let child = right[root]
    right[root] = left[child]
    left[child] = root
    update(left, right, sizes, root)
    update(left, right, sizes, child)
    return child
}

func insert(left: [int], right: [int], keys: [int], priorities: [int], sizes: [int], root: int, node: int) returns int {
    if root == -1 {
        return node
    }
    if keys[node] < keys[root] {
        left[root] = insert(left, right, keys, priorities, sizes, left[root], node)
        if priorities[left[root]] > priorities[root] {
            return rotate_right(left, right, sizes, root)
        }
    } else {
        right[root] = insert(left, right, keys, priorities, sizes, right[root], node)
        if priorities[right[root]] > priorities[root] {
            return rotate_left(left, right, sizes, root)
        }
    }
    update(left, right, sizes, root)
    return root
}

func merge(left: [int], right: [int], priorities: [int], sizes: [int], a: int, b: int) returns int {
    if a == -1 {
        return b
    }
    if b == -1 {
        return a
    }
    if priorities[a] > priorities[b] {
        right[a] = merge(left, right, priorities, sizes, right[a], b)
        update(left, right, sizes, a)
        return a
    }
    left[b] = merge(left, right, priorities, sizes, a, left[b])
    update(left, right, sizes, b)
    return b
}

func erase(left: [int], right: [int], keys: [int], priorities: [int], sizes: [int], root: int, key: int) returns int {
    if root == -1 {
        return-1
    }
    if key == keys[root] {
        return merge(left, right, priorities, sizes, left[root], right[root])
    }
    if key < keys[root] {
        left[root] = erase(left, right, keys, priorities, sizes, left[root], key)
    } else {
        right[root] = erase(left, right, keys, priorities, sizes, right[root], key)
    }
    update(left, right, sizes, root)
    return root
}

func contains(left: [int], right: [int], keys: [int], root: int, key: int) returns bool {
    if root == -1 {
        return false
    }
    if key == keys[root] {
        return true
    }
    if key < keys[root] {
        return contains(left, right, keys, left[root], key)
    }
    return contains(left, right, keys, right[root], key)
}

func kth(left: [int], right: [int], sizes: [int], root: int, rank: int) returns int {
    let left_count = node_size(sizes, left[root])
    if rank < left_count {
        return kth(left, right, sizes, left[root], rank)
    }
    if rank == left_count {
        return root
    }
    return kth(left, right, sizes, right[root], rank - left_count - 1)
}

public func main() returns int {
    let left       = [-1, -1, -1, -1, -1, -1]
    let right      = [-1, -1, -1, -1, -1, -1]
    let keys       = [5, 2, 8, 1, 3, 7]
    let priorities = [40, 70, 30, 80, 60, 50]
    let sizes      = [1, 1, 1, 1, 1, 1]
    let root       = -1
    let i          = 0
    while i < 6 {
        root = insert(left, right, keys, priorities, sizes, root, i)
        i = i + 1
    }
    let want = [1, 2, 3, 5, 7, 8]
    i = 0
    while i < 6 {
        if keys[kth(left, right, sizes, root, i)] != want[i] {
            return 1 + i
        }
        i = i + 1
    }
    if sizes[root] != 6 or not contains(left, right, keys, root, 7) or contains(left, right, keys, root, 9) {
        return 10
    }
    root = erase(left, right, keys, priorities, sizes, root, 2)
    if sizes[root] != 5 or contains(left, right, keys, root, 2) or keys[kth(left, right, sizes, root, 1)] != 3 {
        return 11
    }
    println("PASS treap_order_stats: rotations + erase + kth")
    return 0
}
