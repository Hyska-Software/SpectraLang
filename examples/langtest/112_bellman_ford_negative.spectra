module bellman_ford_negative

from std.io import println

// Bellman-Ford over an edge list with an explicit infinity sentinel.
// A final pass distinguishes a shortest path from a reachable negative cycle.

func shortest(edges: [int], m: int, n: int, source: int, dist: [int]) returns bool {
    let infinity = 1000000
    let i        = 0
    while i < n {
        dist[i] = infinity
        i = i + 1
    }
    dist[source] = 0
    let round = 1
    while round < n {
        let changed = 0
        i = 0
        while i < m {
            let a = edges[i * 3]
            let b = edges[i * 3 + 1]
            let w = edges[i * 3 + 2]
            if dist[a] < infinity and dist[a] + w < dist[b] {
                dist[b] = dist[a] + w
                changed = 1
            }
            i = i + 1
        }
        if changed == 0 {
            break
        }
        round = round + 1
    }
    i = 0
    while i < m {
        let a = edges[i * 3]
        let b = edges[i * 3 + 1]
        let w = edges[i * 3 + 2]
        if dist[a] < infinity and dist[a] + w < dist[b] {
            return false
        }
        i = i + 1
    }
    return true
}

public func main() returns int {
    let edges = [
        0, 1, 6,
        0, 3, 7,
        1, 2, 5,
        1, 3, 8,
        1, 4, 0 - 4,
        2, 1, 0 - 2,
        3, 2, 0 - 3,
        3, 4, 9,
        4, 0, 2,
        4, 2, 7,
    ]
    let dist = [0, 0, 0, 0, 0]
    if not shortest(edges, 10, 5, 0, dist) {
        return 1
    }
    let want = [0, 2, 4, 7, 0 - 2]
    let i    = 0
    while i < 5 {
        if dist[i] != want[i] {
            return 2 + i
        }
        i = i + 1
    }
    let acyclic      = [0, 1, 2, 1, 2, 0 - 1, 0, 2, 5]
    let acyclic_dist = [0, 0, 0]
    if not shortest(acyclic, 3, 3, 0, acyclic_dist) {
        return 10
    }
    if acyclic_dist[2] != 1 {
        return 11
    }
    let cycle      = [0, 1, 1, 1, 2, 0 - 3, 2, 0, 1]
    let cycle_dist = [0, 0, 0]
    if shortest(cycle, 3, 3, 0, cycle_dist) {
        return 12
    }
    println("PASS bellman_ford_negative: negative edges + cycle detection")
    return 0
}
