module interval_sweep

from std.io import println

// Closed-interval sweep line. Starts sort before ends at equal coordinates,
// so touching intervals overlap as they should for inclusive endpoints.

func event_before_value(points: [int], kinds: [int], point: int, kind: int, right: int) returns bool {
    if point < points[right] {
        return true
    }
    if point > points[right] {
        return false
    }
    return kind < kinds[right]
}

func sort_events(points: [int], kinds: [int], n: int) {
    let i = 1
    while i < n {
        let point = points[i]
        let kind  = kinds[i]
        let j     = i
        while j > 0 and event_before_value(points, kinds, point, kind, j - 1) {
            points[j] = points[j - 1]
            kinds[j] = kinds[j - 1]
            j = j - 1
        }
        points[j] = point
        kinds[j] = kind
        i = i + 1
    }
}

func maximum_overlap(starts: [int], ends: [int], n: int, out_point: [int]) returns int {
    let points = [0, 0, 0, 0, 0, 0, 0, 0]
    let kinds  = [0, 0, 0, 0, 0, 0, 0, 0]
    let i      = 0
    while i < n {
        points[i * 2] = starts[i]
        kinds[i * 2] = 0
        points[i * 2 + 1] = ends[i]
        kinds[i * 2 + 1] = 1
        i = i + 1
    }
    sort_events(points, kinds, n * 2)
    let active     = 0
    let best       = 0
    let best_point = 0
    i = 0
    while i < n * 2 {
        if kinds[i] == 0 {
            active = active + 1
            if active > best {
                best = active
                best_point = points[i]
            }
        } else {
            active = active - 1
        }
        i = i + 1
    }
    out_point[0] = best_point
    return best
}

func contains(interval_start: int, interval_end: int, point: int) returns bool {
    return interval_start <= point and point <= interval_end
}

func count_at(starts: [int], ends: [int], n: int, point: int) returns int {
    let count = 0
    let i     = 0
    while i < n {
        if contains(starts[i], ends[i], point) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

public func main() returns int {
    let starts     = [1, 2, 4, 7]
    let ends       = [5, 4, 8, 9]
    let best_point = [0]
    if maximum_overlap(starts, ends, 4, best_point) != 3 {
        return 1
    }
    if best_point[0] != 4 {
        return 11
    }
    if count_at(starts, ends, 4, 4) != 3 or count_at(starts, ends, 4, 6) != 1 {
        return 2
    }
    if count_at(starts, ends, 4, 10) != 0 {
        return 3
    }
    let touching_starts = [1, 3]
    let touching_ends   = [3, 5]
    if maximum_overlap(touching_starts, touching_ends, 2, best_point) != 2 or best_point[0] != 3 {
        return 4
    }
    println("PASS interval_sweep: closed overlap + endpoint ties")
    return 0
}
