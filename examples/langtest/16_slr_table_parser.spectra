module slr_table_parser

from std.io import println

// Parser SLR(1) dirigido a tabela (Aho/Ullman, E->E+T|T, T->T*F|F, F->(E)|id).
// Tokens: 0=id 1=+ 2=* 3=( 4=) 5=EOF. Acoes: 0=erro 100+s=shift 200+r=reduce 999=aceita.
// Regras 1..6: E->E+T E->T T->T*F T->F F->(E) F->id.

func rule_lhs(r: int) returns int {
    if r == 1 or r == 2 {
        return 0
    }
    if r == 3 or r == 4 {
        return 1
    }
    return 2
}

func rule_len(r: int) returns int {
    if r == 1 or r == 3 or r == 5 {
        return 3
    }
    return 1
}

func slr_eval(toks: [int], values: [int], action: [int], goto: [int], stack: [int], vals: [int]) returns int {
    let sp = 0
    stack[0] = 0
    vals[0] = 0
    let pos  = 0
    let step = 0
    while step < 40 {
        step = step + 1
        let s = stack[sp]
        let a = action[s * 6 + toks[pos]]
        if a == 999 {
            return vals[sp]
        }
        if a >= 100 and a < 200 {
            sp = sp + 1
            stack[sp] = a - 100
            if toks[pos] == 0 {
                vals[sp] = values[pos]
            } else {
                vals[sp] = 0
            }
            pos = pos + 1
        } else {
            if a >= 200 {
                let r   = a - 200
                let res = 0
                if r == 1 {
                    res = vals[sp - 2] + vals[sp]
                } else {
                    if r == 3 {
                        res = vals[sp - 2] * vals[sp]
                    } else {
                        if r == 5 {
                            res = vals[sp - 1]
                        } else {
                            res = vals[sp]
                        }
                    }
                }
                sp = sp - rule_len(r)
                let ns = goto[stack[sp] * 3 + rule_lhs(r)]
                if ns == -1 {
                    return-8888
                }
                sp = sp + 1
                stack[sp] = ns
                vals[sp] = res
            } else {
                return-8888
            }
        }
    }
    return-8888
}

