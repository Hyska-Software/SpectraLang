    }
    let k4 = [1, 5]
    let v4 = [0, 0]
    if slr_eval(k4, v4, action, goto, stack, vals) != -8888 {
        return 4
    }
    println("PASS slr_table_parser: ACTION/GOTO com stack semantica")
    return 0
