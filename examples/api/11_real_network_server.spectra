// Demonstrates a REAL network HTTP conversation: the script starts an
// std.api.server listener bound to 127.0.0.1:18090, serves routes whose
// responses are computed dynamically per request by a registered sync
// callback, drives the traffic with the std.api.client HTTP host calls over
// actual TCP sockets (not in-process dispatch_sync only), verifies status,
// headers, and exact body sizes on each round-trip, confirms server-side
// connection statistics, then shuts down cleanly.
module real_network_server

import std.string as str
import std.convert as convert

from std.api.server import Server, new as server_new, listen, serve, shutdown, local_port, state, stats
from std.api.routing import Router, Route, router, get, route_id
from std.api.handler import HandlerHandle, register_sync_callback, text, with_header, dispatch_sync
from std.api.http import Request, Response, method_get, request, request_path, response_status, response_header, response_body_len
from std.api.client import Client, new as client_new, request as client_request, set_ssrf_policy
from std.api.security import SsrfPolicy, ssrf_policy, ssrf_allow_private_networks

const PORT: int        = 18090
const GREETING: string = "spectra-wire-hello"

// Dynamic handler shared by both routes: every served request re-enters this
// function through the callback bridge with the parsed wire request, so each
// response body is computed from the incoming path instead of being a single
// pre-baked stored response.
func dynamic_greeting(req: Request) returns Response {
    if request_path(req) == "/hello" {
        return with_header(text(GREETING), "Content-Type", "text/plain")
    }
    let body: string = str.concat("path=", request_path(req))
    return with_header(text(body), "Content-Type", "text/plain")
}

// Issues one GET against http://127.0.0.1:<PORT><target> over a real TCP
// socket using the nonblocking client host call, blocks on the response task,
// and validates the full wire round-trip. The client is created per call
// because opaque API handles must stay local to the function that lowers them.
func round_trip(target: string, expected_body_len: int) returns int {
    let policy: SsrfPolicy = ssrf_allow_private_networks(ssrf_policy(), true)
    let client: Client     = client_new()
    if set_ssrf_policy(client, policy) != true {
        return 4
    }

    let url: string = str.concat("http://127.0.0.1:", str.concat(convert.int_to_string(PORT), target))
    let req: Request = request(method_get(), url)
    let task: Task<Response> = client_request(client, req)
    let resp: Response = block_on(task)

    if response_status(resp) != 200 {
        return 1
    }
    if response_header(resp, "content-type") != "text/plain" {
        return 2
    }
    if response_body_len(resp) != expected_body_len {
        return 3
    }
    return 0
}

public func main() returns int {
    // Routes: a fixed greeting and a parameterized path; both are served by
    // the dynamic callback.
    let routes: Router     = router()
    let hello_route: Route = get(routes, "/hello")
    let wire_route: Route  = get(routes, "/wire/{n:\\d+}")
    if route_id(hello_route) == 0 or route_id(wire_route) == 0 {
        return 1
    }

    let hello_handler: HandlerHandle = register_sync_callback(route_id(hello_route), dynamic_greeting)
    let wire_handler: HandlerHandle  = register_sync_callback(route_id(wire_route), dynamic_greeting)

    // In-process warmup proves the callback bridge itself is wired correctly
    // before any networking happens.
    let warmup: Response = dispatch_sync(hello_handler, request(method_get(), "/hello"))
    if response_status(warmup) != 200 || response_body_len(warmup) != 18 {
        return 2
    }

    // Bind 127.0.0.1:18090 and start the mio accept loop on its own thread.
    // serve() returns a ready task<int>; block_on just resolves it.
    let server: Server = server_new()
    if listen(server, PORT) != true {
        return 10
    }
    if block_on(serve(server, routes)) != 1 {
        return 11
    }
    if state(server) != 2 {
        return 12
    }
    if local_port(server) != PORT {
        return 13
    }

    // Round-trip 1: GET /hello -> greeting body ("spectra-wire-hello" = 18).
    let hello_result: int = round_trip("/hello", 18)
    if hello_result != 0 {
        return 40 + hello_result
    }

    // Round-trips 2 and 3: the same handler computes different bodies from
    // the incoming wire path ("path=/wire/12345" = 16, "path=/wire/7" = 12),
    // so distinct responses prove per-request callback dispatch.
    let wire_12345_result: int = round_trip("/wire/12345", 16)
    if wire_12345_result != 0 {
        return 50 + wire_12345_result
    }
    let wire_7_result: int = round_trip("/wire/7", 12)
    if wire_7_result != 0 {
        return 60 + wire_7_result
    }

    // Server-side proof the traffic crossed the real listener: 3 connections
    // accepted, 3 requests completed, nothing timed out, misparsed, or got
    // cancelled.
    if stats(server, 1) != 3 || stats(server, 2) != 3 {
        return 70
    }
    if stats(server, 5) != 0 || stats(server, 6) != 0 || stats(server, 9) != 0 {
        return 71
    }

    // Graceful shutdown: drain connections, stop accepting, state stopped.
    if shutdown(server) != true {
        return 80
    }
    if state(server) != 3 {
        return 81
    }

    return 0
}
