module websocket_echo

from std.api.routing import Route, Router, get, router_new
from std.api.websocket import WebSocketServer, server_new, server_listen, server_local_port, server_route, server_set_max_message_bytes, server_set_per_message_deflate

public func main() returns int {
    let server: WebSocketServer = server_new()
    if server_set_per_message_deflate(server, true) != true {
        return 1
    }
    if server_set_max_message_bytes(server, 1048576) != true {
        return 2
    }
    if server_listen(server, 0) != true {
        return 3
    }
    if server_local_port(server) <= 0 {
        return 4
    }
    let router: Router = router_new()
    let route: Route = get(router, "/echo")
    let routed: WebSocketServer = server_new()
    if server_route(routed, route) != true {
        return 5
    }
    return 0
}
