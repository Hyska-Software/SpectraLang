module otel_prometheus_example

from std.env import env_get
from std.option import is_none, option_unwrap, option_unwrap_or
from std.convert import string_to_int_or
from std.time import sleep_ms
from std.api.trace import TraceConfig, TraceSpan, config_new, config_set_batch_size, config_start, config_shutdown, span_start, span_set_attribute, span_set_attribute_int, span_set_attribute_bool, span_set_status, span_end, flush
from std.api.server import Server, new, listen, serve, shutdown
from std.api.routing import Router, Route, router, get, route_id
from std.api.handler import HandlerHandle, text, register_sync

public func main() returns int {
    let endpoint_option = env_get("SPECTRA_R2707_OTLP_ENDPOINT")
    if is_none(endpoint_option) {
        return 1
    }
    let endpoint: string = option_unwrap(endpoint_option)
    let config: TraceConfig = config_new(endpoint, "spectralang-r2707")
    if config_set_batch_size(config, 1) != true {
        return 2
    }
    if config_start(config) != true {
        return 3
    }

    let routes: Router = router()
    let demo: Route    = get(routes, "/demo")
    if route_id(demo) == 0 {
        return 4
    }
    let handler: HandlerHandle = register_sync(route_id(demo), text("otel-prometheus-ok"))

    let server: Server = new()
    let port_option    = env_get("SPECTRA_R2707_PORT")
    let port_text: string = option_unwrap_or(port_option, "0")
    let port           = string_to_int_or(port_text, 0)
    if listen(server, port) != true {
        return 5
    }
    if block_on(serve(server, routes)) != 1 {
        return 6
    }

    let example_span: TraceSpan = span_start("example.operation", 1)
    if span_set_attribute(example_span, "example.component", "otel-prometheus") != true {
        return 7
    }
    if span_set_attribute_int(example_span, "example.request_count", 2) != true {
        return 8
    }
    if span_set_attribute_bool(example_span, "example.sampled", true) != true {
        return 9
    }

    // The harness sends real requests while this process owns the listener.
    sleep_ms(6000)
    if span_set_status(example_span, 1) != true {
        return 10
    }
    if span_end(example_span) != true {
        return 11
    }
    if shutdown(server) != true {
        return 12
    }
    if flush() == -1 {
        return 13
    }
    if config_shutdown(config) != true {
        return 14
    }
    return 0
}
