module main

// Example 02 — approval, assertions and a budget ceiling.
//
// Three governance primitives, all against the deterministic mock provider:
//
//   * `approve(run, action)` asks the registered approver. A fresh CLI process
//     attaches no approver, so the default is **deny** — there is no implicit
//     allow. The decision is journaled (`kind = "approval"`) and replayed from
//     the journal instead of being asked twice.
//   * `require(run, condition, message)` is a governed assertion: `false`
//     returns a typed error naming the message *and* the run goal, and marks
//     the run failed.
//   * A ceiling in the spec is enforced by cancellation: the turn that crosses
//     it is accounted and still answered, every later call is refused before
//     reaching the provider, and the report names the ceiling that was hit.
//
// The allow side of `approve` (an attached approver returning allow-once /
// allow-always with attribution) is owned by the process that embeds the
// runtime: it installs an `Approver` through `spectra_agent::set_approver`, the
// same seam the spectra-agent crate tests exercise. A Spectra program can ask
// and must handle both answers.

import std.agent
import std.convert as conv
import std.error as error
import std.fs as fs
from std.io import println
import std.string as str

const JOURNAL_DIR = ".spectra/example-02-journal"
const APPROVAL_RUN = "example-02-approval"
const BUDGET_RUN = "example-02-budget"
const WRITE_ACTION = "spectra.std.fs.fs_write"

// A spec with a journal and a fixed run id, so the example can read back what
// the run recorded. `journal_payloads` keeps the approval action readable.
func journaled_spec(run_id: string) returns string {
    return "{\"goal\":\"example-approval-and-budget\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":7,\"journal\":\"" + JOURNAL_DIR + "\",\"journal_payloads\":true,\"run_id\":\"" + run_id + "\"}"
}

// `max_tokens` counts every billable token (input + output). The mock reports
// 1 input + 3 output tokens per echoed turn, so two turns take the run from 0
// to 8 of 6 and the run is cancelled on the ceiling.
func token_ceiling_spec(run_id: string) returns string {
    return "{\"goal\":\"example-approval-and-budget\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":6,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":7,\"journal\":\"" + JOURNAL_DIR + "\",\"journal_payloads\":true,\"run_id\":\"" + run_id + "\"}"
}

func journal_path(run_id: string) returns string {
    return JOURNAL_DIR + "/" + run_id + ".jsonl"
}

// Removes a previous journal file so the example starts from a known state.
func clean(path: string) returns int {
    let present = fs.fs_exists(path)
    if let Result::Ok(exists) = present {
        if exists == true {
            let removed = fs.fs_remove(path)
            if let Result::Ok(ok) = removed {
                if ok == true {
                    return 0
                }
            }
            return 1
        }
        return 0
    }
    return 1
}

// Default deny plus a governed assertion, in one run.
func approval_and_assertions() returns int {
    if clean(journal_path(APPROVAL_RUN)) != 0 {
        return 1
    }
    let started = agent_start(journaled_spec(APPROVAL_RUN))
    if let Result::Err(start_error) = started {
        return 2
    }
    if let Result::Ok(run) = started {
        // `true` passes and is journaled as a passing assertion.
        let passed = require(run, true, "the run is journaled")
        if let Result::Ok(passed_ok) = passed {
            if passed_ok == false {
                return 3
            }
        } else {
            return 4
        }
        println("assert -> passed")

        // No approver is attached in this process, so this is a deny. A deny
        // is a successful `approve` call carrying `false`, not an error.
        let approval = approve(run, WRITE_ACTION)
        if let Result::Ok(allowed) = approval {
            println("approve -> " + bool_text(allowed))
            if allowed == true {
                return 5
            }
        } else {
            return 6
        }

        // The denial refuses the action: the run fails with a typed error that
        // names both the message and the run goal.
        let refused = require(run, false, "refused: fs_write was not approved")
        if let Result::Err(refusal) = refused {
            println("require -> " + error_text(refusal))
        } else {
            return 7
        }

        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            println("report  -> " + report)
            if str.contains(report, "\"status\":\"failed\"") == false {
                return 8
            }
        } else {
            return 9
        }
    }

    // The journal is the durable record: both decisions are on disk.
    let contents = fs.fs_read(journal_path(APPROVAL_RUN))
    if let Result::Ok(text) = contents {
        if str.contains(text, "\"kind\":\"assertion\"") == false {
            return 10
        }
        if str.contains(text, "\"kind\":\"approval\"") == false {
            return 11
        }
        if str.contains(text, WRITE_ACTION) == false {
            return 12
        }
    } else {
        return 13
    }
    return 0
}

// Crossing the token ceiling: accounted, answered, then refused.
func budget_ceiling() returns int {
    if clean(journal_path(BUDGET_RUN)) != 0 {
        return 1
    }
    let started = agent_start(token_ceiling_spec(BUDGET_RUN))
    if let Result::Err(start_error) = started {
        return 2
    }
    if let Result::Ok(run) = started {
        let before = budget_remaining(run)
        if let Result::Ok(remaining) = before {
            println("budget  -> " + conv.int_to_string(remaining) + " tokens left")
            if remaining != 6 {
                return 3
            }
        } else {
            return 4
        }

        let alpha = block_on(ask(run, "alpha"))
        if let Result::Err(alpha_error) = alpha {
            return 5
        }
        let middle = budget_remaining(run)
        if let Result::Ok(remaining) = middle {
            if remaining != 2 {
                return 6
            }
        } else {
            return 7
        }

        // The crossing turn is accounted and still delivers its value.
        let beta = block_on(ask(run, "beta"))
        if let Result::Err(beta_error) = beta {
            return 8
        }
        let after = budget_remaining(run)
        if let Result::Ok(remaining) = after {
            if remaining != 0 {
                return 9
            }
        } else {
            return 10
        }

        // Every later call is refused before it reaches the provider.
        let gamma = block_on(ask(run, "gamma"))
        if let Result::Ok(gamma_text) = gamma {
            return 11
        }
        println("ceiling -> next call refused with a typed error")

        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            println("report  -> " + report)
            if str.contains(report, "\"status\":\"budget_exceeded\"") == false {
                return 12
            }
            if str.contains(report, "\"ceiling\":\"max_tokens\"") == false {
                return 13
            }
        } else {
            return 14
        }
    }
    return 0
}

// `std.option`-free helpers: the example prints a few values of different
// types, and printing cannot infer them from a generic without a hint.
func bool_text(value: bool) returns string {
    if value == true {
        return "allowed"
    }
    return "denied"
}

func error_text(value: Error) returns string {
    return error.message(value)
}

public func main() returns int {
    let approval = approval_and_assertions()
    if approval != 0 {
        return approval
    }
    // The budget part drives `ask`, which is async, so `main` blocks on it.
    let budget = block_on(budget_checks())
    if budget != 0 {
        return 100 + budget
    }
    return 0
}

async func budget_checks() returns int {
    return budget_ceiling()
}
