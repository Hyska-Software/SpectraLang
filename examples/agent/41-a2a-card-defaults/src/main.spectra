module main

// Example 41 — an A2A card fills only documented identity defaults. Missing
// fields use the run goal and package version; an omitted URL is not invented,
// and authored non-string fields remain typed protocol errors.

from std.io import println
import std.agent
import std.error as error
import std.string as str

func spec() returns string {
    return "{\"goal\":\"example-a2a-card-defaults\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":41,\"journal\":\"\"}"
}

func verify() returns int {
    let started = agent_start(spec())
    if let Result::Ok(run) = started {
        let defaults = a2a_card(run, "{}")
        if let Result::Ok(document) = defaults {
            if str.contains(document, "\"name\":\"example-a2a-card-defaults\"") == false {
                return 2
            }
            if str.contains(document, "\"description\":\"\"") == false {
                return 3
            }
            if str.contains(document, "\"url\":") {
                return 4
            }
            if str.contains(document, "\"skills\":[]") == false {
                return 5
            }
        } else {
            return 1
        }

        let invalid = a2a_card(run, "{\"name\":7}")
        if let Result::Err(problem) = invalid {
            if str.contains(error.message(problem), "a2a_error") == false {
                return 6
            }
        } else {
            return 7
        }

        let authored = a2a_card(
            run,
            "{\"name\":\"authored agent\",\"description\":\"serves cards\",\"version\":\"2.0\",\"url\":\"https://agent.invalid\"}",
        )
        if let Result::Ok(document) = authored {
            if str.contains(document, "\"url\":\"https://agent.invalid\"") == false {
                return 8
            }
            if str.contains(document, "\"version\":\"2.0\"") == false {
                return 9
            }
        } else {
            return 10
        }
        if let Result::Ok(report) = agent_end(run) {
            if str.contains(report, "\"steps\":0") == false {
                return 11
            }
        } else {
            return 12
        }
    } else {
        return 13
    }
    println("A2A card defaults -> goal identity, omitted URL, typed fields")
    return 0
}

public func main() returns int {
    return verify()
}
