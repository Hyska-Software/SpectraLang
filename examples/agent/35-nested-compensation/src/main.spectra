module main

// Example 35 — a tool can declare a compensation on the active run. The
// declaration must survive replay of the outer tool, so an explicit rollback
// still executes the release once and never re-enters the booking body.

from std.io import println
import std.agent
import std.error as error
import std.fs as fs
import std.string as str

const DIR = ".spectra/example-35-nested-compensation"
const RUN_ID = "nested-compensation"
const PATH = DIR + "/" + RUN_ID + ".jsonl"
static RELEASED: int = 0

#[derive(Serialize, Deserialize)]
public record LabelArgs {
    label: string,
}

#[agent_tool("Releases a booked item")]
public async func release(run: Run, args: LabelArgs) returns string {
    RELEASED = RELEASED + 1
    return "released " + args.label
}

#[agent_tool("Books an item and declares its release")]
public async func book(run: Run, args: LabelArgs) returns string {
    let declared = compensate(run, "release", "{\"label\":\"" + args.label + "\"}")
    if let Result::Ok(ok) = declared {
        if ok == true {
            return "booked " + args.label
        }
    }
    return "not booked"
}

func spec() returns string {
    return "{\"goal\":\"example-nested-compensation\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"allow\",\"seed\":35,\"journal\":\"" +
        DIR +
        "\",\"journal_payloads\":true,\"run_id\":\"" +
        RUN_ID +
        "\"}"
}

func clean() returns int {
    let exists = fs.fs_exists(PATH)
    if let Result::Ok(present) = exists {
        if present == true {
            let removed = fs.fs_remove(PATH)
            if let Result::Err(_problem) = removed {
                return 1
            }
        }
    }
    return 0
}

async func verify() returns int {
    if clean() != 0 {
        return 1
    }
    let first = agent_start(spec())
    if let Result::Ok(run) = first {
        let booked = await tool_call(run, "book", "{\"label\":\"ticket\"}")
        if let Result::Ok(value) = booked {
            if value != "\"booked ticket\"" {
                return 2
            }
        } else {
            return 3
        }
        let rolled = rollback(run, "finish booking")
        if let Result::Ok(count) = rolled {
            if count != 1 or RELEASED != 1 {
                return 4
            }
        } else {
            return 5
        }
        if let Result::Err(_problem) = agent_end(run) {
            return 6
        }
    } else {
        return 7
    }

    // The outer `book` result is replayed. Its nested compensation declaration
    // must be rebuilt before the recorded rollback is resolved.
    let replay = agent_start(spec())
    if let Result::Ok(run) = replay {
        let booked = await tool_call(run, "book", "{\"label\":\"ticket\"}")
        if let Result::Ok(value) = booked {
            if value != "\"booked ticket\"" {
                return 8
            }
        } else {
            return 9
        }
        let rolled = rollback(run, "finish booking")
        if let Result::Ok(count) = rolled {
            if count != 1 or RELEASED != 1 {
                return 10
            }
        } else {
            return 11
        }
        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            if str.contains(report, "\"replay\":true") == false or str.contains(report, "\"tool_calls\":2") == false {
                return 12
            }
        } else {
            return 13
        }
    } else {
        return 14
    }
    let journal = fs.fs_read(PATH)
    if let Result::Ok(body) = journal {
        if str.count_occurrences(body, "\"kind\":\"compensation\"") != 1 or str.count_occurrences(body, "\"kind\":\"rollback\"") != 1 {
            return 15
        }
    } else {
        return 16
    }
    println("nested compensation -> rollback restored on replay")
    return 0
}

public func main() returns int {
    let prepared = fs.create_dir_all(DIR)
    if let Result::Err(_problem) = prepared {
        return 20
    }
    return block_on(verify())
}
