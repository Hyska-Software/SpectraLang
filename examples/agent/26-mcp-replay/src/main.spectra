module main

// Example 26 — MCP discovery and a remote call are journaled effects. After the
// first server is closed, a resumed run can reinstall the recorded descriptor
// and return the recorded tool result without contacting the endpoint.

from std.io import println
import std.agent
import std.error as error
import std.fs as fs
import std.string as str

const DIR = ".spectra/example-26-mcp-replay"
const RUN_ID = "mcp-replay"
const AUTHORITY_FILE = DIR + "/authority.txt"

#[derive(Serialize, Deserialize)]
public record AddArgs {
    a: int,
    b: int,
}

#[agent_tool("Adds two integers for MCP")]
public async func add(run: Run, args: AddArgs) returns int {
    return args.a + args.b
}

func spec() returns string {
    return "{\"goal\":\"example-mcp-replay\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[\"mcp\",\"spectra.std.fs\"],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":26,\"journal\":\"" +
        DIR +
        "\",\"journal_payloads\":true,\"run_id\":\"" +
        RUN_ID +
        "\"}"
}

func journal_path() returns string {
    return DIR + "/" + RUN_ID + ".jsonl"
}

func clean(pathname: string) returns int {
    let exists = fs.fs_exists(pathname)
    if let Result::Ok(present) = exists {
        if present == true {
            let removed = fs.fs_remove(pathname)
            if let Result::Ok(ok) = removed {
                if ok == true {
                    return 0
                }
            }
            return 1
        }
        return 0
    }
    return 1
}

func read(pathname: string) returns string {
    let contents = fs.fs_read(pathname)
    if let Result::Ok(body) = contents {
        return body
    }
    return ""
}

async func verify() returns int {
    if clean(journal_path()) != 0 {
        return 1
    }
    if clean(AUTHORITY_FILE) != 0 {
        return 2
    }

    let first     = agent_start(spec())
    let authority = ""
    if let Result::Ok(run) = first {
        let served = mcp_serve(run, "127.0.0.1:0")
        if let Result::Ok(bound) = served {
            authority = bound
        } else {
            return 3
        }
        if let Result::Err(problem) = fs.fs_write(AUTHORITY_FILE, authority) {
            println("authority write failed: " + error.message(problem))
            return 4
        }
        let connected = await mcp_connect(run, "http://" + authority + "/mcp")
        if let Result::Ok(document) = connected {
            if str.contains(document, "\"remoteName\":\"add\"") == false {
                return 5
            }
        } else {
            return 6
        }
        let namespace = str.replace(str.replace(authority, ".", "_"), ":", "_")
        let invoked   = await tool_call(run, "mcp__" + namespace + "__add", "{\"a\":20,\"b\":22}")
        if let Result::Ok(value) = invoked {
            if value != "42" {
                return 7
            }
        } else {
            return 8
        }
        if let Result::Err(problem) = agent_end(run) {
            println("first end failed: " + error.message(problem))
            return 9
        }
    } else {
        return 10
    }

    // The listener from the first run is gone. A replay must not need it.
    let saved = read(AUTHORITY_FILE)
    if saved != authority || saved == "" {
        return 11
    }
    let replay = agent_start(spec())
    if let Result::Ok(run) = replay {
        let connected = await mcp_connect(run, "http://" + saved + "/mcp")
        if let Result::Ok(document) = connected {
            if str.contains(document, "\"remoteName\":\"add\"") == false {
                return 12
            }
        } else {
            return 13
        }
        let namespace = str.replace(str.replace(saved, ".", "_"), ":", "_")
        let invoked   = await tool_call(run, "mcp__" + namespace + "__add", "{\"a\":20,\"b\":22}")
        if let Result::Ok(value) = invoked {
            if value != "42" {
                return 14
            }
        } else {
            return 15
        }
        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            if str.contains(report, "\"replay\":true") == false {
                return 16
            }
        } else {
            return 17
        }
    } else {
        return 18
    }

    let journal = read(journal_path())
    if str.count_occurrences(journal, "\"kind\":\"mcp\"") != 1 {
        return 19
    }
    // The loopback server executes the local tool once; the client dispatch
    // records its remote call separately. Both are governed tool effects.
    if str.count_occurrences(journal, "\"kind\":\"tool\"") != 2 {
        return 20
    }
    println("MCP replay -> discovery and remote result reused")
    return 0
}

public func main() returns int {
    return block_on(verify())
}
