module main

// Example 28 — the untrusted-content policy is explicit at a sensitive sink.
// `allow` proceeds, while `block` can be released only by an attributable
// trust decision. The default `approve` denial is covered by fixture 377,
// whose validator intentionally runs the process-level refusal mode.

from std.io import println
import std.agent
import std.error as error
import std.fs as fs
import std.string as str

const WORK_DIR = ".spectra/example-28-taint-policy"
const TARGET = WORK_DIR + "/policy.txt"

#[derive(Serialize, Deserialize)]
public record WriteArgs {
    path: string,
    body: string,
}

#[agent_tool("Writes one policy-controlled file")]
public async func write_file(run: Run, args: WriteArgs) returns bool {
    let written = fs.fs_write(args.path, args.body)
    if let Result::Ok(ok) = written {
        return ok
    }
    return false
}

func spec(policy: string, run_id: string) returns string {
    return "{\"goal\":\"example-taint-policy\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[\"spectra.std.fs.fs_write\"],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"" +
        policy +
        "\",\"seed\":28,\"journal\":\"\",\"run_id\":\"" +
        run_id +
        "\"}"
}

func clean_target() returns int {
    let exists = fs.fs_exists(TARGET)
    if let Result::Ok(present) = exists {
        if present == true {
            let removed = fs.fs_remove(TARGET)
            if let Result::Err(_problem) = removed {
                return 1
            }
        }
    }
    return 0
}

func target_exists() returns bool {
    let present = fs.fs_exists(TARGET)
    if let Result::Ok(value) = present {
        return value
    }
    return false
}

async func check_policy(policy: string, run_id: string) returns int {
    if clean_target() != 0 {
        return 1
    }
    let started = agent_start(spec(policy, run_id))
    if let Result::Err(problem) = started {
        println("start failed: " + error.message(problem))
        return 2
    }
    if let Result::Ok(run) = started {
        let marked = untrusted(run, "remote content", "external:web")
        if let Result::Err(problem) = marked {
            println("taint failed: " + error.message(problem))
            return 3
        }
        if policy == "block" {
            // A block policy is safe after an attributable declassification;
            // the process-level denial path is exercised by fixture 377.
            let released = trust(run, "remote content", "reviewed in the example")
            if let Result::Err(_problem) = released {
                return 4
            }
        }
        let attempted = await tool_call(
            run,
            "write_file",
            "{\"path\":\"" + TARGET + "\",\"body\":\"" + policy + "\"}",
        )
        if let Result::Ok(value) = attempted {
            if value != "true" or target_exists() == false {
                return 5
            }
        } else {
            return 6
        }
        let ended = agent_end(run)
        if let Result::Err(problem) = ended {
            println("end failed: " + error.message(problem))
            return 13
        }
    }
    return 0
}

public func main() returns int {
    let prepared = fs.create_dir_all(WORK_DIR)
    if let Result::Err(_problem) = prepared {
        return 20
    }
    let allowed = block_on(check_policy("allow", "taint-allow"))
    if allowed != 0 {
        return allowed
    }
    let blocked = block_on(check_policy("block", "taint-block"))
    if blocked != 0 {
        return 30 + blocked
    }
    println("taint policy -> allow and trust-aware block")
    return 0
}
