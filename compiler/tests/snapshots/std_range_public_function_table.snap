module std.range
type std.range.Range: record Range
func std.range.create: func(int, int, bool) returns Range
func std.range.len: func(Range) returns int
func std.range.at: func(Range, int) returns int
func std.range.eq: func(Range, Range) returns bool
func std.range.start: func(Range) returns int
func std.range.end: func(Range) returns int
func std.range.is_inclusive: func(Range) returns bool
func std.range.iter: func(Range) returns Iterator<int>
