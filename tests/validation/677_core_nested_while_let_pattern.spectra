module core_nested_while_let_pattern

enum Step {
    More { state: (int, int), next: int },
    Done,
}

func next_step(cursor: int) returns Step {
    if cursor < 3 {
        return Step::More { state: (cursor, cursor + 10), next: cursor + 1 }
    }
    return Step::Done
}

func sum_middle() returns int {
    let cursor = 0
    let total  = 0
    while let Step::More { state: (value, _), next } = next_step(cursor) {
        if value == 0 {
            cursor = next
            continue
        }
        if value == 2 {
            break
        }
        total = total + value
        cursor = next
    }
    return total
}

public func main() returns int {
    if sum_middle() != 1 {
        return 1
    }
    return 0
}
