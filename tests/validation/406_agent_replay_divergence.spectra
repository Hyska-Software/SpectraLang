module agent_replay_divergence

// What replay does when the run does *not* repeat itself, and what it charges.
//
// Replay is positional: each effect resolves the journal step at its own index
// and compares the recorded kind and input digest with the one being executed
// (ADR 0018). Three consequences are pinned here, at the language surface:
//
//   * a resumed run that asks for a *different* effect than the journal records
//     is a **divergence**: it fails closed with a typed `journal_error` naming
//     the step and both digests rather than silently executing a different
//     program or answering with the wrong record. A divergence is a
//     caller-level failure, so the run's outcome is untouched -- the report
//     still says what the run itself did;
//   * a step the journal does not hold yet **executes and is appended**, so a
//     partial journal (a run that stopped early) resumes forward: the recorded
//     prefix replays without the provider, and the new step runs once;
//   * a replay re-applies the *recorded usage* to the run's budget, so a
//     resumed run's headroom matches the fresh run's -- a replay is not a
//     discount, and a run resumed under the same ceiling resumes with the same
//     accounts.

from std.io import println
import std.agent
import std.convert as convert
import std.error as error
import std.fs as fs
import std.string as str

const DIR = ".spectra/fixture-406-journal"

func spec(run_id: string, ceiling: string) returns string {
    return "{\"goal\":\"replay-divergence\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":" +
        ceiling +
        ",\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"allow\",\"seed\":7,\"journal\":\"" +
        DIR +
        "\",\"run_id\":\"" +
        run_id +
        "\"}"
}

func journal_path(run_id: string) returns string {
    return DIR + "/" + run_id + ".jsonl"
}

func clean(path: string) returns int {
    let present = fs.fs_exists(path)
    if let Result::Ok(exists) = present {
        if exists == true {
            let removed = fs.fs_remove(path)
            if let Result::Ok(ok) = removed {
                if ok == true {
                    return 0
                }
            }
            return 1
        }
        return 0
    }
    return 1
}

// One record per effect, so this counts the journal's steps.
func steps_in_journal(run_id: string) returns int {
    let text = fs.fs_read(journal_path(run_id))
    if let Result::Ok(body) = text {
        return str.count_occurrences(body, "\"idempotency_key\"")
    }
    if let Result::Err(problem) = text {
        let _ = problem
        return -1
    }
    return -2
}

// A: the same run id, a different request -- refused as a divergence.
async func a_different_request_diverges() returns int {
    let fresh = agent_start(spec("fixture-406-divergence", "0"))
    if let Result::Err(problem) = fresh {
        println("start failed: " + error.message(problem))
        return 1
    }
    if let Result::Ok(run) = fresh {
        let turn = await ask(run, "alpha")
        if let Result::Err(problem) = turn {
            println("fresh turn failed: " + error.message(problem))
            return 2
        }
        let ended = agent_end(run)
        if let Result::Err(problem) = ended {
            println("end failed: " + error.message(problem))
            return 3
        }
    }

    let resumed = agent_start(spec("fixture-406-divergence", "0"))
    if let Result::Ok(run) = resumed {
        let diverged = await ask(run, "beta")
        if let Result::Err(problem) = diverged {
            let message = error.message(problem)
            println("diverged -> " + message)
            if str.contains(message, "journal_error") == false {
                return 4
            }
            if str.contains(message, "replay divergence at step 0") == false {
                return 5
            }
            // Both digests, so the operator can see *what* diverged without the
            // payloads: the journal's record and the step being executed.
            if str.contains(message, "the journal holds a 'model' step with input digest") == false {
                return 6
            }
            if str.contains(message, "this run is a 'model' step with input digest") == false {
                return 7
            }
        } else {
            println("a different request replayed the recorded answer")
            return 8
        }

        // The failure is the caller's; the run's own outcome is untouched.
        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            println("report   -> " + report)
            if str.contains(report, "\"replay\":true") == false {
                return 9
            }
            if str.contains(report, "\"steps\":0") == false {
                return 10
            }
            if str.contains(report, "\"status\":\"completed\"") == false {
                return 11
            }
        } else {
            return 12
        }
    } else {
        return 13
    }
    return 0
}

// B: a partial journal resumes forward -- the prefix replays, the new step runs.
async func a_partial_journal_resumes_forward() returns int {
    let fresh = agent_start(spec("fixture-406-forward", "0"))
    if let Result::Ok(run) = fresh {
        let turn = await ask(run, "alpha")
        if let Result::Err(problem) = turn {
            println("fresh turn failed: " + error.message(problem))
            return 1
        }
        let ended = agent_end(run)
        if let Result::Err(problem) = ended {
            println("end failed: " + error.message(problem))
            return 2
        }
    } else {
        return 3
    }
    let before = steps_in_journal("fixture-406-forward")
    println("journal  -> " + convert.int_to_string(before) + " steps before the resume")
    if before != 1 {
        return 4
    }

    let resumed = agent_start(spec("fixture-406-forward", "0"))
    if let Result::Ok(run) = resumed {
        let replayed = await ask(run, "alpha")
        if let Result::Err(problem) = replayed {
            println("replay failed: " + error.message(problem))
            return 5
        }
        if let Result::Ok(text) = replayed {
            if text != "mock echo: alpha" {
                println("replayed a different answer: " + text)
                return 6
            }
        }
        let unchanged = steps_in_journal("fixture-406-forward")
        if unchanged != 1 {
            println("the replay appended: " + convert.int_to_string(unchanged))
            return 7
        }

        // A step with no record: it executes and is appended.
        let appended = await ask(run, "gamma")
        if let Result::Err(problem) = appended {
            println("appended turn failed: " + error.message(problem))
            return 8
        }
        if let Result::Ok(text) = appended {
            if text != "mock echo: gamma" {
                println("unexpected appended answer: " + text)
                return 9
            }
        }
        let after = steps_in_journal("fixture-406-forward")
        println("journal  -> " + convert.int_to_string(after) + " steps after the resume")
        if after != 2 {
            return 10
        }

        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            println("report   -> " + report)
            if str.contains(report, "\"steps\":2") == false {
                return 11
            }
            if str.contains(report, "\"replay\":true") == false {
                return 12
            }
        } else {
            return 13
        }
    } else {
        return 14
    }
    return 0
}

// C: a replay re-applies the recorded usage to the budget.
async func a_replay_recharges_the_recorded_usage() returns int {
    let fresh = agent_start(spec("fixture-406-budget", "6"))
    if let Result::Ok(run) = fresh {
        let turn = await ask(run, "alpha")
        if let Result::Err(problem) = turn {
            println("fresh turn failed: " + error.message(problem))
            return 1
        }
        let left = budget_remaining(run)
        if let Result::Ok(value) = left {
            println("fresh    -> " + convert.int_to_string(value) + " tokens left")
            if value != 2 {
                return 2
            }
        } else {
            return 3
        }
        let ended = agent_end(run)
        if let Result::Err(problem) = ended {
            println("end failed: " + error.message(problem))
            return 4
        }
    } else {
        return 5
    }

    let resumed = agent_start(spec("fixture-406-budget", "6"))
    if let Result::Ok(run) = resumed {
        let replayed = await ask(run, "alpha")
        if let Result::Err(problem) = replayed {
            println("replay failed: " + error.message(problem))
            return 6
        }
        let left = budget_remaining(run)
        if let Result::Ok(value) = left {
            println("replayed -> " + convert.int_to_string(value) + " tokens left")
            // The same headroom: the recorded usage is applied again, so a
            // resumed run cannot spend the budget twice.
            if value != 2 {
                return 7
            }
        } else {
            return 8
        }
        let ended = agent_end(run)
        if let Result::Err(problem) = ended {
            println("end failed: " + error.message(problem))
            return 9
        }
    } else {
        return 10
    }
    return 0
}

public func main() returns int {
    let prepared = fs.create_dir_all(DIR)
    if let Result::Err(problem) = prepared {
        println("journal dir failed: " + error.message(problem))
        return 30
    }
    let a = clean(journal_path("fixture-406-divergence"))
    let b = clean(journal_path("fixture-406-forward"))
    let c = clean(journal_path("fixture-406-budget"))
    if a + b + c != 0 {
        return 31
    }
    let first = block_on(a_different_request_diverges())
    if first != 0 {
        return first
    }
    let second = block_on(a_partial_journal_resumes_forward())
    if second != 0 {
        return 20 + second
    }
    let third = block_on(a_replay_recharges_the_recorded_usage())
    if third != 0 {
        return 40 + third
    }
    return 0
}
