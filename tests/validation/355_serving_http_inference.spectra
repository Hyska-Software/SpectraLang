// R-3001 acceptance: a fresh spectralang process serves a real linear model
// over HTTP and returns genuine inference values.
//
// Registers y = relu(2x), starts the embedded listener on an ephemeral port
// (port 0 -> the OS-assigned port is returned), then drives real localhost
// HTTP through the std.api async client with an explicit loopback-allowing
// SSRF policy (the default policy blocks 127.0.0.1).
//
// Assertion strategy (the std.api HTTP surface exposes status, headers and
// body length, but no response-body text accessor):
//   * the exact forward-pass value (input 3.5 -> 7.0) is pinned in-process on
//     the SAME registered model via server_infer + server_result_vector +
//     tensor.get_f;
//   * the HTTP route is proven to serve that live model (not a stub) by
//     POSTing two inputs whose {:.6}-formatted outputs differ in width
//     ("7.000000" vs "100.000000", a +2 byte body-length delta) and by
//     asserting 200 + JSON content-type on /infer and /metrics.
// Exit code 0 asserts every check survived the round trip.
module serving_http_inference

import std.convert as convert
import std.math as math
import std.serve as serve
import std.string as str
import std.tensor as tensor
from std.api.client import Client, new as client_new, request as client_request, set_ssrf_policy
from std.api.http import Request, Response, method_get, method_post, request, request_with_body, response_body_len, response_header, response_status
from std.api.security import SsrfPolicy, ssrf_allow_private_networks, ssrf_policy

async func drive(port: int) returns int {
    let client: Client = client_new()
    let base_policy: SsrfPolicy = ssrf_policy()
    let local_policy: SsrfPolicy = ssrf_allow_private_networks(base_policy, true)
    if set_ssrf_policy(client, local_policy) != true {
        return 20
    }
    let base: string = str.concat("http://127.0.0.1:", convert.int_to_string(port))

    let infer_url: string = str.concat(base, "/infer")
    let small: Response = await client_request(client, request_with_body(request(method_post(), infer_url), "{\"inputs\":[3.5]}"))
    if response_status(small) != 200 {
        return 21
    }
    if str.contains(response_header(small, "content-type"), "application/json") != true {
        return 22
    }
    let len_small: int = response_body_len(small)
    if len_small <= 0 {
        return 23
    }
    let big: Response = await client_request(client, request_with_body(request(method_post(), infer_url), "{\"inputs\":[50.0]}"))
    if response_status(big) != 200 {
        return 24
    }
    let len_big: int = response_body_len(big)
    if len_big - len_small != 2 {
        return 25
    }

    let metrics: Response = await client_request(client, request(method_get(), str.concat(base, "/metrics")))
    if response_status(metrics) != 200 {
        return 26
    }
    if response_body_len(metrics) <= 0 {
        return 27
    }
    return 0
}

public func main() returns int {
    serve.reset()

    let server = serve.server_new(1)
    let weights = tensor.full2_f(1, 1, 2.0)
    let biases = tensor.full_f(1, 0.0)
    if serve.server_register_model_linear(server, weights, biases, 0) != 1 {
        return 1
    }
    let probe = tensor.full_f(1, 3.5)
    let req: int = serve.server_infer(server, "default", probe)
    let out = serve.server_result_vector(server, req)
    if math.abs_f(tensor.get_f(out, 0) - 7.0) > 0.000001 {
        return 2
    }
    if serve.server_warmup(server) != true {
        return 3
    }
    let port: int = serve.http_start(server, 0)
    if port <= 0 {
        return 4
    }
    let http_result: int = block_on(drive(port))
    if http_result != 0 {
        serve.http_stop(server)
        return http_result
    }
    if serve.http_stop(server) != true {
        return 30
    }
    return 0
}
