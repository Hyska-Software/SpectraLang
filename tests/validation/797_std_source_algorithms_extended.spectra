// Consumer for the extended `std.algorithms` surface: search, radix
// conversion, number theory, Roman numerals and Unicode-aware edit distance.
module std_source_algorithms_extended

import std.algorithms as algorithms
import std.collections as collections
import std.option as option

func search(values: List<int>, target: int) returns int {
    return algorithms.binary_search_int(values, target)
}

public func main() returns int {
    // ── binary_search_int ────────────────────────────────────────────────
    let sorted: List<int> = collections.list_new()
    collections.list_push(sorted, 1)
    collections.list_push(sorted, 3)
    collections.list_push(sorted, 3)
    collections.list_push(sorted, 7)
    if search(sorted, 1) != 0 {
        return 1
    }
    if search(sorted, 7) != 3 {
        return 2
    }
    let duplicate = search(sorted, 3)
    if duplicate < 1 or duplicate > 2 {
        return 3
    }
    if search(sorted, 4) != -1 {
        return 4
    }
    let empty: List<int> = collections.list_new()
    if search(empty, 0) != -1 {
        return 5
    }

    // ── to_base / from_base ──────────────────────────────────────────────
    if option.option_unwrap_or(algorithms.to_base(0, 10), "x") != "0" {
        return 6
    }
    if option.option_unwrap_or(algorithms.to_base(255, 16), "x") != "ff" {
        return 7
    }
    if option.option_unwrap_or(algorithms.to_base(5, 2), "x") != "101" {
        return 8
    }
    if option.option_unwrap_or(algorithms.to_base(35, 36), "x") != "z" {
        return 9
    }
    if option.option_unwrap_or(algorithms.to_base(9223372036854775807, 10), "x") != "9223372036854775807" {
        return 10
    }
    if option.is_some(algorithms.to_base(-1, 10)) {
        return 11
    }
    if option.is_some(algorithms.to_base(10, 1)) or option.is_some(algorithms.to_base(10, 37)) {
        return 12
    }

    if option.option_unwrap_or(algorithms.from_base("ff", 16), -1) != 255 {
        return 13
    }
    if option.option_unwrap_or(algorithms.from_base("FF", 16), -1) != 255 {
        return 14
    }
    if option.option_unwrap_or(algorithms.from_base("z", 36), -1) != 35 {
        return 15
    }
    if option.option_unwrap_or(algorithms.from_base("0", 10), -1) != 0 {
        return 16
    }
    if option.is_some(algorithms.from_base("", 10)) {
        return 17
    }
    if option.is_some(algorithms.from_base("2", 2)) {
        return 18
    }
    if option.is_some(algorithms.from_base("-1", 10)) {
        return 19
    }
    if option.is_some(algorithms.from_base("zzzzzzzzzzzzz", 36)) {
        return 20
    }

    // ── mod_inverse ──────────────────────────────────────────────────────
    if option.option_unwrap_or(algorithms.mod_inverse(3, 11), -1) != 4 {
        return 21
    }
    if option.option_unwrap_or(algorithms.mod_inverse(10, 17), -1) != 12 {
        return 22
    }
    if option.is_some(algorithms.mod_inverse(2, 4)) {
        return 23
    }
    if option.is_some(algorithms.mod_inverse(0, 1)) {
        return 24
    }
    if option.is_some(algorithms.mod_inverse(-3, 11)) {
        return 25
    }

    // ── factorial / binomial ─────────────────────────────────────────────
    if option.option_unwrap_or(algorithms.factorial(0), -1) != 1 {
        return 26
    }
    if option.option_unwrap_or(algorithms.factorial(5), -1) != 120 {
        return 27
    }
    if option.option_unwrap_or(algorithms.factorial(20), -1) != 2432902008176640000 {
        return 28
    }
    if option.is_some(algorithms.factorial(21)) or option.is_some(algorithms.factorial(-1)) {
        return 29
    }

    if option.option_unwrap_or(algorithms.binomial(5, 2), -1) != 10 {
        return 30
    }
    if option.option_unwrap_or(algorithms.binomial(52, 5), -1) != 2598960 {
        return 31
    }
    if option.option_unwrap_or(algorithms.binomial(7, 7), -1) != 1 {
        return 32
    }
    if option.is_some(algorithms.binomial(3, 4)) or option.is_some(algorithms.binomial(-1, 0)) {
        return 33
    }

    // ── collatz_steps / digit_sum ────────────────────────────────────────
    if option.option_unwrap_or(algorithms.collatz_steps(1), -1) != 0 {
        return 34
    }
    if option.option_unwrap_or(algorithms.collatz_steps(6), -1) != 8 {
        return 35
    }
    if option.option_unwrap_or(algorithms.collatz_steps(27), -1) != 111 {
        return 36
    }
    if option.is_some(algorithms.collatz_steps(0)) {
        return 37
    }

    if algorithms.digit_sum(12345) != 15 {
        return 38
    }
    if algorithms.digit_sum(-987) != 24 {
        return 39
    }
    if algorithms.digit_sum(0) != 0 {
        return 40
    }

    // ── roman_encode / roman_decode ──────────────────────────────────────
    if option.option_unwrap_or(algorithms.roman_encode(1), "x") != "I" {
        return 41
    }
    if option.option_unwrap_or(algorithms.roman_encode(4), "x") != "IV" {
        return 42
    }
    if option.option_unwrap_or(algorithms.roman_encode(2024), "x") != "MMXXIV" {
        return 43
    }
    if option.option_unwrap_or(algorithms.roman_encode(3999), "x") != "MMMCMXCIX" {
        return 44
    }
    if option.is_some(algorithms.roman_encode(0)) or option.is_some(algorithms.roman_encode(4000)) {
        return 45
    }

    if option.option_unwrap_or(algorithms.roman_decode("MMXXIV"), -1) != 2024 {
        return 46
    }
    if option.option_unwrap_or(algorithms.roman_decode("IV"), -1) != 4 {
        return 47
    }
    if option.option_unwrap_or(algorithms.roman_decode("MCMXCIX"), -1) != 1999 {
        return 48
    }
    if option.is_some(algorithms.roman_decode("")) or option.is_some(algorithms.roman_decode("ABC")) {
        return 49
    }

    // ── levenshtein (Unicode scalar values) ──────────────────────────────
    if algorithms.levenshtein("", "") != 0 {
        return 50
    }
    if algorithms.levenshtein("abc", "") != 3 {
        return 51
    }
    if algorithms.levenshtein("", "abcd") != 4 {
        return 52
    }
    if algorithms.levenshtein("kitten", "sitting") != 3 {
        return 53
    }
    if algorithms.levenshtein("café", "cafe") != 1 {
        return 54
    }
    if algorithms.levenshtein("café", "café") != 0 {
        return 55
    }
    if algorithms.levenshtein("😀a", "a") != 1 {
        return 56
    }
    if algorithms.levenshtein("a😀", "😀a") != 2 {
        return 57
    }

    
    // Symmetry: the loop bound (min(k, n-k)) drives the numerator too.
    if option.option_unwrap_or(algorithms.binomial(5, 4), -1) != 5 {
        return 58
    }
    if option.option_unwrap_or(algorithms.binomial(10, 7), -1) != 120 {
        return 59
    }
    if option.option_unwrap_or(algorithms.binomial(52, 48), -1) != 270725 {
        return 60
    }

    return 0
}
