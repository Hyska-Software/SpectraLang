module core_array_iteration_shadowing

func selected_sum() returns int {
    let values = [3, 5, 7, 9]
    let item = 100
    item = item + 1
    let total = 0

    for item in values {
        if item == 5 {
            continue
        }
        total = total + item
        item = item + 100
    }

    if item != 101 {
        return -1
    }
    return total
}

public func main() returns int {
    if selected_sum() != 19 {
        return 1
    }
    return 0
}
