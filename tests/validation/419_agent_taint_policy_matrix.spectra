module agent_taint_policy_matrix

// The policy matrix at a real sink: allow records a pass, approve fails closed
// without an approver, and block can proceed only after trust declassifies the
// exact value that entered the run.

from std.io import println
import std.agent
import std.error as error
import std.fs as fs
import std.string as str

const DIR = ".spectra/fixture-419-taint-policy"
const WORK = "target/agent-fixture-419"

#[derive(Serialize, Deserialize)]
public record WriteArgs {
    path: string,
    body: string,
}

#[agent_tool("Writes a taint-policy fixture file")]
public async func writer(run: Run, args: WriteArgs) returns bool {
    let written = fs.fs_write(args.path, args.body)
    if let Result::Ok(ok) = written {
        return ok
    }
    return false
}

func spec(run_id: string, policy: string) returns string {
    return "{\"goal\":\"fixture-419-taint-policy\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[\"spectra.std.fs.fs_write\"],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"" +
        policy +
        "\",\"seed\":419,\"journal\":\"" +
        DIR +
        "\",\"journal_payloads\":true,\"run_id\":\"" +
        run_id +
        "\"}"
}

func path(run_id: string) returns string {
    return DIR + "/" + run_id + ".jsonl"
}

func exists(pathname: string) returns bool {
    let result = fs.fs_exists(pathname)
    if let Result::Ok(value) = result {
        return value
    }
    return false
}

func clean(pathname: string) returns int {
    if exists(pathname) {
        let removed = fs.fs_remove(pathname)
        if let Result::Err(_problem) = removed {
            return 1
        }
    }
    return 0
}

async func allow_is_auditable() returns int {
    let run_id = "fixture-419-allow"
    let target = WORK + "/allow.txt"
    if clean(path(run_id)) != 0 or clean(target) != 0 {
        return 1
    }
    let started = agent_start(spec(run_id, "allow"))
    if let Result::Ok(run) = started {
        let marked = untrusted(run, "incoming body", "external:web")
        if let Result::Err(_problem) = marked {
            return 2
        }
        let called = await tool_call(
            run,
            "writer",
            "{\"path\":\"" + target + "\",\"body\":\"allowed\"}",
        )
        if let Result::Ok(value) = called {
            if value != "true" or exists(target) == false {
                return 3
            }
        } else {
            return 4
        }
        if let Result::Err(_problem) = agent_end(run) {
            return 5
        }
    } else {
        return 6
    }
    let journal = fs.fs_read(path(run_id))
    if let Result::Ok(body) = journal {
        if str.contains(body, "\"kind\":\"taint_decision\"") == false or str.contains(body, "\"output\":\"allow\"") == false {
            return 7
        }
    } else {
        return 8
    }
    return 0
}

async func block_requires_trust() returns int {
    let run_id = "fixture-419-block"
    let target = WORK + "/block.txt"
    if clean(path(run_id)) != 0 or clean(target) != 0 {
        return 1
    }
    let started = agent_start(spec(run_id, "block"))
    if let Result::Ok(run) = started {
        let marked = untrusted(run, "reviewed body", "external:web")
        if let Result::Err(_problem) = marked {
            return 2
        }
        // The process-level denial mode is exercised by fixture 377. This
        // recoverable path proves that trust releases the exact digest.
        let released = trust(run, "reviewed body", "operator review")
        if let Result::Err(_problem) = released {
            return 3
        }
        let allowed = await tool_call(
            run,
            "writer",
            "{\"path\":\"" + target + "\",\"body\":\"after\"}",
        )
        if let Result::Ok(value) = allowed {
            if value != "true" or exists(target) == false {
                return 4
            }
        } else {
            return 5
        }
        if let Result::Err(_problem) = agent_end(run) {
            return 6
        }
    } else {
        return 7
    }
    let journal = fs.fs_read(path(run_id))
    if let Result::Ok(body) = journal {
        if str.contains(body, "\"output\":\"deny\"") == true {
            return 8
        }
        if str.contains(body, "operator review") == false {
            return 9
        }
    } else {
        return 10
    }
    return 0
}

public func main() returns int {
    let prepared = fs.create_dir_all(DIR)
    if let Result::Err(_problem) = prepared {
        return 30
    }
    let work = fs.create_dir_all(WORK)
    if let Result::Err(_problem) = work {
        return 31
    }
    let allowed = block_on(allow_is_auditable())
    if allowed != 0 {
        return allowed
    }
    let blocked = block_on(block_requires_trust())
    if blocked != 0 {
        return 10 + blocked
    }
    println("fixture 419 -> taint allow and trust-aware block passed")
    return 0
}
