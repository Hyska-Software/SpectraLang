module std_round8_serve_output_error_result

from std.error import Error, ErrorCode
import std.error as error
import std.serve as serve
import std.string as string
import std.tensor as tensor

public func main() returns int {
    serve.reset()
    let server  = serve.server_new(793)
    let weights = tensor.full2_f(1, 1, 2.0)
    let biases  = tensor.full_f(1, 1.0)
    if serve.server_register_model_linear(server, weights, biases, 0) != 1 {
        tensor.free_all()
        serve.reset()
        return 1
    }
    if not serve.server_set_fallback(server, -793) or not serve.server_set_output_policy(server, 0, 6) {
        tensor.free_all()
        serve.reset()
        return 2
    }
    if not serve.server_warmup(server) {
        tensor.free_all()
        serve.reset()
        return 3
    }

    let request = serve.server_enqueue(server, 3)
    if serve.server_process_batch(server, 1) != 1 or serve.server_result(server, request) != -793 {
        tensor.free_all()
        serve.reset()
        return 4
    }
    let diagnostic = serve.server_last_diagnostic(server)
    if not string.contains(diagnostic, "output") or not string.contains(diagnostic, "range") {
        tensor.free_all()
        serve.reset()
        return 5
    }

    let problem = error.new(
        ErrorCode::InvalidArgument,
        "serving output was rejected",
        "server_process_batch",
        diagnostic,
        "std.serve",
        false,
    )
    let outcome: Result<int, Error> = Result::Err(problem)
    if let Result::Err(issue) = outcome {
        if error.code(issue) != 0 or error.retryable(issue) != false or error.operation(issue) != "server_process_batch" {
            tensor.free_all()
            serve.reset()
            return 6
        }
        if not string.contains(error.context(issue), "output") or not string.contains(error.message(issue), "rejected") {
            tensor.free_all()
            serve.reset()
            return 7
        }
    } else {
        tensor.free_all()
        serve.reset()
        return 8
    }

    tensor.free_all()
    serve.reset()
    return 0
}
