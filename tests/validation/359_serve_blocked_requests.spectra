module serve_blocked_requests

import std.serve as serve
import std.string as string
import std.tensor as tensor

public func main() returns int {
    serve.reset()

    let server = serve.server_new(3)
    let weights = tensor.full2_f(1, 1, 3.0)
    let biases = tensor.full_f(1, 0.0)
    if serve.server_register_model_linear(server, weights, biases, 0) != 1 {
        return 1
    }
    if serve.server_warmup(server) != true {
        return 2
    }
    if serve.server_set_rate_limit(server, 1) != true {
        return 3
    }
    let ok      = serve.server_enqueue(server, 5)
    let blocked = serve.server_enqueue(server, 6)
    // A guardrail-blocked request reads as the configured fallback
    // (default -1)...
    if serve.server_result(server, blocked) != -1 {
        return 4
    }
    // ...is never queued...
    if serve.server_pending(server) != 1 {
        return 5
    }
    // ...and records the guardrail diagnostic plus audit trail.
    if string.contains(serve.server_last_diagnostic(server), "rate_limit") != true {
        return 6
    }
    if string.contains(serve.server_audit_log(server), "blocked") != true {
        return 7
    }
    // The pending request still reads -1 (documented default collision)
    // and completes normally once processed.
    if serve.server_result(server, ok) != -1 {
        return 8
    }
    if serve.server_process_batch(server, 1) != 1 {
        return 9
    }
    if serve.server_result(server, ok) != 15 {
        return 10
    }
    // Cancelling an already-decided blocked request is refused.
    if serve.server_cancel(server, blocked) != false {
        return 11
    }
    if serve.server_result(server, blocked) != -1 {
        return 12
    }
    serve.reset()
    return 0
}
