module record_reassign_in_loop

// Regression: assigning a whole record to a local must rebind the local's
// authoritative base address. A reassigned record local keeps its current
// pointer in a promoted slot (the slot is function-scoped, the struct binding
// map is block-scoped); reads resolve through the slot, so an assignment inside
// a loop survives the loop scope and a suspension. Before the fix the
// assignment stored the new pointer into the slot while reads used the stale
// initial literal, so loop reassignments were lost or read the slot itself.

record Pair {
    a: int
    b: int
}

from std.api.db.sqlite import SqliteConnection, open as sqlite_open, close as sqlite_close, execute_async as sqlite_execute_async

async func delayed_tick(value: int) returns int {
    // Await a real background database task that materializes an 8 MiB row.
    // This keeps the child pending while the parent coroutine suspends.
    let connection: SqliteConnection = sqlite_open(":memory:")
    let affected: int = await sqlite_execute_async(connection, "SELECT randomblob(8388608)")
    sqlite_close(connection)
    if affected != 0 {
        return-1
    }
    return value
}

func sync_reassign_in_loop() returns int {
    let p = Pair { a: 0, b: 0 }
    let n = 0
    while n < 3 {
        p = Pair { a: p.a + 1, b: p.b + 2 }
        n = n + 1
    }
    if p.a != 3 {
        return 1
    }
    if p.b != 6 {
        return 2
    }
    return 0
}

async func async_reassign_across_await() returns int {
    let p = Pair { a: 0, b: 0 }
    let n = 0
    while n < 3 {
        p = Pair { a: p.a + 1, b: p.b }
        let tick = await delayed_tick(n)
        if tick == n {
            p = Pair { a: p.a, b: p.b + 2 }
        }
        n = n + 1
    }
    // Read after the final suspension, outside the loop scope.
    if p.a != 3 {
        return 6
    }
    if p.b != 6 {
        return 7
    }
    return 0
}

public func main() returns int {
    let sync_result = sync_reassign_in_loop()
    if sync_result != 0 {
        return 10 + sync_result
    }

    let async_result = block_on(async_reassign_across_await())
    if async_result != 0 {
        return 20 + async_result
    }

    return 0
}
