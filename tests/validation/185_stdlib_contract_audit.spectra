module stdlib_contract_audit

from std.api.http import method_get, status_ok
import std.concurrent as concurrent
import std.error as error
import std.fs as fs
import std.math as math
import std.ml as ml
import std.range
import std.serve as serve
import std.string as string
import std.tensor as tensor
import std.time as time

public func main() returns int {
    if math.abs(-7) != 7 {
        return 1
    }
    if string.eq(string.concat("spectra", "lang"), "spectralang") != true {
        return 2
    }
    let path         = "target/r3007-stdlib-contract/probe.txt"
    let write_result = fs.fs_write(path, "stdlib-contract")
    if let Result::Ok(wrote) = write_result {
        if wrote != true {
            return 3
        }
    } else {
        return 3
    }
    let exists_result = fs.fs_exists(path)
    if let Result::Ok(exists) = exists_result {
        if exists != true {
            return 4
        }
    } else {
        return 4
    }
    let remove_result = fs.fs_remove(path)
    if let Result::Ok(removed) = remove_result {
        if removed != true {
            return 5
        }
    } else {
        return 5
    }

    let invalid_read = fs.fs_read("")
    if let Result::Err(fs_error) = invalid_read {
        if error.code(fs_error) != 0 {
            return 16
        }
    } else {
        return 16
    }

    let r = create(2, 5, false)
    if len(r) != 3 {
        return 6
    }
    if at(r, 2) != 4 {
        return 7
    }

    let duration = time.duration_ms(1)
    if time.duration_millis(duration) != 1 {
        return 7
    }
    tensor.free_all()
    let left  = tensor.arange(1, 5, 1)
    let right = tensor.arange(1, 5, 1)
    if tensor.dot(left, right) != 30 {
        return 9
    }
    let module_handle = ml.module_new()
    if module_handle == 0 { return 10
    }

    serve.reset()
    let server  = serve.server_new(3)
    let weights = tensor.full2_f(1, 1, 3.0)
    let biases  = tensor.full_f(1, 0.0)
    if serve.server_register_model_linear(server, weights, biases, 0) != 1 {
        return 11
    }
    let request = serve.server_enqueue(server, 10)
    serve.server_warmup(server)
    if serve.server_process_batch(server, 1) != 1 {
        return 12
    }
    if serve.server_result(server, request) != 30 {
        return 13
    }

    concurrent.reset()
    let task = concurrent.task_spawn_fn( | value: int | { value}, 42)
    if concurrent.task_join(task) != 42 {
        return 14
    }

    if method_get() != 1 or status_ok() != 200 {
        return 15
    }
    tensor.free_all()
    serve.reset()
    concurrent.reset()
    return 0
}
