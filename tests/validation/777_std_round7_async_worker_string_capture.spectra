module std_round7_async_worker_string_capture

import std.concurrent as concurrent
import std.string as string

async func ready(value: int) returns int {
    return value
}

async func inspect_on_worker(text: string) returns int {
    let prefix = await ready(1)
    let task   = concurrent.task_spawn_fn( | extra: int | {
            if string.contains(text, "é") and string.index_of(text, "é") == 7 {
                return string.len(text) + extra
            }
            return-1
        }, 2)
    let measured = concurrent.task_join(task)
    let resumed  = await ready(measured)
    return prefix + resumed
}

public func main() returns int {
    concurrent.reset()
    let text   = string.concat("worker:", "é")
    let result = block_on(inspect_on_worker(text))
    concurrent.reset()
    if result != 12 {
        return 1
    }
    return 0
}
