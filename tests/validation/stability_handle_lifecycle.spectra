module stability_handle_lifecycle

import std.collections as collections
import std.option as option
import std.range as range

public func main() returns int {
    let first = collections.list_new()
    collections.list_push(first, 10)
    collections.list_free(first)

    let second = collections.list_new()
    let released_first = collections.list_get(first, 0)
    if option.is_some(released_first) {
        return 1
    }
    collections.list_push(second, 20)
    let second_first = collections.list_get(second, 0)
    if option.is_none(second_first) or option.option_unwrap(second_first) != 20 {
        return 2
    }
    let released_again = collections.list_get(first, 0)
    if option.is_some(released_again) {
        return 3
    }
    collections.list_free(second)

    let map_a = collections.map_new()
    collections.map_free(map_a)
    let map_b = collections.map_new()
    let released_map = collections.map_get(map_a, 7)
    if option.is_some(released_map) {
        return 4
    }
    collections.map_set(map_b, 7, 14)
    let map_value = collections.map_get(map_b, 7)
    if option.is_none(map_value) or option.option_unwrap(map_value) != 14 {
        return 5
    }
    collections.map_free(map_b)

    let r = range.create(2, 4, false)
    if range.at(r, 1) != 3 {
        return 6
    }
    return 0
}
