module redis_driver

from std.api.db.redis import RedisConnection, open, close, get, set, delete, expire, incr, exists

public func main() returns int {
    let url: string                 = "__SPECTRA_REDIS_URL__"
    let fixture_key: string         = "spectra:r2507:fixture:__SPECTRA_REDIS_RUN_ID__"
    let counter_key: string         = "spectra:r2507:counter:__SPECTRA_REDIS_RUN_ID__"
    let connection: RedisConnection = open(url)
    if set(connection, fixture_key, "value") != true { return 11
    }
    if get(connection, fixture_key) != "value" { return 12
    }
    if exists(connection, fixture_key) != true { return 13
    }
    if expire(connection, fixture_key, 30) != true { return 14
    }
    if delete(connection, fixture_key) != true { return 15
    }
    if incr(connection, counter_key, 2) != 2 { return 16
    }
    if close(connection) != true { return 17
    }
    return 0
}
