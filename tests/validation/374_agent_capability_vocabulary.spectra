module agent_capability_vocabulary

// R-3215 positive fixture: a string-literal `AgentSpec` whose `allow` grants
// all resolve against the contract catalog.
//
//   * `spectra.std.fs` is a namespace grant; the catalog registers host calls
//     whose runtime name starts with it (`spectra.std.fs.fs_read`, ...).
//   * `spectra.std.fs.fs_read` names one host call in full.
//   * `spectra.api.client.request:host=api.example.com` is scoped;
//     `std.api.client.request` declares `scope_keys = ["host", "method"]`, so
//     `host` has a registered extractor.

import std.agent

public func main() returns int {
    let start = agent_start("{\"goal\":\"r3215-vocabulary\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[\"spectra.std.fs\",\"spectra.std.fs.fs_read\",\"spectra.api.client.request:host=api.example.com\"],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":7,\"journal\":\"\"}")
    if let Result::Err(start_error) = start {
        return 1
    }
    return 0
}
