module stdlib_serve_full

import std.serve as serve
import std.string as string
import std.fs as fs
import std.tensor as tensor

public func main() returns int {
    serve.reset()

    let server = serve.server_new(3)
    let model_weight = tensor.reshape(tensor.full_f(1, 3.0), 1, 1)
    let model_bias = tensor.full_f(1, 0.0)
    if serve.server_register_model_linear(server, model_weight, model_bias, 0) != 1 {
        return 1
    }
    if serve.server_resident_model(server) != 3 or serve.server_is_warm(server) != false {
        return 1
    }
    if serve.server_set_model_version(server, "stdlib-v2") != true {
        return 2
    }
    if serve.server_set_fallback(server, -7) != true {
        return 3
    }
    if serve.server_set_input_policy(server, 0, 10) != true {
        return 4
    }
    if serve.server_set_output_policy(server, 0, 20) != true {
        return 5
    }
    if serve.server_set_rate_limit(server, 2) != true or serve.server_set_timeout(server, 1) != true {
        return 6
    }
    if serve.server_warmup(server) != true or serve.server_is_warm(server) != true {
        return 7
    }

    let allowed = serve.server_enqueue(server, 4)
    let blocked_input = serve.server_enqueue(server, 11)
    let second_allowed = serve.server_enqueue(server, 6)
    let blocked_rate = serve.server_enqueue(server, 5)
    if serve.server_result(server, blocked_input) != -7 or serve.server_result(server, blocked_rate) != -7 {
        return 8
    }
    if serve.server_pending(server) != 2 {
        return 9
    }
    if serve.server_process_batch(server, 2) != 2 {
        return 10
    }
    if serve.server_result(server, allowed) != 12 or serve.server_result(server, second_allowed) != 18 {
        return 11
    }
    if serve.server_pending(server) != 0 {
        return 12
    }

    let rate_diagnostic = serve.server_last_diagnostic(server)
    if string.contains(rate_diagnostic, "rate_limit") != true {
        return 13
    }
    if string.contains(serve.server_audit_log(server), "spectra.serve.audit.v1") != true {
        return 14
    }

    if serve.server_benchmark(server, 4, 2) != 4 {
        return 15
    }
    let snapshot = serve.server_monitoring_snapshot(server)
    let distribution = serve.server_distribution_summary(server)
    if string.contains(snapshot, "stdlib-v2") != true or string.contains(distribution, "distribution_summary.v1") != true {
        return 16
    }
    let drift = serve.drift_check(distribution, distribution, 0)
    if string.contains(drift, "\"drifted\":false") != true {
        return 17
    }
    let audit = serve.server_audit_log(server)
    let exported = serve.export_monitoring(
        server,
        "target/stdlib-serve-monitoring.json",
        distribution,
        drift,
        audit
    )
    if string.contains(exported, "stdlib-serve-monitoring.json") != true {
        return 18
    }
    let exported_exists = fs.fs_exists(exported)
    if let Result::Ok(exists) = exported_exists {
        if exists != true {
            return 19
        }
    } else {
        return 19
    }

    if serve.server_set_timeout(server, 0) != true {
        return 20
    }
    if serve.server_set_rate_limit(server, 100) != true {
        return 21
    }
    let timed_out = serve.server_enqueue(server, 1)
    if serve.server_pending(server) != 1 {
        return 22
    }
    if serve.server_process_batch(server, 1) != 0 or serve.server_result(server, timed_out) != -1 {
        return 23
    }
    serve.reset()
    return 0
}
