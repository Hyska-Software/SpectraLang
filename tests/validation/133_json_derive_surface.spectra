module json_derive_surface

#[derive(Serialize, Deserialize)]
record Profile {
    #[json(rename = "user_id")]
    id: int,
    name: string,
    #[json(optional)]
    nickname: string,
}

#[derive(Serialize, Deserialize)]
enum Role {
    #[json(rename = "admin_user")]
    Admin,
    Guest,
}

public func main() returns int {
    let profile = Profile {
        id: 7,
        name: "Ada",
        nickname: "ace",
    }
    let encoded: string  = profile.to_json()
    if encoded != "{\"user_id\":7,\"name\":\"Ada\",\"nickname\":\"ace\"}" {
        return 1
    }
    let decoded: Profile = Profile::from_json("{\"user_id\":7,\"name\":\"Ada\"}")
    if decoded.id != 7 {
        return 2
    }
    if decoded.name != "Ada" {
        return 3
    }
    if decoded.nickname != "" {
        return 4
    }
    let field: string    = Profile::json_error_field("{\"user_id\":7,\"name\":\"Ada\"}")
    if field != "" {
        return 5
    }
    return 0
}
