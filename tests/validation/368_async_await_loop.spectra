module async_await_loop

// Regression: a scalar promoted local must live in the coroutine frame so its
// value survives a suspension. Before the fix the local was lowered behind an
// alloca whose address was stored in the frame; that address died with the poll
// activation (stack slot, or manual allocation released by the per-poll frame
// exit), so every post-await read observed garbage and the loop never
// converged. Loop-carried locals must be frame-resident, not address-resident.

from std.api.db.sqlite import SqliteConnection, open as sqlite_open, close as sqlite_close, execute_async as sqlite_execute_async

async func delayed_tick(value: int) returns int {
    // Await a real background database task that materializes an 8 MiB row.
    // This keeps the child pending while the parent coroutine suspends.
    let connection: SqliteConnection = sqlite_open(":memory:")
    let affected: int = await sqlite_execute_async(connection, "SELECT randomblob(8388608)")
    sqlite_close(connection)
    if affected != 0 {
        return-1
    }
    return value
}

async func loop_with_await() returns int {
    let n     = 0
    let total = 0
    let guard = 0
    while n < 3 {
        let reply = await delayed_tick(n)
        if reply == n {
            total = total + 1
        }
        n = n + 1
        guard = guard + 1
        if guard > 5 {
            return 7
        }
    }
    if n != 3 {
        return 8
    }
    if total != 3 {
        return 9
    }
    return 0
}

public func main() returns int {
    return block_on(loop_with_await())
}
