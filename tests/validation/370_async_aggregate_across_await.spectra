module async_aggregate_across_await

// Regression: an aggregate local's address can be kept in a coroutine frame
// slot and dereferenced after a suspension. The storage must therefore be
// owned by the frame (frame-local), not by one poll activation, otherwise every
// post-await field/element read observes reclaimed memory. Covers record field
// mutation, nested field mutation, array element mutation, and an aggregate
// passed by address to a sync call after an await.

from std.api.db.sqlite import SqliteConnection, open as sqlite_open, close as sqlite_close, execute_async as sqlite_execute_async

async func delayed_tick(value: int) returns int {
    // Await a real background database task that materializes an 8 MiB row.
    // This keeps the child pending while the parent coroutine suspends.
    let connection: SqliteConnection = sqlite_open(":memory:")
    let affected: int = await sqlite_execute_async(connection, "SELECT randomblob(8388608)")
    sqlite_close(connection)
    if affected != 0 {
        return-1
    }
    return value
}

record Pair {
    a: int
    b: int
}

record Inner {
    v: int
}

record Outer {
    inner: Inner
    tag: int
}

func pair_sum(p: Pair) returns int {
    return p.a + p.b
}

async func record_field_across_await() returns int {
    let p = Pair { a: 0, b: 0 }
    let n = 0
    while n < 3 {
        let reply = await delayed_tick(n)
        if reply == n {
            p.a = p.a + 1
            p.b = p.b + 2
            n = n + 1
        }
    }
    if p.a != 3 {
        return 8
    }
    if p.b != 6 {
        return 9
    }
    return 0
}

async func array_field_across_await() returns int {
    let xs = [0, 0, 0]
    let n  = 0
    while n < 3 {
        let reply = await delayed_tick(n)
        if reply == n {
            xs[0] = xs[0] + 1
            xs[1] = xs[1] + 2
            n = n + 1
        }
    }
    if xs[0] != 3 {
        return 8
    }
    if xs[1] != 6 {
        return 9
    }
    return 0
}

async func nested_field_across_await() returns int {
    let o = Outer { inner: Inner { v: 0 }, tag: 7 }
    let n = 0
    while n < 3 {
        let reply = await delayed_tick(n)
        if reply == n {
            o.inner.v = o.inner.v + 1
            n = n + 1
        }
    }
    if o.inner.v != 3 {
        return 8
    }
    if o.tag != 7 {
        return 9
    }
    return 0
}

async func passed_by_address_across_await() returns int {
    let p   = Pair { a: 4, b: 5 }
    let xs  = [1, 2, 3]
    let n   = 0
    let sum = 0
    while n < 2 {
        let reply = await delayed_tick(n)
        if reply == n {
            sum = pair_sum(p) + xs[0] + xs[1] + xs[2]
            n = n + 1
        }
    }
    if sum != 15 {
        return 8
    }
    return 0
}

public func main() returns int {
    let a = block_on(record_field_across_await())
    if a != 0 {
        return 10 + a
    }

    let b = block_on(array_field_across_await())
    if b != 0 {
        return 20 + b
    }

    let c = block_on(nested_field_across_await())
    if c != 0 {
        return 30 + c
    }

    let d = block_on(passed_by_address_across_await())
    if d != 0 {
        return 40 + d
    }

    return 0
}
