module validation_463_stdlib_ml_dataset_module

// Contract: tensor-backed datasets split deterministically and feed typed batches.
import std.ml as ml
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    let features = tensor.reshape(tensor.arange(0, 6, 1), 3, 2)
    let labels = tensor.arange(7, 10, 1)
    let dataset = ml.dataset_from_tensors(features, labels, 3)
    let mapped = ml.dataset_map_features(dataset, 2.0, 1.0)
    let filtered = ml.dataset_filter_label_min(dataset, 8.0)
    if ml.dataset_len(mapped) != 3 or ml.dataset_len(filtered) != 2 {
        return 1
    }
    let train = ml.dataset_train_split(dataset, 2)
    let test = ml.dataset_test_split(dataset, 2)
    if ml.dataset_len(dataset) != 3 or ml.dataset_len(train) != 2 or ml.dataset_len(test) != 1 {
        return 2
    }
    let loader = ml.dataloader_new(train, 1, 463)
    if ml.dataloader_batch_count(loader) != 2 {
        return 3
    }
    let batch_features = ml.dataloader_batch_features(loader, 0)
    let batch_labels = ml.dataloader_batch_labels(loader, 0)
    if tensor.len(batch_features) != 2 or tensor.len(batch_labels) != 1 {
        return 4
    }

    let model = ml.module_new()
    let weight = tensor.requires_grad(tensor.full_f(1, 1.0), true)
    let bias = tensor.requires_grad(tensor.full_f(1, 0.0), true)
    ml.module_add_parameter(model, weight)
    ml.module_add_parameter(model, bias)
    if ml.module_parameter_count(model) != 2 {
        return 5
    }
    if ml.module_is_training(model) != true {
        return 6
    }
    ml.module_set_training(model, false)
    if ml.module_is_training(model) != false {
        return 7
    }
    tensor.free_all()
    return 0
}
