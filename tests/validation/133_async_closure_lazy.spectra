module async_closure_lazy

static side_effect_count: int = 0

func side_effect() returns int {
    side_effect_count = side_effect_count + 1
    return side_effect_count
}

func main() returns int {
    let callback = async || side_effect()
    // Construction must not execute the callback body.
    if side_effect_count != 0 {
        return 1
    }
    return 0
}
