module agent_compensation_failure

// Contract: rollback executes deferred entries newest-first, records a wrapper
// failure for malformed arguments, and continues to the remaining entry.

import std.agent
import std.error as error
import std.fs as fs
import std.string as str

const DIR = "target/r3293-compensation"
const RUN_ID = "fixture-416-compensation"
static RELEASES: int = 0

#[derive(Serialize, Deserialize)]
public record ReleaseArgs {
    label: string,
}

#[agent_tool("Counts a release")]
public async func release(run: Run, args: ReleaseArgs) returns string {
    RELEASES = RELEASES + 1
    return "release " + args.label
}

func path() returns string {
    return DIR + "/" + RUN_ID + ".jsonl"
}

func spec() returns string {
    return "{\"goal\":\"fixture-416-compensation-failure\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":416,\"journal\":\"" +
        DIR +
        "\",\"journal_payloads\":true,\"run_id\":\"" +
        RUN_ID +
        "\"}"
}

func clean() returns int {
    let exists = fs.fs_exists(path())
    if let Result::Ok(present) = exists {
        if present == true {
            let removed = fs.fs_remove(path())
            if let Result::Ok(ok) = removed {
                if ok == true {
                    return 0
                }
            }
            return 1
        }
        return 0
    }
    return 1
}

async func verify() returns int {
    if clean() != 0 {
        return 1
    }
    let started = agent_start(spec())
    if let Result::Ok(run) = started {
        let malformed = compensate(run, "release", "{\"label\":7}")
        let valid     = compensate(run, "release", "{\"label\":\"undo\"}")
        if let Result::Err(problem) = malformed {
            return 2
        }
        if let Result::Err(problem) = valid {
            return 3
        }
        let rolled = rollback(run, "fixture compensation failure")
        if let Result::Ok(count) = rolled {
            if count != 2 {
                return 4
            }
        } else {
            return 5
        }
        if RELEASES != 1 {
            return 6
        }
        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            if str.contains(report, "\"status\":\"rolled_back\"") == false {
                return 7
            }
        } else {
            return 8
        }
    } else {
        return 9
    }
    let journal = fs.fs_read(path())
    if let Result::Ok(document) = journal {
        if str.contains(document, "release undo") == false {
            return 10
        }
        if str.contains(document, "tool_failed") == false {
            return 11
        }
    } else {
        return 12
    }
    return 0
}

public func main() returns int {
    return block_on(verify())
}
