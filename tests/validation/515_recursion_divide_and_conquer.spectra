module validation_515_recursion_divide_and_conquer

// Divide-and-conquer recursion: split the range in half (or shrink it
// logarithmically), solve both halves, and combine. Covers merge sort,
// recursive binary search, recursive maximum, and fast exponentiation.

func copy_range(source: [int], target: [int], lo: int, hi: int) {
    let index = lo
    while index <= hi {
        target[index] = source[index]
        index = index + 1
    }
}

func merge_ranges(arr: [int], temp: [int], lo: int, mid: int, hi: int) {
    let i = lo
    let j = mid + 1
    let k = lo
    while i <= mid and j <= hi {
        if arr[i] <= arr[j] {
            temp[k] = arr[i]
            i = i + 1
        } else {
            temp[k] = arr[j]
            j = j + 1
        }
        k = k + 1
    }
    while i <= mid {
        temp[k] = arr[i]
        i = i + 1
        k = k + 1
    }
    while j <= hi {
        temp[k] = arr[j]
        j = j + 1
        k = k + 1
    }
    copy_range(temp, arr, lo, hi)
}

func merge_sort(arr: [int], temp: [int], lo: int, hi: int) {
    if lo >= hi {
        return
    }
    let mid = (lo + hi) / 2
    merge_sort(arr, temp, lo, mid)
    merge_sort(arr, temp, mid + 1, hi)
    merge_ranges(arr, temp, lo, mid, hi)
}

func binary_search(arr: [int], lo: int, hi: int, target: int) returns int {
    if lo > hi {
        return -1
    }
    let mid = (lo + hi) / 2
    if arr[mid] == target {
        return mid
    }
    if arr[mid] < target {
        return binary_search(arr, mid + 1, hi, target)
    }
    return binary_search(arr, lo, mid - 1, target)
}

func max_rec(arr: [int], index: int) returns int {
    if index == 0 {
        return arr[0]
    }
    let rest = max_rec(arr, index - 1)
    if arr[index] > rest {
        return arr[index]
    }
    return rest
}

func min_rec(arr: [int], index: int) returns int {
    if index == 0 {
        return arr[0]
    }
    let rest = min_rec(arr, index - 1)
    if arr[index] < rest {
        return arr[index]
    }
    return rest
}

func fast_power(base: int, exponent: int) returns int {
    if exponent == 0 {
        return 1
    }
    let half = fast_power(base, exponent / 2)
    if exponent % 2 == 0 {
        return half * half
    }
    return half * half * base
}

public func main() returns int {
    let values = [9, 3, 7, 1, 8, 2, 6, 4]
    let scratch = [0, 0, 0, 0, 0, 0, 0, 0]
    merge_sort(values, scratch, 0, 7)
    if values[0] != 1 or values[1] != 2 or values[2] != 3 or values[3] != 4 {
        return 1
    }
    if values[4] != 6 or values[5] != 7 or values[6] != 8 or values[7] != 9 {
        return 2
    }
    if binary_search(values, 0, 7, 7) != 5 {
        return 3
    }
    if binary_search(values, 0, 7, 1) != 0 {
        return 4
    }
    if binary_search(values, 0, 7, 5) != -1 {
        return 5
    }

    let duplicates = [5, 1, 5, 3, 5, 1, 1, 2]
    let scratch2 = [0, 0, 0, 0, 0, 0, 0, 0]
    merge_sort(duplicates, scratch2, 0, 7)
    if duplicates[0] != 1 or duplicates[1] != 1 or duplicates[2] != 1 {
        return 6
    }
    if duplicates[7] != 5 or duplicates[6] != 5 or duplicates[5] != 5 {
        return 7
    }

    let mixed = [4, -9, 12, 0, 7, -3, 15, 2]
    if max_rec(mixed, 7) != 15 {
        return 8
    }
    if min_rec(mixed, 7) != -9 {
        return 9
    }
    if fast_power(3, 10) != 59049 {
        return 10
    }
    if fast_power(2, 0) != 1 {
        return 11
    }
    if fast_power(5, 7) != 78125 {
        return 12
    }
    return 0
}
