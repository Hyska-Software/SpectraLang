module agent_nested_payloads

// Contract: generated tool schemas and wrappers preserve nested records,
// arrays, floats, booleans, and UTF-8 strings; a nested type mismatch is typed.

import std.agent
import std.error as error
import std.string as str

#[derive(Serialize, Deserialize)]
public record Details {
    title: string,
    active: bool,
}

#[derive(Serialize, Deserialize)]
public record Envelope {
    sequence: int,
    ratio: float,
    details: Details,
    labels: List<string>,
}

#[agent_tool("Echoes an envelope")]
public async func echo(run: Run, args: Envelope) returns Envelope {
    return args
}

func spec() returns string {
    return "{\"goal\":\"fixture-409-nested-payloads\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":409,\"journal\":\"\"}"
}

async func verify() returns int {
    let schema = Envelope::json_schema()
    if str.contains(schema, "\"details\":{\"type\":\"object\"") == false {
        return 1
    }
    if str.contains(schema, "\"labels\":{\"type\":\"array\"") == false {
        return 2
    }
    let started = agent_start(spec())
    if let Result::Ok(run) = started {
        let valid = await tool_call(
            run,
            "echo",
            "{\"sequence\":9,\"ratio\":0.25,\"details\":{\"title\":\"café\",\"active\":true},\"labels\":[\"a\",\"b\"]}",
        )
        if let Result::Ok(document) = valid {
            if str.contains(document, "\"sequence\":9") == false {
                return 3
            }
            if str.contains(document, "\"ratio\":0.25") == false {
                return 4
            }
            if str.contains(document, "\"title\":\"café\"") == false {
                return 5
            }
            if str.contains(document, "\"labels\":[\"a\",\"b\"]") == false {
                return 6
            }
        } else {
            return 7
        }
        let invalid = await tool_call(
            run,
            "echo",
            "{\"sequence\":9,\"ratio\":\"bad\",\"details\":{\"title\":\"x\",\"active\":true},\"labels\":[]}",
        )
        if let Result::Err(problem) = invalid {
            if str.contains(error.message(problem), "ratio") == false {
                return 8
            }
        } else {
            return 9
        }
        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            if str.contains(report, "\"tool_calls\":2") == false {
                return 10
            }
        } else {
            return 11
        }
        return 0
    }
    return 12
}

public func main() returns int {
    return block_on(verify())
}
