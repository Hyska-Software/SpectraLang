module core_for_range_control_shadowing

func range_total() returns int {
    let index = 50
    index = index + 1
    let total = 0
    let visits = 0

    for index in 0 ..= 6 {
        if index == 2 {
            continue
        }
        if index == 5 {
            break
        }
        total = total + index
        visits = visits + 1
        index = index + 100
    }

    if index != 51 {
        return -1
    }
    return total * 10 + visits
}

public func main() returns int {
    if range_total() != 84 {
        return 1
    }
    return 0
}
