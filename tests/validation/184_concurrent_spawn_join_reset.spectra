// R-3132: fused tasks remain observable through accounting and reset.
module concurrent_spawn_join_reset

import std.concurrent as concurrent

public func main() returns int {
    concurrent.reset()
    let value = concurrent.task_join(concurrent.task_spawn_fn( | value: int | { value}, 7))
    if value != 7 or concurrent.stats_tasks_spawned() != 1 {
        return 1
    }
    concurrent.reset()
    if concurrent.stats_tasks_spawned() != 0 {
        return 2
    }
    return 0
}
