module stdlib_concurrent_full

import std.concurrent as concurrent

public func main() returns int {
    concurrent.reset()

    let task             = concurrent.task_spawn_fn( | value: int | { value}, 42)
    let done_before_join = concurrent.task_is_done(task)
    if done_before_join != true and done_before_join != false {
        return 1
    }
    if concurrent.task_join(task) != 42 {
        return 1
    }

    let batch = concurrent.task_spawn_batch(10, 5)
    if concurrent.task_join_batch_sum(batch) != 60 {
        return 2
    }
    if concurrent.stats_tasks_spawned() != 6 {
        return 3
    }

    let channel = concurrent.channel_new()
    if concurrent.channel_send(channel, 7) != true {
        return 4
    }
    if concurrent.channel_len(channel) != 1 or concurrent.channel_recv(channel) != 7 {
        return 5
    }
    concurrent.channel_close(channel)
    if concurrent.channel_send(channel, 9) != false {
        return 6
    }

    let counter = concurrent.counter_new(-2)
    if concurrent.counter_add(counter, 9) != 7 or concurrent.counter_get(counter) != 7 {
        return 7
    }
    if concurrent.pipeline_sum(10, 5, 2) != 60 or concurrent.pipeline_sum(10, 0, 2) != 0 {
        return 8
    }
    if concurrent.stats_channels() != 1 {
        return 9
    }
    concurrent.reset()
    if concurrent.stats_tasks_spawned() != 0 or concurrent.stats_channels() != 0 {
        return 10
    }
    return 0
}
