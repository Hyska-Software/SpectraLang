module core_unicode_char_patterns

func classify(value: char) returns int {
    return match value {
        when '\r' then 1,
        when '\0' then 2,
        when '\'' then 3,
        when 'λ' then 4,
        when '😀' then 5,
        otherwise then 0
    }
}

public func main() returns int {
    if classify('\r') != 1 {
        return 1
    }
    if classify('\0') != 2 {
        return 2
    }
    if classify('\'') != 3 {
        return 3
    }
    if classify('λ') != 4 {
        return 4
    }
    if classify('😀') != 5 {
        return 5
    }
    return 0
}
