module validation_453_stdlib_convert_config

// Contract: conversion helpers distinguish valid input from fallback paths
// and preserve the documented textual forms for primitive values.
import std.convert as convert
import std.math as math
import std.string as string

public func main() returns int {
    if convert.string_to_int_or("42", -1) != 42 or convert.string_to_int_or("not-an-int", -1) != -1 {
        return 1
    }
    if convert.string_to_float_or("2.5", -1.0) != 2.5 or convert.string_to_float_or("not-a-float", -1.0) != -1.0 {
        return 2
    }
    if math.is_nan_f(convert.string_to_float("NaN")) != true {
        return 3
    }
    if convert.string_to_bool("TRUE") != true or convert.string_to_bool("no") != false {
        return 4
    }
    if convert.bool_to_string(true) != "true" or convert.bool_to_string(false) != "false" {
        return 5
    }
    let integer_text = convert.int_to_string(-17)
    if string.eq(integer_text, "-17") != true or convert.string_to_int(integer_text) != -17 {
        return 6
    }
    if convert.int_to_float(9) != 9.0 or convert.float_to_int(-4.75) != -4 {
        return 7
    }
    let float_text = convert.float_to_string(0.125)
    if convert.string_to_float(float_text) != 0.125 {
        return 8
    }
    return 0
}
