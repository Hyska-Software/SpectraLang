module validation_stdlib_ml_vector_index

import std.ml as ml
import std.string as string
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    let index = ml.vector_index_new(2)
    ml.vector_index_insert(index, "validation", tensor.vector_f(2, 1.0))
    let query = ml.vector_index_query(index, tensor.vector_f(2, 1.0), 1)
    if !string.contains(query, "validation") {
        return 1
    }
    tensor.free_all()
    return 0
}
