module stdlib_serve_lifecycle_validation

import std.serve as serve
import std.string as string
import std.tensor as tensor
from std.serve import server_register_model_linear

public func main() returns int {
    serve.reset()
    let server = serve.server_new(42)
    let first_weights = tensor.full2_f(2, 1, 1.0)
    let first_biases = tensor.full_f(2, 0.0)
    let second_weights = tensor.full2_f(1, 2, 0.5)
    let second_biases = tensor.full_f(1, 1.0)
    if server_register_model_linear(
        server,
        first_weights,
        first_biases,
        0,
        second_weights,
        second_biases,
        0
    ) != 1 {
        return 1
    }
    if serve.server_resident_model(server) != 42 or serve.server_is_warm(server) != false {
        return 2
    }
    if serve.server_set_model_version(server, "stdlib-linear-v2") != true {
        return 3
    }
    if serve.server_set_fallback(server, -99) != true or serve.server_set_input_policy(server, 0, 10) != true {
        return 4
    }
    if serve.server_set_output_policy(server, 0, 100) != true or serve.server_warmup(server) != true {
        return 5
    }

    let accepted = serve.server_enqueue(server, 3)
    let blocked = serve.server_enqueue(server, 11)
    if serve.server_pending(server) != 1 or serve.server_result(server, blocked) != -99 {
        return 6
    }
    if serve.server_process_batch(server, 1) != 1 or serve.server_result(server, accepted) != 4 {
        return 7
    }
    let diagnostic = serve.server_last_diagnostic(server)
    if string.contains(diagnostic, "input") != true or string.contains(diagnostic, "range") != true {
        return 8
    }

    let cancelled = serve.server_enqueue(server, 5)
    if serve.server_cancel(server, cancelled) != true or serve.server_pending(server) != 0 {
        return 9
    }
    if serve.server_result(server, cancelled) != -1 or serve.server_cancel(server, cancelled) != false {
        return 10
    }
    let snapshot = serve.server_monitoring_snapshot(server)
    if string.contains(snapshot, "stdlib-linear-v2") != true or string.contains(snapshot, "\"completed\"") != true {
        return 11
    }
    let distribution = serve.server_distribution_summary(server)
    let drift = serve.drift_check(distribution, distribution, 0)
    if string.contains(drift, "\"drifted\":false") != true {
        return 12
    }
    serve.reset()
    return 0
}
