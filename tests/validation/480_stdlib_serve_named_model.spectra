module validation_stdlib_serve_named_model

import std.serve as serve
import std.tensor as tensor

public func main() returns int {
    serve.reset()
    let server = serve.server_new(480)
    let weights = tensor.full2_f(1, 1, 2.0)
    let bias = tensor.full_f(1, 0.0)
    if serve.server_register_named_model_linear(server, "validation", weights, bias, 0) != 1 {
        return 1
    }
    let request = serve.server_infer(server, "validation", tensor.full_f(1, 3.0))
    if serve.server_result(server, request) != 6 {
        return 2
    }
    tensor.free_all()
    serve.reset()
    return 0
}
