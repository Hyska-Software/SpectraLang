module runtime_host_status_hardening

import std.collections as collections
import std.error as error
import std.fs as fs
import std.option as option

public func main() returns int {
    let invalid_read = fs.fs_read("")
    if let Result::Err(read_error) = invalid_read {
        if error.code(read_error) != 0 {
            return 1
        }
    } else {
        return 1
    }
    let invalid_exists = fs.fs_exists("")
    if let Result::Err(exists_error) = invalid_exists {
        if error.code(exists_error) != 0 {
            return 2
        }
    } else {
        return 2
    }

    let values = collections.list_new()
    if option.is_some(collections.list_get(values, -1)) {
        return 3
    }
    if option.is_some(collections.list_get(values, 0)) {
        return 4
    }
    if option.is_some(collections.list_pop(values)) {
        return 5
    }
    if option.is_some(collections.list_remove_at(values, 0)) {
        return 6
    }
    collections.list_free(values)

    return 0
}
