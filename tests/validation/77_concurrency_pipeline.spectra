// Teste 77: Phase 11 std.concurrent tasks, channels, counters e pipeline paralelo
module concurrency_pipeline

import std.concurrent as concurrent

public func main() returns int {
    concurrent.reset()

    let task = concurrent.task_spawn_fn( | value: int | { value}, 42)
    if concurrent.task_join(task) != 42 {
        return 1
    }
    if concurrent.stats_tasks_spawned() != 1 {
        return 3
    }

    let channel = concurrent.channel_new()
    concurrent.channel_send(channel, 7)
    concurrent.channel_send(channel, 9)
    if concurrent.channel_len(channel) != 2 {
        return 6
    }
    if concurrent.channel_recv(channel) != 7 {
        return 7
    }
    if concurrent.channel_recv(channel) != 9 {
        return 8
    }
    if concurrent.channel_recv(channel) != -1 {
        return 9
    }
    concurrent.channel_close(channel)
    concurrent.channel_send(channel, 11)
    if concurrent.channel_len(channel) != 0 {
        return 10
    }

    let counter = concurrent.counter_new(5)
    if concurrent.counter_add(counter, 4) != 9 {
        return 11
    }
    if concurrent.counter_get(counter) != 9 {
        return 12
    }

    if concurrent.pipeline_sum(1, 100, 4) != 5050 {
        return 13
    }
    if concurrent.stats_channels() != 1 {
        return 14
    }

    return 0
}
