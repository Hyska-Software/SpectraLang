module core_dynamic_nested_array_lvalue

public func main() returns int {
    let grid   = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    let row    = 1
    let column = 2
    grid[row] [column] = 42

    if grid[1] [2] != 42 {
        return 1
    }
    if grid[1] [1] != 5 or grid[0] [2] != 3 {
        return 2
    }
    return 0
}
