module validation_764_std_round7_collections_snapshot_owner_release

from std.collections import Iterator, OrderedMap, Vector
import std.collections as collections
import std.option as option

public func main() returns int {
    let values: Vector<string> = collections.vector_new()
    collections.vector_push(values, "first")
    collections.vector_push(values, "second")
    let vector_snapshot: Iterator<string> = collections.vector_iter(values)
    collections.vector_free(values)

    if collections.iterator_remaining(vector_snapshot) != 2 {
        return 1
    }
    let first  = collections.iterator_next(vector_snapshot)
    let second = collections.iterator_next(vector_snapshot)
    if option.is_none(first) or option.option_unwrap(first) != "first" {
        return 2
    }
    if option.is_none(second) or option.option_unwrap(second) != "second" {
        return 3
    }
    if option.is_some(collections.iterator_next(vector_snapshot)) {
        return 4
    }
    collections.iterator_free(vector_snapshot)

    let table: OrderedMap<string, int> = collections.ordered_map_new()
    collections.ordered_map_set(table, "bravo", 2)
    collections.ordered_map_set(table, "alpha", 1)
    let map_snapshot: Iterator<string> = collections.ordered_map_iter(table)
    collections.ordered_map_free(table)

    if collections.iterator_remaining(map_snapshot) != 2 {
        return 5
    }
    let first_key  = collections.iterator_next(map_snapshot)
    let second_key = collections.iterator_next(map_snapshot)
    if option.is_none(first_key) or option.option_unwrap(first_key) != "alpha" {
        return 6
    }
    if option.is_none(second_key) or option.option_unwrap(second_key) != "bravo" {
        return 7
    }
    if option.is_some(collections.iterator_next(map_snapshot)) {
        return 8
    }
    collections.iterator_free(map_snapshot)
    return 0
}
