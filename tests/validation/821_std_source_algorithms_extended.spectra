// Consumer for the extended `std.algorithms` surface: string binary search,
// KMP search, longest common subsequence, Damerau–Levenshtein distance,
// modular exponentiation, integer square root and the Chinese remainder
// theorem.
module std_source_algorithms_extended

from std.collections import List
import std.algorithms as algorithms
import std.collections as collections
import std.option as option
import std.string as str

func int_list(values: [int], count: int) returns List<int> {
    let list: List<int> = collections.list_new()
    let index = 0
    while index < count {
        collections.list_push(list, values[index])
        index = index + 1
    }
    return list
}

public func main() returns int {
    // ── binary_search_string ─────────────────────────────────────────────
    let sorted: List<string> = collections.list_new()
    collections.list_push(sorted, "alpha")
    collections.list_push(sorted, "beta")
    collections.list_push(sorted, "beta")
    collections.list_push(sorted, "gamma")
    if algorithms.binary_search_string(sorted, "alpha") != 0 {
        return 1
    }
    if algorithms.binary_search_string(sorted, "gamma") != 3 {
        return 2
    }
    let beta = algorithms.binary_search_string(sorted, "beta")
    if beta != 1 and beta != 2 {
        return 3
    }
    if algorithms.binary_search_string(sorted, "delta") != -1 {
        return 4
    }

    // ── kmp_find ─────────────────────────────────────────────────────────
    if algorithms.kmp_find("abababc", "abc") != 4 {
        return 5
    }
    if algorithms.kmp_find("abc", "") != 0 {
        return 6
    }
    if algorithms.kmp_find("", "a") != -1 {
        return 7
    }
    if algorithms.kmp_find("aaa", "aa") != 0 {
        return 8
    }

    // ── lcs ──────────────────────────────────────────────────────────────
    if str.len(algorithms.lcs("ABCBDAB", "BDCABA")) != 4 {
        return 9
    }
    if algorithms.lcs("abc", "abc") != "abc" {
        return 10
    }
    if algorithms.lcs("abc", "") != "" {
        return 11
    }

    // ── damerau_levenshtein ──────────────────────────────────────────────
    if algorithms.damerau_levenshtein("ab", "ba") != 1 {
        return 12
    }
    if algorithms.damerau_levenshtein("CA", "ABC") != 2 {
        return 13
    }
    if algorithms.damerau_levenshtein("café", "cafe") != 1 {
        return 14
    }

    // ── mod_pow ──────────────────────────────────────────────────────────
    if option.option_unwrap_or(algorithms.mod_pow(2, 10, 1000), -1) != 24 {
        return 15
    }
    if option.option_unwrap_or(algorithms.mod_pow(3, 0, 7), -1) != 1 {
        return 16
    }
    if option.option_unwrap_or(algorithms.mod_pow(2, 3, 1), -1) != 0 {
        return 17
    }
    if option.is_some(algorithms.mod_pow(2, -1, 7)) {
        return 18
    }
    if option.is_some(algorithms.mod_pow(2, 3, 0)) {
        return 19
    }

    // ── integer_sqrt ─────────────────────────────────────────────────────
    if option.option_unwrap_or(algorithms.integer_sqrt(0), -1) != 0 {
        return 20
    }
    if option.option_unwrap_or(algorithms.integer_sqrt(1), -1) != 1 {
        return 21
    }
    if option.option_unwrap_or(algorithms.integer_sqrt(15), -1) != 3 {
        return 22
    }
    if option.option_unwrap_or(algorithms.integer_sqrt(16), -1) != 4 {
        return 23
    }
    if option.is_some(algorithms.integer_sqrt(-1)) {
        return 24
    }
    if option.option_unwrap_or(algorithms.integer_sqrt(1000000000000), -1) != 1000000 {
        return 25
    }

    // ── chinese_remainder ────────────────────────────────────────────────
    let r1 = int_list([2, 3], 2)
    let m1 = int_list([3, 5], 2)
    if option.option_unwrap_or(algorithms.chinese_remainder(r1, m1), -1) != 8 {
        return 26
    }
    let r2 = int_list([1, 2], 2)
    let m2 = int_list([2, 4], 2)
    if option.is_some(algorithms.chinese_remainder(r2, m2)) {
        return 27
    }
    let r3 = int_list([1], 1)
    let m3 = int_list([0], 1)
    if option.is_some(algorithms.chinese_remainder(r3, m3)) {
        return 28
    }
    let r4 = int_list([1, 2], 2)
    let m4 = int_list([2], 1)
    if option.is_some(algorithms.chinese_remainder(r4, m4)) {
        return 29
    }
    let empty: List<int> = collections.list_new()
    if option.is_some(algorithms.chinese_remainder(empty, empty)) {
        return 30
    }

    return 0
}
