module validation_514_recursion_mutual

// Mutual recursion: two or more functions that only terminate together.
// Covers parity, alternating array walkers, and the Hofstadter
// female/male pair (each function calls the other's recursion).

func is_even(n: int) returns bool {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)
}

func is_odd(n: int) returns bool {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

func sum_even_positions(arr: [int], index: int, n: int) returns int {
    if index >= n {
        return 0
    }
    return arr[index] + sum_odd_positions(arr, index + 1, n)
}

func sum_odd_positions(arr: [int], index: int, n: int) returns int {
    if index >= n {
        return 0
    }
    return sum_even_positions(arr, index + 1, n)
}

func hof_female(n: int) returns int {
    if n == 0 {
        return 1
    }
    return n - hof_male(hof_female(n - 1))
}

func hof_male(n: int) returns int {
    if n == 0 {
        return 0
    }
    return n - hof_female(hof_male(n - 1))
}

public func main() returns int {
    if not is_even(0) or is_odd(0) {
        return 1
    }
    if not is_even(2000) or is_even(1999) {
        return 2
    }
    if not is_odd(1999) or is_odd(2000) {
        return 3
    }

    let values = [1, 2, 3, 4, 5, 6]
    if sum_even_positions(values, 0, 6) != 9 {
        return 4
    }
    if sum_odd_positions(values, 0, 6) != 12 {
        return 5
    }

    if hof_female(12) != 8 {
        return 6
    }
    if hof_male(12) != 7 {
        return 7
    }
    if hof_female(0) != 1 or hof_male(0) != 0 {
        return 8
    }
    return 0
}
