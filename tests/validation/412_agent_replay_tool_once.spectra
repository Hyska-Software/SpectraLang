module agent_replay_tool_once

// Contract: a recorded tool result is returned during replay and the compiled
// tool body is entered exactly once.

from std.io import println
import std.agent
import std.error as error
import std.fs as fs
import std.string as str

const DIR = "target/r3292-replay-tool"
const RUN_ID = "fixture-412-replay"
static HITS: int = 0

#[derive(Serialize, Deserialize)]
public record MultiplyArgs {
    value: int,
}

#[agent_tool("Doubles a value and records one hit")]
public async func double(run: Run, args: MultiplyArgs) returns int {
    HITS = HITS + 1
    return args.value * 2
}

func path() returns string {
    return DIR + "/" + RUN_ID + ".jsonl"
}

func spec() returns string {
    return "{\"goal\":\"fixture-412-replay-tool-once\",\"model\":\"mock/echo\",\"endpoint\":\"mock:\",\"allow\":[],\"max_tokens\":0,\"max_cost_micros\":0,\"max_seconds\":0,\"max_tool_calls\":0,\"untrusted\":\"approve\",\"seed\":412,\"journal\":\"" +
        DIR +
        "\",\"journal_payloads\":true,\"run_id\":\"" +
        RUN_ID +
        "\"}"
}

func clean() returns int {
    let exists = fs.fs_exists(path())
    if let Result::Ok(present) = exists {
        if present == true {
            let removed = fs.fs_remove(path())
            if let Result::Ok(ok) = removed {
                if ok == true {
                    return 0
                }
            }
            return 1
        }
        return 0
    }
    return 1
}

async func verify() returns int {
    if clean() != 0 {
        return 1
    }
    let first = agent_start(spec())
    if let Result::Ok(run) = first {
        let value = await tool_call(run, "double", "{\"value\":21}")
        if let Result::Ok(result) = value {
            if result != "42" {
                return 2
            }
        } else {
            return 3
        }
        if let Result::Err(problem) = agent_end(run) {
            println(error.message(problem))
            return 4
        }
    } else {
        return 5
    }
    if HITS != 1 {
        return 6
    }
    let replay = agent_start(spec())
    if let Result::Ok(run) = replay {
        let value = await tool_call(run, "double", "{\"value\":21}")
        if let Result::Ok(result) = value {
            if result != "42" {
                return 7
            }
        } else {
            return 8
        }
        let ended = agent_end(run)
        if let Result::Ok(report) = ended {
            if str.contains(report, "\"replay\":true") == false {
                return 9
            }
        } else {
            return 10
        }
    } else {
        return 11
    }
    if HITS != 1 {
        return 12
    }
    return 0
}

public func main() returns int {
    return block_on(verify())
}
