module core_switch_char_codepoints

func classify(value: char) returns int {
    switch value {
        case '\0': { return 1 }
        case 'λ': { return 2 }
        case '😀': { return 3 }
        else: { return 0 }
    }
}

func classify_narrow(value: i8) returns int {
    switch value {
        case -7: { return 7 }
        case 120: { return 120 }
        else: { return 0 }
    }
}

public func main() returns int {
    if classify('\0') != 1 { return 1 }
    if classify('λ') != 2 { return 2 }
    if classify('😀') != 3 { return 3 }
    if classify('A') != 0 { return 4 }
    let negative: i8 = -7
    let positive: i8 = 120
    if classify_narrow(negative) != 7 { return 5 }
    if classify_narrow(positive) != 120 { return 6 }
    return 0
}
