module validation_stdlib_ml_tokenizer_training

import std.ml as ml
import std.string as string
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    let tokenizer = ml.train_wordpiece("hello hello world world", 24)
    if tokenizer == 0 or !string.contains(ml.tokenizer_vocab(tokenizer), "[UNK]:0") {
        return 1
    }
    let ids = ml.tokenizer_encode(tokenizer, "hello world")
    if tensor.len(ids) <= 0 or string.len(ml.tokenizer_decode(tokenizer, ids)) <= 0 {
        return 2
    }
    tensor.free_all()
    return 0
}
