module core_tuple_record_destructuring

record Point {
    public x: int,
    public y: int,
}

func combine(pair: (int, int), point: Point) returns int {
    let (left, right) = pair
    let Point { x, y: high } = point
    return left + right + x * 10 + high
}

public func main() returns int {
    let result = combine((3, 4), Point { x: 5, y: 6 })
    if result != 63 {
        return 1
    }
    return 0
}
