module validation_462_stdlib_ml_transformer_cache

// Contract: transformer helpers preserve tensor shapes and seeded sampling is repeatable.
import std.ml as ml
import std.tensor as tensor

public func main() returns int {
    tensor.free_all()
    tensor.set_grad_enabled(false)
    let table = tensor.reshape(tensor.full_f(12, 1.0), 4, 3)
    let ids = tensor.arange(0, 3, 1)
    let embedded = ml.embedding_lookup(table, ids)
    if tensor.rows(embedded) != 3 or tensor.cols(embedded) != 3 {
        return 1
    }
    let positions = ml.positional_encoding(3, 3)
    let normalized = ml.layer_norm(embedded, tensor.full_f(3, 1.0), tensor.full_f(3, 0.0), 0.00001)
    let gated = ml.swiglu(ml.gelu(normalized), positions)
    if tensor.rows(positions) != 3 or tensor.len(gated) != 9 {
        return 2
    }

    let query = tensor.reshape(tensor.full_f(6, 1.0), 2, 3)
    let key = tensor.reshape(tensor.full_f(6, 1.0), 2, 3)
    let value = tensor.reshape(tensor.full_f(4, 2.0), 2, 2)
    let attended = ml.attention(query, key, value)
    if tensor.rows(attended) != 2 or tensor.cols(attended) != 2 {
        return 3
    }
    let cache = ml.kv_cache_new(4, 3)
    if ml.kv_cache_append(cache, query, key) != 2 or ml.kv_cache_len(cache) != 2 {
        return 4
    }
    if tensor.rows(ml.kv_cache_keys(cache)) != 2 or tensor.rows(ml.kv_cache_values(cache)) != 2 {
        return 5
    }

    let logits = tensor.reshape(tensor.full_f(3, 1.0), 1, 3)
    let first = ml.logits_sample_seeded(42, logits, 1.0)
    let second = ml.logits_sample_seeded(42, logits, 1.0)
    if first != second or first < 0 or first > 2 {
        return 6
    }
    tensor.set_grad_enabled(true)
    tensor.free_all()
    return 0
}
