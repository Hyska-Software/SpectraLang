module validation_525_recursion_graph_traversal

// Recursive graph traversal over a sorted edge-list representation:
// `adj_start[node] .. adj_start[node + 1]` indexes `adj_list`. Covers
// preorder DFS with an explicit cursor, reachability counting, longest
// path (recursive depth), and white/gray/black cycle detection.

func dfs_preorder(
    node: int,
    adj_start: [int],
    adj_list: [int],
    visited: [int],
    order: [int],
    cursor: int
) returns int {
    visited[node] = 1
    order[cursor] = node
    cursor = cursor + 1
    let edge = adj_start[node]
    while edge < adj_start[node + 1] {
        let next = adj_list[edge]
        if visited[next] == 0 {
            cursor = dfs_preorder(next, adj_start, adj_list, visited, order, cursor)
        }
        edge = edge + 1
    }
    return cursor
}

func longest_path(node: int, adj_start: [int], adj_list: [int]) returns int {
    let best = 0
    let edge = adj_start[node]
    while edge < adj_start[node + 1] {
        let candidate = 1 + longest_path(adj_list[edge], adj_start, adj_list)
        if candidate > best {
            best = candidate
        }
        edge = edge + 1
    }
    return best
}

func has_cycle(node: int, adj_start: [int], adj_list: [int], color: [int]) returns bool {
    color[node] = 1
    let edge = adj_start[node]
    while edge < adj_start[node + 1] {
        let next = adj_list[edge]
        if color[next] == 1 {
            return true
        }
        if color[next] == 0 {
            if has_cycle(next, adj_start, adj_list, color) {
                return true
            }
        }
        edge = edge + 1
    }
    color[node] = 2
    return false
}

func path_weight(source: int, target: int, adj_start: [int], adj_list: [int]) returns int {
    if source == target {
        return 1
    }
    let edge = adj_start[source]
    while edge < adj_start[source + 1] {
        let found = path_weight(adj_list[edge], target, adj_start, adj_list)
        if found > 0 {
            return found + 1
        }
        edge = edge + 1
    }
    return 0
}

public func main() returns int {
    // DAG: 0 -> 1 -> 3 -> 4, 0 -> 2 -> 3
    let dag_start = [0, 2, 4, 5, 6, 6]
    let dag_edges = [1, 2, 3, 3, 3, 4]

    let visited = [0, 0, 0, 0, 0, 0]
    let order = [0, 0, 0, 0, 0, 0, 0, 0]
    let reached = dfs_preorder(0, dag_start, dag_edges, visited, order, 0)
    if reached != 5 {
        return 1
    }
    if order[0] != 0 or order[1] != 1 or order[2] != 3 or order[3] != 4 or order[4] != 2 {
        return 2
    }
    let checksum = order[0] * 1 + order[1] * 2 + order[2] * 3 + order[3] * 4 + order[4] * 5
    if checksum != 37 {
        return 3
    }

    let visited_two = [0, 0, 0, 0, 0, 0]
    let order_two = [0, 0, 0, 0, 0, 0, 0, 0]
    if dfs_preorder(3, dag_start, dag_edges, visited_two, order_two, 0) != 2 {
        return 4
    }
    if order_two[0] != 3 or order_two[1] != 4 {
        return 5
    }

    if longest_path(0, dag_start, dag_edges) != 3 {
        return 6
    }
    if longest_path(3, dag_start, dag_edges) != 1 {
        return 7
    }
    if longest_path(4, dag_start, dag_edges) != 0 {
        return 8
    }
    if longest_path(2, dag_start, dag_edges) != 2 {
        return 9
    }

    let dag_colors = [0, 0, 0, 0, 0, 0]
    if has_cycle(0, dag_start, dag_edges, dag_colors) {
        return 10
    }
    if dag_colors[4] != 2 {
        return 11
    }

    // Directed cycle: 0 -> 1 -> 2 -> 0
    let cycle_start = [0, 1, 2, 3]
    let cycle_edges = [1, 2, 0]
    let cycle_colors = [0, 0, 0]
    if not has_cycle(0, cycle_start, cycle_edges, cycle_colors) {
        return 12
    }

    // Self loop: 0 -> 0
    let loop_start = [0, 1, 1]
    let loop_edges = [0]
    let loop_colors = [0]
    if not has_cycle(0, loop_start, loop_edges, loop_colors) {
        return 13
    }

    if path_weight(0, 4, dag_start, dag_edges) != 4 {
        return 14
    }
    if path_weight(0, 2, dag_start, dag_edges) != 2 {
        return 15
    }
    if path_weight(4, 0, dag_start, dag_edges) != 0 {
        return 16
    }
    return 0
}
