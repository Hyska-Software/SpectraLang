module validation_627_stdlib_bitset

from std.collections import BitSet, Iterator
import std.collections as collections
import std.option as option

public func main() returns int {
    let left: BitSet  = collections.bitset_new()
    let right: BitSet = collections.bitset_new()
    collections.bitset_insert(left, 0)
    collections.bitset_insert(left, 63)
    collections.bitset_insert(left, 64)
    collections.bitset_insert(left, 127)
    collections.bitset_insert(left, 128)
    collections.bitset_insert(left, 4096)
    collections.bitset_insert(left, 65535)
    collections.bitset_insert(right, 63)
    collections.bitset_insert(right, 64)
    collections.bitset_insert(right, 128)
    collections.bitset_insert(right, 255)
    collections.bitset_insert(right, 65535)

    let united: BitSet = collections.bitset_new()
    collections.bitset_insert(united, 0)
    collections.bitset_insert(united, 63)
    collections.bitset_insert(united, 64)
    collections.bitset_insert(united, 127)
    collections.bitset_insert(united, 128)
    collections.bitset_insert(united, 4096)
    collections.bitset_insert(united, 65535)
    collections.bitset_union_with(united, right)
    if collections.bitset_count(united) != 8 {
        return 1
    }
    if collections.bitset_capacity(united) < 65536 {
        return 2
    }
    if collections.bitset_contains(united, 255) != true {
        return 3
    }

    let keys: Iterator<int> = collections.bitset_iter(united)
    if option.option_unwrap(collections.iterator_next(keys)) != 0 or
    option.option_unwrap(collections.iterator_next(keys)) != 63 or
    option.option_unwrap(collections.iterator_next(keys)) != 64 or
    option.option_unwrap(collections.iterator_next(keys)) != 127 or
    option.option_unwrap(collections.iterator_next(keys)) != 128 or
    option.option_unwrap(collections.iterator_next(keys)) != 255 or
    option.option_unwrap(collections.iterator_next(keys)) != 4096 or
    option.option_unwrap(collections.iterator_next(keys)) != 65535 {
        return 4
    }
    if option.is_some(collections.iterator_next(keys)) {
        return 5
    }
    collections.iterator_free(keys)

    let common: BitSet = collections.bitset_new()
    collections.bitset_insert(common, 0)
    collections.bitset_insert(common, 63)
    collections.bitset_insert(common, 64)
    collections.bitset_insert(common, 127)
    collections.bitset_insert(common, 128)
    collections.bitset_insert(common, 4096)
    collections.bitset_insert(common, 65535)
    collections.bitset_intersect_with(common, right)
    if collections.bitset_count(common) != 4 or
    collections.bitset_contains(common, 65535) != true or
    collections.bitset_contains(common, 127) {
        return 6
    }

    let only_left: BitSet = collections.bitset_new()
    collections.bitset_insert(only_left, 0)
    collections.bitset_insert(only_left, 63)
    collections.bitset_insert(only_left, 64)
    collections.bitset_insert(only_left, 127)
    collections.bitset_insert(only_left, 128)
    collections.bitset_insert(only_left, 4096)
    collections.bitset_insert(only_left, 65535)
    collections.bitset_difference_with(only_left, right)
    if collections.bitset_count(only_left) != 3 or
    collections.bitset_contains(only_left, 0) != true or
    collections.bitset_contains(only_left, 127) != true or
    collections.bitset_contains(only_left, 4096) != true or
    collections.bitset_contains(only_left, 64) {
        return 7
    }
    collections.bitset_remove(only_left, 4096)
    if collections.bitset_count(only_left) != 2 or collections.bitset_contains(only_left, 4096) {
        return 8
    }

    collections.bitset_free(left)
    collections.bitset_free(right)
    collections.bitset_free(united)
    collections.bitset_free(common)
    collections.bitset_free(only_left)
    return 0
}
