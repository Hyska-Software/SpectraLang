module service

from models import Task

// An empty function without a `returns` annotation exports unit. Importers
// declare this as an external, so its signature must not remain `unknown`.
public func touch() {
}

// Consumes and produces the imported record, including its cross-module
// derive schema (`task.to_json()` / `Task::from_json(..)`).
public func describe(task: Task) returns string {
    return task.to_json()
}

public func decode(raw: string) returns Task {
    return Task::from_json(raw)
}
