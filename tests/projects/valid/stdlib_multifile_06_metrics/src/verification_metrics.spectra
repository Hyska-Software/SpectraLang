module verification_metrics

import std.ml as ml
import std.string as string
import std.tensor as tensor

public func cleanup() returns int {
    return 0
}

public func check() returns int {
    tensor.free_all()
    let labels = tensor.arange(0, 3, 1)
    let predicted = tensor.arange(0, 3, 1)
    let report = ml.metrics_classification(labels, predicted)
    if not string.contains(report, "\"accuracy\":1.000000") {
        return 1
    }
    let serving = ml.serving_metrics(tensor.arange(10, 40, 10), 3, 0)
    if not string.contains(serving, "\"throughput_per_second\"") {
        return 2
    }
    tensor.free_all()
    return 0
}
