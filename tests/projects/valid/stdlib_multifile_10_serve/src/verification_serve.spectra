module verification_serve

import std.serve as serve
import std.string as string
import std.tensor as tensor

public func check() returns int {
    serve.reset()
    let server = serve.server_new(100)
    let weights = tensor.full2_f(1, 1, 2.0)
    let bias = tensor.full_f(1, 1.0)
    if serve.server_register_named_model_linear(server, "verification", weights, bias, 0) != 1 {
        return 1
    }
    let request = serve.server_infer(server, "verification", tensor.full_f(1, 3.0))
    if serve.server_result(server, request) != 7 {
        return 2
    }
    if not string.contains(serve.server_monitoring_snapshot(server), "verification") {
        return 3
    }
    tensor.free_all()
    serve.reset()
    return 0
}
