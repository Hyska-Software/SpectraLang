module config

import std.env as env
import std.option as option

const MODE_KEY = "SPECTRA_ML_AI_WORKBENCH_FIXTURE_MODE"

public record MlAiConfig {
    public name: string,
    public workspace: string,
    public seed: int,
    public mode: string,
}

public func mlai_load_config() returns MlAiConfig {
    env.env_set(MODE_KEY, "integration")
    let configured = env.env_get_option(MODE_KEY)
    let mode       = "fallback"
    if option.is_some(configured) {
        mode = option.option_unwrap(configured)
    }
    return MlAiConfig { name: "Fixture", workspace: "target/complete-ml-ai-workbench-fixture", seed: 20260916, mode: mode }
}
