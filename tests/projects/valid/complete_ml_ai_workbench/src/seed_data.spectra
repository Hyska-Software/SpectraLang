module seed_data

import std.fs as fs
import std.result as result

public func mlai_seed_workspace(root: string) returns int {
    if result.is_err(fs.create_dir_all(root + "/directory")) or result.is_err(fs.create_dir_all(root + "/rag")) {
        return 1
    }
    if result.is_err(fs.fs_write(root + "/tabular.csv", "f0,f1,label\n1.0,2.0,0.0\n2.0,3.0,1.0\n3.0,4.0,1.0\n4.0,5.0,0.0\n")) {
        return 2
    }
    if result.is_err(fs.fs_write(root + "/rows.jsonl", "{\"features\":[1.0,2.0],\"label\":0.0}\n{\"features\":[2.0,3.0],\"label\":1.0}\n")) {
        return 3
    }
    fs.fs_write(root + "/directory/features.csv", "x0,x1\n1.0,2.0\n2.0,3.0\n3.0,4.0\n")
    fs.fs_write(root + "/directory/labels.csv", "y\n0.0\n1.0\n1.0\n")
    return 0
}
