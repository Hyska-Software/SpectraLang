module rag_pipeline

import std.ml as ml
import std.string as str
import std.tensor as tensor

public func validate_rag_pipeline() returns int {
    tensor.free_all()
    let index = ml.vector_index_new(4)
    let doc   = tensor.full_f(4, 1.0)
    if ml.vector_index_insert(index, "doc-1", doc) != 1 {
        return 3
    }
    let query   = tensor.full_f(4, 1.0)
    let results = ml.vector_index_query(index, query, 1)
    if str.contains(results, "doc-1") {
        tensor.free_all()
        return 0
    }
    tensor.free_all()
    return 4
}
