module tools

// R-3222 cross-module fixture: the tools live in their own module, so their
// marshalling wrappers and the registration function that hands the runtime
// their addresses are synthesized here, and `main` reaches them only through
// the (deterministically named) cross-module registration symbol.
//
// `echo` is the async tool with a real IO round trip: inside the wrapper it
// awaits the mock provider, so the wrapper drives a coroutine that itself
// awaits a host call.

import std.agent

#[derive(Serialize, Deserialize)]
public record ScaleArgs {
    value: int,
    factor: int,
}

#[derive(Serialize, Deserialize)]
public record EchoArgs {
    text: string,
}

#[agent_tool("Multiplies an integer by a factor")]
public async func scale(run: Run, args: ScaleArgs) returns int {
    return args.value * args.factor
}

#[agent_tool("Echoes text through the run's model provider")]
public async func echo(run: Run, args: EchoArgs) returns string {
    let reply = await ask(run, args.text)
    if let Result::Ok(text) = reply {
        return text
    }
    return "provider error"
}

/// A helper `main` also calls directly: proves the tool module keeps working
/// as an ordinary imported module.
public func triple(value: int) returns int {
    return value * 3
}
