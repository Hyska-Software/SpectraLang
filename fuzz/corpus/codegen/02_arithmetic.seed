// Teste 2: Operações aritméticas
module arithmetic

func test_arithmetic() returns int {
    let a = 10
    let b = 5

    let sum  = a + b
    let diff = a - b
    let prod = a * b
    let quot = a / b
    let rem  = a % b

    return sum + diff + prod + quot + rem
}

func main() returns int {
    return test_arithmetic()
}
