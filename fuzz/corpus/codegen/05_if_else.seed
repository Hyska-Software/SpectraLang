// Teste 5: If/else if/else
module if_else

func test_if_else(n: int) returns int {
    if n > 10 {
        return 1
    } else if n > 5 {
        return 2
    } else {
        return 3
    }
}

func main() returns int {
    let r1 = test_if_else(15)
    let r2 = test_if_else(7)
    let r3 = test_if_else(2)
    return r1 + r2 + r3
}
