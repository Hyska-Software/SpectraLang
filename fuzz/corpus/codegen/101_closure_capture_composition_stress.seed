module closure_capture_composition_stress

func apply(value: int, f: func(int) returns int) returns int {
    return f(value)
}

func apply_pair(left: int, right: int, f: func(int, int) returns int) returns int {
    return f(left, right)
}

func make_shift(delta: int) returns func(int) returns int {
    let scale = 2
    return | value: int | value + delta * scale
}

func choose_shift(use_positive: bool, base: int) returns func(int) returns int {
    if use_positive {
        return | value: int | value + base
    }
    return | value: int | value - base
}

public func main() returns int {
    let external                             = 5
    let add_external: func(int) returns int  = | value: int | value + external
    let shifted                              = make_shift(3)
    let chosen                               = choose_shift( false, 4)
    let pair_sum: func(int, int) returns int = | left: int, right: int | left + right + external

    let a = apply(7, add_external)
    let b = shifted(10)
    let c = apply(20, chosen)
    let d = apply_pair(1, 2, pair_sum)

    if a != 12 {
        return a
    }
    if b != 16 {
        return b
    }
    if c != 16 {
        return c
    }
    if d != 8 {
        return d
    }
    return 0
}
