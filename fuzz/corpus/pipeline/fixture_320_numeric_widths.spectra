module stdlib_numeric_widths

import std.numeric as numeric

public func main() returns int {
    let i8_value: i8 = 120
    if numeric.wrapping_add_i8(i8_value, 20 as i8) as int != -116 {
        return 1
    }
    if numeric.wrapping_sub_i8(-120 as i8, 20 as i8) as int != 116 {
        return 2
    }
    if numeric.wrapping_mul_i8(20 as i8, 7 as i8) as int != -116 {
        return 3
    }

    if numeric.wrapping_add_i16(30000 as i16, 10000 as i16) as int != -25536 {
        return 4
    }
    if numeric.wrapping_sub_i16(-30000 as i16, 10000 as i16) as int != 25536 {
        return 5
    }
    if numeric.wrapping_mul_i16(200 as i16, 200 as i16) as int != -25536 {
        return 6
    }

    if numeric.wrapping_add_i32(2000000000 as i32, 1000000000 as i32) as int != -1294967296 {
        return 7
    }
    if numeric.wrapping_sub_i32(-2000000000 as i32, 1000000000 as i32) as int != 1294967296 {
        return 8
    }
    if numeric.wrapping_mul_i32(50000 as i32, 50000 as i32) as int != -1794967296 {
        return 9
    }

